diff --git a/dm/host/pad_deadzone.h b/dm/host/pad_deadzone.h
new file mode 100644
index 0000000..a188c6d
--- /dev/null
+++ b/dm/host/pad_deadzone.h
@@ -0,0 +1,39 @@
+// Physical controllers' sticks (DmGamepad.m read_pad; pure, so tests/t_pad_deadzone.c checks it without a controller): a circular dead zone on each stick's X / Y pair,
+// then a rescale so the stick still reaches full tilt. GameController hands over each axis in -1..1 with no dead zone the host can count on, and nothing after it has one
+// (hle_hid.c reports the values as they come), so a stick resting a little off centre (after a flick, or a pad's coarse axes resting a step off zero) reached the game
+// as a slow drift. A Switch's own hid service gives games sticks that rest at zero; this does the same here.
+//   Inside the dead zone (radius dz, measured on the pair: hypot(x, y), so a diagonal is not cut sooner than a straight tilt) the stick is at rest.
+//   From dz to the unit circle the tilt rises linearly from 0 to full, in the stick's own direction: radius r becomes (r - dz) / (1 - dz).
+//   Past the unit circle (the corners of a square-gated pad, up to sqrt 2) the values are left as they were, so no pad loses range; a full tilt is still 32767 on its axis.
+// The touch gamepad's sticks have their own dead zone (DmGamepad.m recompute) and never come through here, so no stick gets two.
+// DM_PAD_DEADZONE (Documents/env.txt): the radius as a fraction of full tilt, 0 to 0.5; 0 turns it off and gives the values exactly as before. Unset: 0.05.
+// A value that is not a number in that range is not taken (the default applies and the log says so).
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "dm_input.h"
+
+#define DM_PAD_DEADZONE_DEFAULT 0.05f
+#define DM_PAD_DEADZONE_MAX 0.5f
+
+// The radius DM_PAD_DEADZONE asks for; *taken = 0 when a value was given but not taken (the default is returned then)
+static inline float pad_deadzone_parse(const char *s, int *taken) {
+    *taken = 1;
+    if (!s || !*s) return DM_PAD_DEADZONE_DEFAULT;
+    char *end; float v = strtof(s, &end);
+    while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n') end++;
+    if (end == s || *end || !isfinite(v) || v < 0 || v > DM_PAD_DEADZONE_MAX) { *taken = 0; return DM_PAD_DEADZONE_DEFAULT; }
+    return v;
+}
+// One axis in -1..1 to the host's range, as the front end always did (clamped, then truncated toward zero)
+static inline int32_t pad_axis(float v) { return (int32_t)(fmaxf(-1.f, fminf(1.f, v)) * DM_STICK_MAX); }
+// One stick: GameController's x, y (y up) to the host's two axes (y up), through the dead zone dz
+static inline void pad_stick(float dz, float x, float y, int32_t *ox, int32_t *oy) {
+    if (dz > 0) {
+        float r = hypotf(x, y);
+        if (r <= dz) x = y = 0;
+        else if (r < 1) { float s = (r - dz) / ((1 - dz) * r); x *= s; y *= s; }   // r = 1 gives s = 1: no step at the unit circle
+    }
+    *ox = pad_axis(x); *oy = pad_axis(y);
+}
