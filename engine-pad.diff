@@ -547,6 +551,10 @@ static void pads_start(void) {
     pad_map_default(&g_padmap);
     const char *pm = getenv("DM_PAD_MAP");
     if (pm && *pm) { int bad = pad_map_parse(&g_padmap, pm); LOG("front end: controller buttons from DM_PAD_MAP (%s)%s", pm, bad ? ", malformed entries left out" : ""); }
+    const char *dz = getenv("DM_PAD_DEADZONE"); int taken;
+    g_deadzone = pad_deadzone_parse(dz, &taken);
+    if (!taken) LOG("[RED] front end: DM_PAD_DEADZONE=%s is not a number from 0 to %.2f, the sticks keep the default dead zone", dz, DM_PAD_DEADZONE_MAX);
+    LOG("front end: controller sticks: circular dead zone %.1f%% of full tilt%s", g_deadzone * 100, dz && *dz && taken ? " (DM_PAD_DEADZONE)" : g_deadzone > 0 ? "" : " (off)");
     const char *e = getenv("DM_PAD_MERGE"); g_merge = e && atoi(e);
     LOG("front end: %s", g_merge ? "every controller is player 1 (DM_PAD_MERGE)" : "each controller is a player of its own, the touch gamepad plays with player 1");
