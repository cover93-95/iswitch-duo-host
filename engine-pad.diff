diff --git a/dm/host/tests/t_pad_deadzone.c b/dm/host/tests/t_pad_deadzone.c
new file mode 100644
index 0000000..204cf43
--- /dev/null
+++ b/dm/host/tests/t_pad_deadzone.c
@@ -0,0 +1,102 @@
+// Physical controllers' stick dead zone (pad_deadzone.h): the centre and small tilts at rest, the rescale past the dead zone (continuous, rising, full tilt kept), diagonals
+// measured on the X / Y pair, directions kept, square-gate corners and out-of-range values as before, 0 giving exactly the old values, and DM_PAD_DEADZONE's parsing
+#include <stdio.h>
+#include "../pad_deadzone.h"
+
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+
+static int32_t old_axis(float v) { return (int32_t)(fmaxf(-1.f, fminf(1.f, v)) * 32767); }   // DmGamepad.m's axis() before the dead zone
+static double mag(int32_t x, int32_t y) { return hypot(x, y) / DM_STICK_MAX; }
+
+int main(void) {
+    const float dz = DM_PAD_DEADZONE_DEFAULT;
+    int32_t x, y;
+
+    // Centre and tilts inside the dead zone: at rest
+    pad_stick(dz, 0, 0, &x, &y); CHECK(x == 0 && y == 0, "centre is at rest");
+    pad_stick(dz, 0.03f, -0.03f, &x, &y); CHECK(x == 0 && y == 0, "a 4.2% diagonal drift is at rest");
+    pad_stick(dz, -0.049f, 0, &x, &y); CHECK(x == 0 && y == 0, "4.9% to the left is at rest");
+    pad_stick(dz, 0, 0.05f, &x, &y); CHECK(x == 0 && y == 0, "exactly the radius is at rest");
+    pad_stick(dz, 0.04f, 0.04f, &x, &y); CHECK(x != 0 && y != 0, "4% on each axis is 5.7% on the pair: past the circle (a per-axis zone would have kept it at rest)");
+
+    // Small tilts just past the dead zone start from zero, not with a jump
+    pad_stick(dz, 0.06f, 0, &x, &y); CHECK(x > 0 && x < 400 && y == 0, "6% right gives about 1% (344)");
+    pad_stick(dz, 0, -0.10f, &x, &y); CHECK(x == 0 && y < -1700 && y > -1750, "10% down gives about -5.3% (-1724)");
+    pad_stick(dz, 0.0501f, 0, &x, &y); CHECK(x >= 0 && x <= 5, "just past the radius is still almost zero");
+
+    // Rising and continuous along a ray, from the centre to full tilt: no step anywhere, including at the dead zone and the unit circle
+    int32_t prev = 0; int rising = 1, smooth = 1;
+    for (int i = 0; i <= 10000; i++) {
+        float r = i / 10000.f; pad_stick(dz, r, 0, &x, &y);
+        if (x < prev) rising = 0;
+        if (x - prev > 40) smooth = 0;   // 1/10000 of travel times 1/(1 - dz) is 3.4 units a step: 40 would be a jump
+        prev = x;
+    }
+    CHECK(rising, "the output never goes back as the stick goes out");
+    CHECK(smooth, "no jump along the ray");
+
+    // Full tilt in each direction stays full
+    pad_stick(dz, 1, 0, &x, &y); CHECK(x == 32767 && y == 0, "full right is 32767");
+    pad_stick(dz, -1, 0, &x, &y); CHECK(x == -32767 && y == 0, "full left is -32767");
+    pad_stick(dz, 0, 1, &x, &y); CHECK(x == 0 && y == 32767, "full up is +32767 (y up, as the host and the Switch)");
+    pad_stick(dz, 0, -1, &x, &y); CHECK(x == 0 && y == -32767, "full down is -32767");
+
+    // Diagonals: on a round gate full tilt stays full and both axes stay equal
+    const float d = 0.70710678f;
+    pad_stick(dz, d, d, &x, &y); CHECK(x == y && x >= 23160 && x <= 23170, "full up-right on a round gate: both axes about 23169");
+    pad_stick(dz, -d, -d, &x, &y); CHECK(x == y && x <= -23160 && x >= -23170, "full down-left on a round gate");
+    CHECK(fabs(mag(x, y) - 1) < 0.001, "a full diagonal has full length");
+    pad_stick(dz, 0.5f * d, -0.5f * d, &x, &y); CHECK(x == -y && fabs(mag(x, y) - (0.5 - dz) / (1 - dz)) < 0.001, "a half diagonal is rescaled on its length, not per axis");
+
+    // Square-gate corners and values past the range: as before
+    pad_stick(dz, 1, 1, &x, &y); CHECK(x == 32767 && y == 32767, "a square gate's corner still gives both axes full");
+    pad_stick(dz, 1.2f, -0.3f, &x, &y); CHECK(x == old_axis(1.2f) && y == old_axis(-0.3f), "past the unit circle the values are the old ones");
+    pad_stick(dz, -2, 2, &x, &y); CHECK(x == -32767 && y == 32767, "out of range is clamped as before");
+
+    // The direction is kept, the length follows (r - dz) / (1 - dz), opposite tilts are opposite, nothing passes full tilt
+    int dir = 1, len = 1, odd = 1, bound = 1;
+    for (int a = 0; a < 360; a += 5) for (int k = 6; k < 100; k += 7) {
+        float r = k / 100.f, t = a * (float)M_PI / 180, sx = r * cosf(t), sy = r * sinf(t);
+        int32_t nx, ny; pad_stick(dz, sx, sy, &x, &y); pad_stick(dz, -sx, -sy, &nx, &ny);
+        double want = (r - dz) / (1 - dz), got = mag(x, y);
+        if (fabs(got - want) > 0.0005) len = 0;
+        if (got > 0.05) { double e = fabs(remainder(atan2(y, x) - t, 2 * M_PI)); if (e > 0.002) dir = 0; }   // past 5%: each axis truncated by under 1 of 1638
+        if (nx != -x || ny != -y) odd = 0;
+        if (abs(x) > 32767 || abs(y) > 32767) bound = 0;
+    }
+    CHECK(dir, "every tilt keeps its direction");
+    CHECK(len, "every tilt has the rescaled length");
+    CHECK(odd, "opposite tilts give opposite values");
+    CHECK(bound, "no axis passes 32767");
+
+    // 0 turns it off: exactly the old values, on a fine grid and at the edges
+    int same = 1;
+    for (int i = -1100; i <= 1100; i += 3) for (int j = -1100; j <= 1100; j += 7) {
+        float sx = i / 1000.f, sy = j / 1000.f; pad_stick(0, sx, sy, &x, &y);
+        if (x != old_axis(sx) || y != old_axis(sy)) same = 0;
+    }
+    CHECK(same, "DM_PAD_DEADZONE=0 gives exactly the old values");
+
+    // A larger radius
+    pad_stick(0.2f, 0.19f, 0, &x, &y); CHECK(x == 0, "0.2: 19% is at rest");
+    pad_stick(0.2f, 0.6f, 0, &x, &y); CHECK(x == old_axis(0.5f), "0.2: 60% gives 50%");
+    pad_stick(0.2f, 1, 0, &x, &y); CHECK(x == 32767, "0.2: full tilt stays full");
+
+    // DM_PAD_DEADZONE
+    int t;
+    CHECK(pad_deadzone_parse(NULL, &t) == 0.05f && t, "unset: 0.05");
+    CHECK(pad_deadzone_parse("", &t) == 0.05f && t, "empty: 0.05");
+    CHECK(pad_deadzone_parse("0.08", &t) == 0.08f && t, "0.08 is taken");
+    CHECK(pad_deadzone_parse("0", &t) == 0 && t, "0 is taken (off)");
+    CHECK(pad_deadzone_parse("0.5", &t) == 0.5f && t, "0.5 is the largest taken");
+    CHECK(pad_deadzone_parse("0.1\r", &t) == 0.1f && t, "a CR from a Windows-edited env.txt is fine");
+    CHECK(pad_deadzone_parse("0.6", &t) == 0.05f && !t, "0.6 is not taken");
+    CHECK(pad_deadzone_parse("-0.1", &t) == 0.05f && !t, "a negative radius is not taken");
+    CHECK(pad_deadzone_parse("5%", &t) == 0.05f && !t, "a percent sign is not taken");
+    CHECK(pad_deadzone_parse("abc", &t) == 0.05f && !t, "a word is not taken");
+    CHECK(pad_deadzone_parse("nan", &t) == 0.05f && !t, "nan is not taken");
+
+    printf("t_pad_deadzone: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
