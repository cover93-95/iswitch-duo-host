+import Foundation
+import Testing
+@testable import ShellHost
+
+/// A browser game's folder is read when its address is a web page (https) or the Nintendo Switch 2 app (iswitchduo-switch2),
+/// never another scheme.
+@Suite struct WebGameCatalogueTests {
+    private func folder(_ url: String, platform: String = "PS2") throws -> URL {
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("webgame-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let json = #"{"title": "A game", "platform": "\#(platform)", "url": "\#(url)"}"#
+        try Data(json.utf8).write(to: dir.appendingPathComponent("game.json"))
+        return dir
+    }
+
+    @Test func aWebPageIsRead() throws {
+        #expect(WebGameCatalogue.read(directory: try folder("https://example.com/"), .default)?.url.scheme == "https")
+    }
+
+    @Test func theSwitch2AppIsRead() throws {
+        let entry = WebGameCatalogue.read(directory: try folder("iswitchduo-switch2://", platform: "Switch 2"), .default)
+        #expect(entry?.url.scheme == "iswitchduo-switch2")
+        #expect(entry?.platform == "Switch 2")
+    }
+
+    @Test func theBackOfTheBoxIsRead() throws {
+        let dir = try folder("https://example.com/")
+        #expect(WebGameCatalogue.read(directory: dir, .default)?.backURL == nil)
+        try Data("x".utf8).write(to: dir.appendingPathComponent("back.png"))
+        #expect(WebGameCatalogue.read(directory: dir, .default)?.backURL?.lastPathComponent == "back.png")
+    }
+
+    @Test func anotherSchemeIsNot() throws {
+        #expect(WebGameCatalogue.read(directory: try folder("http://example.com/"), .default) == nil)
+        #expect(WebGameCatalogue.read(directory: try folder("javascript:alert(1)"), .default) == nil)
+    }
+}
