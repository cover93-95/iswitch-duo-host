@@ -0,0 +1,43 @@
+import Foundation
+import Testing
+@testable import ShellUI
+
+/// The library's light and sounds: a cover's hue becomes the light, a grey cover a white one, and the made-up sounds stay in range.
+@Suite struct LibraryLookTests {
+    @Test func aRedCoverGivesARedLight() {
+        let light = GameLight(red: 0.6, green: 0.1, blue: 0.1)
+        #expect(light.hue < 0.01 || light.hue > 0.99)
+        #expect(light.saturation >= 0.5 && light.saturation <= 0.85)
+    }
+
+    @Test func aBlueCoverGivesABlueLight() {
+        let light = GameLight(red: 0.1, green: 0.2, blue: 0.5)
+        #expect(abs(light.hue - 0.625) < 0.02)
+    }
+
+    @Test func aDullCoverIsSaturatedEnoughToReadAsLight() {
+        // A muddy green mean colour still lights the screen green.
+        let light = GameLight(red: 0.3, green: 0.36, blue: 0.3)
+        #expect(light.saturation >= 0.5)
+        #expect(abs(light.hue - 1.0 / 3) < 0.02)
+    }
+
+    @Test func aGreyCoverStaysWhite() {
+        let light = GameLight(red: 0.4, green: 0.4, blue: 0.41)
+        #expect(light.saturation < 0.08)
+        #expect(GameLight(red: 0, green: 0, blue: 0).saturation == 0)
+    }
+
+    @Test func aGameWithoutPictureHasAStableLight() {
+        #expect(GameLight(seed: "0100000000010000") == GameLight(seed: "0100000000010000"))
+    }
+
+    @MainActor @Test func theNavigationSoundsStayInRange() {
+        for samples in [NavSound.tickSamples(rate: 44_100), NavSound.shiftSamples(rate: 44_100)] {
+            #expect(!samples.isEmpty)
+            #expect(samples.allSatisfy { $0 >= -1 && $0 <= 1 })
+            #expect(samples.contains { abs($0) > 0.1 })
+        }
+        #expect(NavSound.tickSamples(rate: 44_100).count < NavSound.shiftSamples(rate: 44_100).count)
+    }
+}
diff --git a/frontend-ios/UITests/LibraryBoxCaptureTests.swift b/frontend-ios/UITests/LibraryBoxCaptureTests.swift
new file mode 100644
index 0000000..2623d85
--- /dev/null
+++ b/frontend-ios/UITests/LibraryBoxCaptureTests.swift
@@ -0,0 +1,344 @@
+import XCTest
+
+/// The box opened from the cover and the game card going into the console, by touch and by controller, and the info panel,
+/// captured for review. With TEST_RUNNER_SHOT_DIR set, each capture is also written there as a PNG.
+@MainActor final class LibraryBoxCaptureTests: XCTestCase {
+    private let app = XCUIApplication()
+    private var directory: String? { ProcessInfo.processInfo.environment["SHOT_DIR"] }
+    private var prefix: String { ProcessInfo.processInfo.environment["SHOT_PREFIX"] ?? (UIDevice.current.userInterfaceIdiom == .pad ? "ipad" : "phone") }
+
+    override func setUp() {
+        continueAfterFailure = false
+        XCUIDevice.shared.orientation = .landscapeLeft
+    }
+
+    private func shot(_ name: String) {
+        let screenshot = XCUIScreen.main.screenshot()
+        let attachment = XCTAttachment(screenshot: screenshot)
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        add(attachment)
+        if let directory {
+            try? screenshot.pngRepresentation.write(to: URL(fileURLWithPath: directory).appendingPathComponent("\(prefix)-\(name).png"))
+        }
+    }
+    private func launch(_ arguments: [String]) {
+        app.terminate()
+        app.launchArguments = arguments
+        app.launch()
+        XCTAssertTrue(app.buttons["controllers.open"].firstMatch.waitForExistence(timeout: 15))
+        sleep(2)
+    }
+    /// The demo answers Play with an alert: the game would start here.
+    private func expectPlay(_ name: String) {
+        let alert = app.alerts.firstMatch
+        XCTAssertTrue(alert.waitForExistence(timeout: 8), "Play was not requested")
+        shot(name)
+        alert.buttons.firstMatch.tap()
+        sleep(1)
+    }
+
+    /// Touch: a tap on the middle cover brings its box forward, closed; a drag across it turns it to its back without opening
+    /// it; a tap on it opens it (captured while it opens); the round button closes and opens it; Game info shows the panel and
+    /// Open the box comes back; a tap on the card flies it into the console (captured) and plays.
+    func testTouch() {
+        // The particles only where the review looks at them (the tablet's touch run); every other run is still, so the app goes idle between taps.
+        launch(["--screen", "library"] + (UIDevice.current.userInterfaceIdiom == .pad ? [] : ["--still"]))
+        shot("touch-01-library")
+        app.windows.firstMatch.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.42)).tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("touch-02a-box-forward")
+        XCTAssertFalse(app.buttons["box.cart"].exists, "the box opened by itself")
+        let window = app.windows.firstMatch
+        window.coordinate(withNormalizedOffset: CGVector(dx: 0.56, dy: 0.45))
+            .press(forDuration: 0.05, thenDragTo: window.coordinate(withNormalizedOffset: CGVector(dx: 0.38, dy: 0.45)))
+        sleep(1)
+        shot("touch-02b-box-back")
+        XCTAssertFalse(app.buttons["box.cart"].exists, "the drag opened the box")
+        // A tap on the box opens it, coming round to its front. Tapped where the box is: turned half round, its element's frame
+        // is no longer where it is drawn.
+        window.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.45)).tap()
+        for index in 1...4 {
+            usleep(250_000)
+            shot("touch-02-box-opening-\(index)")
+        }
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("touch-03-box-open")
+        app.buttons["box.toggle"].tap()
+        sleep(2)
+        shot("touch-04-box-closed-again")
+        app.buttons["box.toggle"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 5))
+        app.buttons["box.info"].tap()
+        XCTAssertTrue(app.buttons["info.play"].waitForExistence(timeout: 5))
+        XCTAssertFalse(app.buttons["box.toggle"].exists)
+        sleep(1)
+        shot("touch-05-info-panel")
+        // The Your play tab, in the platform selector's capsule, then back to Overview.
+        app.buttons["info.tab.Your play"].tap()
+        XCTAssertTrue(app.buttons["info.status.playing"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("touch-05a-info-your-play")
+        app.buttons["info.tab.Overview"].tap()
+        XCTAssertTrue(app.buttons["info.play"].waitForExistence(timeout: 5))
+        // What the game is about: the synopsis and the screenshots, one opened full screen and the next one swiped to.
+        let first = app.buttons["info.shot.0"]
+        XCTAssertTrue(first.waitForExistence(timeout: 5))
+        if !first.isHittable { app.buttons["info.play"].swipeUp() }
+        sleep(1)
+        shot("touch-05b-info-about")
+        first.tap()
+        XCTAssertTrue(app.buttons["shot.close"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("touch-05c-screenshot")
+        app.windows.firstMatch.swipeLeft()
+        sleep(1)
+        shot("touch-05d-screenshot-swiped")
+        app.buttons["shot.close"].tap()
+        XCTAssertTrue(app.buttons["info.box"].waitForExistence(timeout: 5))
+        if !app.buttons["info.box"].isHittable { app.buttons["info.shot.0"].swipeDown() }
+        app.buttons["info.box"].tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["box.toggle"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["box.cart"].tap()
+        // Lift, flight and click (about 0.8 s), then the slot flares and the screen fades to black (0.9 s).
+        for index in 1...8 {
+            usleep(180_000)
+            shot("touch-06-card-inserting-\(index)")
+        }
+        expectPlay("touch-07-played")
+    }
+
+    /// Controller (the demo's on-screen stand-ins for its buttons): right moves to the next game, A brings its box forward, View
+    /// turns it over, A opens it, A on the card (the focus once the box is open) plays; B closes the box and goes back.
+    func testController() {
+        launch(["--screen", "library", "--input-test", "--still"])
+        app.buttons["qa.input.right"].tap()
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.turn"].tap()
+        sleep(1)
+        shot("pad-00-box-turned")
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        shot("pad-01-box-open-card-focused")
+        app.buttons["qa.input.back"].tap()
+        sleep(1)
+        XCTAssertFalse(app.buttons["box.toggle"].exists)
+        shot("pad-02-library")
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        expectPlay("pad-03-played")
+    }
+
+    /// A game with no statistics yet and one that cannot start (its cover opens the info panel), and a box opened from the
+    /// launch arguments.
+    func testOtherGames() {
+        launch(["--screen", "info", "--select", "drift", "--still"])
+        shot("other-01-info-no-stats")
+        launch(["--screen", "info", "--select", "paper", "--still"])
+        shot("other-02-info-needs-data")
+        launch(["--screen", "box", "--select", "tide", "--still"])
+        sleep(2)
+        shot("other-03-box-tide")
+        // The controller hint bar (a GameSir G8 Plus: A, X, Y, LB and RB) in the library, then the next platform: Switch 2,
+        // a game another app runs. The QA buttons go to the top, out of the bar's way.
+        launch(["--screen", "library", "--still", "--web", "--web2", "--input-test", "--qa-top"])
+        app.buttons["qa.input.right"].tap()
+        sleep(1)
+        shot("other-04-hints-library")
+        app.buttons["qa.input.next"].tap()
+        sleep(2)
+        shot("other-05-switch2")
+        // The info panel's hint bar, its Your play tab (RB) and, further down, Your copy.
+        launch(["--screen", "info", "--select", "orbit", "--still", "--web", "--input-test", "--qa-top"])
+        app.buttons["qa.input.down"].tap()
+        app.buttons["qa.input.next"].tap()
+        sleep(1)
+        shot("other-06-hints-your-play")
+        for _ in 0..<6 { app.buttons["qa.input.down"].tap(); usleep(300_000) }
+        sleep(1)
+        shot("other-07-your-copy")
+        // Play in the info panel goes through the box: it opens, the card goes in by itself (captured) and the game is asked for.
+        launch(["--screen", "info", "--select", "orbit", "--still"])
+        app.buttons["info.play"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        for index in 1...3 {
+            usleep(600_000)
+            shot("other-08-play-from-info-\(index)")
+        }
+        expectPlay("other-09-played-from-info")
+    }
+
+    /// The platform selector at the top in the middle (a browser game under PS2), its box with a disc, the disc going in and the
+    /// game's page full screen; then the controller: R to the next platform, A twice to play, Menu and View to come back.
+    func testPlatforms() {
+        launch(["--screen", "library", "--still", "--web", "--input-test"])
+        XCTAssertTrue(app.buttons["platform.PS2"].waitForExistence(timeout: 5))
+        shot("web-01-library-switch")
+        app.buttons["platform.PS2"].tap()
+        sleep(2)
+        shot("web-02-library-ps2")
+        // A tap on the only PS2 game opens its box (it did nothing on the iPhone: the shelf waited for the carousel to settle)
+        app.buttons["tile.street"].firstMatch.tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.descendants(matching: .any)["box.case"].firstMatch.tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        shot("web-03-box-disc")
+        app.buttons["box.cart"].tap()
+        for index in 1...4 {
+            usleep(300_000)
+            shot("web-04-disc-inserting-\(index)")
+        }
+        XCTAssertTrue(app.buttons["web.close"].waitForExistence(timeout: 10))
+        sleep(4)
+        shot("web-05-page")
+        app.buttons["web.close"].tap()
+        sleep(2)
+        shot("web-06-back")
+        // Controller: back to Switch with R (two platforms: R wraps), then to PS2 again, play, and out with Menu and View.
+        app.buttons["qa.input.next"].tap()
+        sleep(1)
+        shot("web-07-pad-switch")
+        app.buttons["qa.input.next"].tap()
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["web.close"].waitForExistence(timeout: 10))
+        sleep(2)
+        app.buttons["qa.input.exit"].tap()
+        sleep(2)
+        XCTAssertFalse(app.buttons["web.close"].exists)
+        shot("web-08-pad-exit")
+        // N64: the wide box, its grey cartridge and the slot at the top of the console.
+        launch(["--screen", "library", "--still", "--web64"])
+        XCTAssertTrue(app.buttons["platform.N64"].waitForExistence(timeout: 5))
+        app.buttons["platform.N64"].tap()
+        sleep(2)
+        shot("web-09-library-n64")
+        app.buttons["tile.kart"].firstMatch.tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        shot("web-10-box-n64")
+        let cart = app.buttons["box.cart"]
+        cart.coordinate(withNormalizedOffset: CGVector(dx: 0.7, dy: 0.5))
+            .press(forDuration: 0.05, thenDragTo: cart.coordinate(withNormalizedOffset: CGVector(dx: 0.1, dy: 0.5)))
+        sleep(1)
+        shot("web-10b-cart-back")
+        XCTAssertFalse(app.buttons["web.close"].exists, "the drag put the cartridge in")
+        app.buttons["box.cart"].tap()
+        for index in 1...3 {
+            usleep(220_000)
+            shot("web-11-cart-inserting-\(index)")
+        }
+        XCTAssertTrue(app.buttons["web.close"].waitForExistence(timeout: 10))
+    }
+
+    /// A drag across the carousel scrolls it to another game (it never turns a box); a tap brings the box forward, closed, a drag
+    /// on it turns it to its back (a real back cover for the first game) without opening it, and View turns it back. Then, left
+    /// alone, the showcase starts by itself (the top bar and hints gone, the boxes going by), and a button brings back the game
+    /// it started from.
+    func testTurnAndShowcase() {
+        launch(["--screen", "library", "--still", "--input-test", "--showcase-after", "8"])
+        let title = app.staticTexts["hero.title"].firstMatch
+        XCTAssertTrue(title.waitForExistence(timeout: 5))
+        let before = title.label
+        let window = app.windows.firstMatch
+        window.coordinate(withNormalizedOffset: CGVector(dx: 0.55, dy: 0.42))
+            .press(forDuration: 0.05, thenDragTo: window.coordinate(withNormalizedOffset: CGVector(dx: 0.3, dy: 0.42)))
+        sleep(2)
+        shot("turn-00-carousel-scrolled")
+        XCTAssertNotEqual(title.label, before, "a drag on the carousel did not scroll it")
+        let first = title.label
+        window.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.42)).tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("turn-01-front")
+        window.coordinate(withNormalizedOffset: CGVector(dx: 0.56, dy: 0.45))
+            .press(forDuration: 0.05, thenDragTo: window.coordinate(withNormalizedOffset: CGVector(dx: 0.38, dy: 0.45)))
+        usleep(150_000)
+        shot("turn-02-turning")
+        sleep(1)
+        shot("turn-03-back")
+        XCTAssertFalse(app.buttons["box.cart"].exists, "the drag opened the box")
+        app.buttons["qa.input.turn"].tap()
+        sleep(1)
+        shot("turn-04-front-again")
+        app.buttons["qa.input.turn"].tap()
+        sleep(1)
+        shot("turn-05-back-by-button")
+        app.buttons["qa.input.back"].tap()
+        sleep(1)
+        XCTAssertFalse(app.buttons["box.toggle"].exists)
+        // Left alone: the showcase.
+        let end = app.descendants(matching: .any)["showcase.end"]
+        XCTAssertTrue(end.waitForExistence(timeout: 14), "the showcase did not start")
+        sleep(1)
+        shot("showcase-01")
+        sleep(5)
+        shot("showcase-02")
+        XCTAssertNotEqual(title.label, first, "the showcase did not move on")
+        app.buttons["qa.input.down"].tap()
+        sleep(1)
+        XCTAssertFalse(end.exists, "a button did not end the showcase")
+        XCTAssertEqual(title.label, first, "the showcase did not bring back the game it started from")
+        shot("showcase-03-back")
+    }
