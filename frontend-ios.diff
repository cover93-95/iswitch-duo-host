+import Foundation
+import Testing
+@testable import ShellUI
+
+/// `ambience.txt`: one word, any case, spaces and a line end ignored; anything else means no particles.
+@Suite struct AmbienceTests {
+    @Test func theWordIsRead() {
+        #expect(Ambience(text: "sparkles") == .sparkles)
+        #expect(Ambience(text: " Dust\r\n") == .dust)
+        #expect(Ambience(text: "CLOUDS\n") == .clouds)
+        #expect(Ambience(text: "shards") == .shards)
+        #expect(Ambience(text: "grain") == .grain)
+        for word in ["fairies", "snow", "neon", "aura", "rain", "bokeh", "wisps", "embers"] {
+            #expect(Ambience(text: word + "\n").rawValue == word)
+        }
+    }
+
+    @Test func anythingElseIsNone() {
+        #expect(Ambience(text: nil) == Ambience.none)
+        #expect(Ambience(text: "") == Ambience.none)
+        #expect(Ambience(text: "fireworks") == Ambience.none)
+        #expect(Ambience(text: "sparkles please") == Ambience.none)
+    }
+
+    @Test func theNoiseIsFixedAndInRange() {
+        for i in 0..<500 {
+            let v = AmbienceLayer.noise(i, 3)
+            #expect(v >= 0 && v < 1)
+            #expect(v == AmbienceLayer.noise(i, 3))
+        }
+        #expect(AmbienceLayer.wrap(-0.25) == 0.75)
+        #expect(AmbienceLayer.wrap(1.5) == 0.5)
+    }
+}
