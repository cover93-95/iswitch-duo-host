+import Foundation
+import Testing
+@testable import ShellUI
+
+/// The controller banner's news and the New stickers' bookkeeping.
+@Suite struct LibraryExtrasTests {
+    let pad = ControllerInfo(id: "a", name: "GameSir G8 Plus", player: "Player 1", batteryPercent: 64)
+    let other = ControllerInfo(id: "b", name: "Pro Controller", player: "Player 2")
+
+    @Test func aControllerThatArrivesOrLeavesIsNews() {
+        let came = ControllerNotice.change(from: [], to: [pad])
+        #expect(came?.kind == .connected && came?.name == "GameSir G8 Plus" && came?.batteryPercent == 64)
+        let left = ControllerNotice.change(from: [pad, other], to: [pad])
+        #expect(left?.kind == .disconnected && left?.name == "Pro Controller")
+        var drained = pad
+        drained.batteryPercent = 12
+        #expect(ControllerNotice.change(from: [pad], to: [drained]) == nil)
+        #expect(ControllerNotice.change(from: [], to: [drained])?.low == true)
+    }
+
+    @Test func nothingIsNewTheFirstTime() {
+        let first = NewGames.resolve(ids: ["a", "b"], seen: nil)
+        #expect(first.fresh.isEmpty && first.seen == ["a", "b"])
+        let later = NewGames.resolve(ids: ["a", "b", "c"], seen: first.seen)
+        #expect(later.fresh == ["c"] && later.seen == ["a", "b"])
+    }
+}
