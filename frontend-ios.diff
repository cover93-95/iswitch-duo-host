+/// The console's card slot at the top right of the box screen: a dark opening in a rim, lit while a card goes in.
+private struct ConsoleSlot: View {
+    let width: CGFloat
+    let lit: Bool
+    /// The card is in: a brighter, wider light around the slot.
+    var flare = false
+    @Environment(\.caseStyle) private var style
+    var body: some View {
+        let glow = style.disc ? Color(red: 0.55, green: 0.75, blue: 1.0) : Color(red: 0.35, green: 0.65, blue: 1.0)
+        // A disc goes into a slot-loading drive: a longer, thinner slit in a flat bezel, the disc mark beside it.
+        // An N64 cartridge goes in at the top of the console: a wide, deep opening in a grey rim.
+        let rim = style.disc ? CGSize(width: width * 1.25 + 46, height: 18)
+            : style.cart64 ? CGSize(width: width + 26, height: 28) : CGSize(width: width + 18, height: 22)
+        let slit = style.disc ? CGSize(width: width * 1.12, height: 3)
+            : style.cart64 ? CGSize(width: width * 1.04, height: 10) : CGSize(width: width, height: 6)
+        ZStack {
+            Capsule().fill(LinearGradient(colors: style.disc ? [Color(white: 0.22), Color(white: 0.08)]
+                                          : style.cart64 ? [Color(white: 0.4), Color(white: 0.2)] : [Color(white: 0.28), Color(white: 0.12)],
+                                          startPoint: .top, endPoint: .bottom))
+                .frame(width: rim.width, height: rim.height)
+                .overlay(Capsule().strokeBorder(.white.opacity(0.18), lineWidth: 1))
+            Capsule().fill(flare ? glow.mix(with: .white, by: 0.55) : .black).frame(width: slit.width, height: slit.height)
+                .shadow(color: lit ? glow : .clear, radius: lit ? (flare ? 14 : 8) : 0)
+                .shadow(color: flare ? glow.opacity(0.9) : .clear, radius: flare ? 28 : 0)
+            if style.disc {
+                HStack {
+                    Image(systemName: "opticaldisc").font(.system(size: 10, weight: .semibold))
+                    Spacer()
+                    Image(systemName: "eject.fill").font(.system(size: 8, weight: .semibold))
+                }
+                .foregroundStyle(.white.opacity(lit ? 0.75 : 0.4))
+                .padding(.horizontal, 9)
+                .frame(width: rim.width, height: rim.height)
+            }
+        }
+        .shadow(color: .black.opacity(0.5), radius: 8, y: 3)
+        .animation(.easeOut(duration: 0.2), value: lit)
+        .animation(.easeOut(duration: 0.25), value: flare)
+    }
+}
