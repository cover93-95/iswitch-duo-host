+    /// Each game ambience drawn on the library's backdrop, captured twice a moment apart, for review.
+    func testAmbiences() {
+        for word in ["fairies", "snow", "neon", "aura", "rain", "bokeh", "wisps", "embers"] {
+            launch(["--screen", "library", "--ambience", word])
+            shot("ambience-\(word)-1")
+            usleep(700_000)
+            shot("ambience-\(word)-2")
+        }
+    }
+
+    /// The opening slowed down, frame by frame; a touch and a button skip it; the controller banner; the New sticker.
+    func testOpeningBannerAndNew() {
+        launch(["--screen", "library", "--intro", "--intro-length", "7"])
+        for frame in 1...5 { shot("intro-\(frame)"); usleep(1_000_000) }
+        launch(["--screen", "library", "--intro", "--intro-length", "60"])
+        let skip = app.descendants(matching: .any)["intro.skip"]
+        XCTAssertTrue(skip.exists, "the opening is not there")
+        skip.tap()
+        sleep(1)
+        XCTAssertFalse(skip.exists, "a touch did not skip the opening")
+        launch(["--screen", "library", "--intro", "--intro-length", "60", "--input-test"])
+        XCTAssertTrue(skip.exists, "the opening is not there")
+        app.buttons["qa.input.down"].tap()
+        sleep(1)
+        XCTAssertFalse(skip.exists, "a button did not skip the opening")
+
+        launch(["--screen", "library", "--controller-notice"])
+        let notice = app.descendants(matching: .any)["controller.notice"]
+        XCTAssertTrue(notice.waitForExistence(timeout: 5), "no banner for the controller")
+        shot("controller-notice")
+        sleep(5)
+        XCTAssertFalse(notice.exists, "the banner stayed")
+
+        launch(["--screen", "library", "--new-games", "orbit,moon"])
+        shot("new-sticker")
+    }
