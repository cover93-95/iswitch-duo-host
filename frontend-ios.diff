diff --git a/frontend-ios/Sources/ShellUI/AmbienceLayer.swift b/frontend-ios/Sources/ShellUI/AmbienceLayer.swift
new file mode 100644
index 0000000..3e801ea
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/AmbienceLayer.swift
@@ -0,0 +1,159 @@
+import SwiftUI
+
+/// A game's ambience: a few slow particles over its backdrop, chosen per game (`ambience.txt` in its framework). Off with
+/// Reduce Motion. Drawn only while the library is on screen: when a game starts, the window's root becomes the game view and
+/// this view, with its timeline, is gone.
+public enum Ambience: String, Equatable, Sendable, CaseIterable {
+    case none
+    /// Golden sparkles that rise and twinkle.
+    case sparkles
+    /// Pale motes that float, a little ghostly.
+    case dust
+    /// Soft clouds that drift across.
+    case clouds
+    /// Violet shards that rise and turn.
+    case shards
+    /// An old film's grain, with a scratch now and then.
+    case grain
+
+    /// The word in `ambience.txt`, any case, spaces and line ends ignored. Anything else is none.
+    public init(text: String?) {
+        self = Ambience(rawValue: (text ?? "").trimmingCharacters(in: .whitespacesAndNewlines).lowercased()) ?? .none
+    }
+}
+
+struct AmbienceLayer: View {
+    let kind: Ambience
+    var body: some View {
+        if kind != .none {
+            TimelineView(.animation(minimumInterval: 1.0 / 30)) { timeline in
+                Canvas { context, size in
+                    let t = timeline.date.timeIntervalSinceReferenceDate
+                    switch kind {
+                    case .sparkles: Self.sparkles(&context, size, t)
+                    case .dust: Self.dust(&context, size, t)
+                    case .clouds: Self.clouds(&context, size, t)
+                    case .shards: Self.shards(&context, size, t)
+                    case .grain: Self.grain(&context, size, t)
+                    case .none: break
+                    }
+                }
+            }
+            .allowsHitTesting(false)
+            .accessibilityHidden(true)
+        }
+    }
+
+    /// A fixed pseudo-random number in 0..<1 for particle `i` and property `k`: the same every frame, so nothing is stored.
+    static func noise(_ i: Int, _ k: Int) -> Double {
+        let v = sin(Double(i) * 12.9898 + Double(k) * 78.233) * 43758.5453
+        return v - v.rounded(.down)
+    }
+    /// `v` wrapped into 0..<1.
+    static func wrap(_ v: Double) -> Double { v - v.rounded(.down) }
+
+    private static func glow(_ context: inout GraphicsContext, at p: CGPoint, radius r: CGFloat, color: Color, alpha: Double) {
+        let rect = CGRect(x: p.x - r, y: p.y - r, width: r * 2, height: r * 2)
+        context.fill(Path(ellipseIn: rect), with: .radialGradient(Gradient(colors: [color.opacity(alpha), color.opacity(0)]),
+                                                                    center: p, startRadius: 0, endRadius: r))
+    }
+
+    static func sparkles(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let gold = Color(red: 1, green: 0.86, blue: 0.45)
+        let unit = min(size.width, size.height)
+        for i in 0..<26 {
+            let speed = 0.012 + noise(i, 1) * 0.02
+            let y = wrap(noise(i, 2) - t * speed)
+            let x = noise(i, 3) + sin(t * 0.4 + noise(i, 4) * 6.28) * 0.012
+            let twinkle = pow(0.5 + 0.5 * sin(t * (1.5 + noise(i, 5) * 2) + noise(i, 6) * 6.28), 3)
+            let fade = min(1, min(y, 1 - y) * 6)   // in and out at the edges
+            let alpha = twinkle * fade
+            guard alpha > 0.02 else { continue }
+            let p = CGPoint(x: x * size.width, y: y * size.height)
+            let r = unit * (0.006 + noise(i, 7) * 0.008)
+            glow(&context, at: p, radius: r * 4, color: gold, alpha: 0.35 * alpha)
+            var star = Path()
+            star.move(to: CGPoint(x: p.x - r * 2.2, y: p.y)); star.addLine(to: CGPoint(x: p.x + r * 2.2, y: p.y))
+            star.move(to: CGPoint(x: p.x, y: p.y - r * 2.2)); star.addLine(to: CGPoint(x: p.x, y: p.y + r * 2.2))
+            context.stroke(star, with: .color(.white.opacity(0.9 * alpha)), lineWidth: max(1, r * 0.35))
+            context.fill(Path(ellipseIn: CGRect(x: p.x - r * 0.6, y: p.y - r * 0.6, width: r * 1.2, height: r * 1.2)),
+                         with: .color(.white.opacity(alpha)))
+        }
+    }
+
+    static func dust(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let pale = Color(red: 0.75, green: 0.9, blue: 1)
+        let unit = min(size.width, size.height)
+        for i in 0..<36 {
+            let x = wrap(noise(i, 1) + t * (0.004 + noise(i, 2) * 0.006) + sin(t * 0.3 + noise(i, 3) * 6.28) * 0.02)
+            let y = wrap(noise(i, 4) - t * (0.003 + noise(i, 5) * 0.004) + cos(t * 0.25 + noise(i, 6) * 6.28) * 0.02)
+            let alpha = 0.25 + 0.35 * (0.5 + 0.5 * sin(t * (0.6 + noise(i, 7)) + noise(i, 8) * 6.28))
+            let r = unit * (0.004 + noise(i, 9) * 0.01)
+            glow(&context, at: CGPoint(x: x * size.width, y: y * size.height), radius: r * 3, color: pale, alpha: alpha)
+        }
+    }
+
+    static func clouds(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        for i in 0..<7 {
+            let w = size.width * (0.3 + noise(i, 1) * 0.35)
+            let h = w * (0.18 + noise(i, 2) * 0.1)
+            let span = size.width + w
+            let x = wrap(noise(i, 3) + t * (0.004 + noise(i, 4) * 0.006)) * span - w
+            let y = size.height * (0.08 + noise(i, 5) * 0.75)
+            let alpha = 0.10 + noise(i, 6) * 0.10
+            let rect = CGRect(x: x, y: y, width: w, height: h)
+            context.fill(Path(ellipseIn: rect), with: .radialGradient(Gradient(colors: [.white.opacity(alpha), .white.opacity(0)]),
+                                                                      center: CGPoint(x: rect.midX, y: rect.midY), startRadius: 0,
+                                                                      endRadius: w / 2))
+        }
+    }
+
+    static func shards(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let colors = [Color(red: 0.85, green: 0.45, blue: 1), Color(red: 1, green: 0.55, blue: 0.85), Color(red: 0.6, green: 0.5, blue: 1)]
+        let unit = min(size.width, size.height)
+        for i in 0..<24 {
+            let y = wrap(noise(i, 1) - t * (0.01 + noise(i, 2) * 0.018))
+            let x = noise(i, 3) + sin(t * 0.35 + noise(i, 4) * 6.28) * 0.02
+            let fade = min(1, min(y, 1 - y) * 5)
+            let alpha = (0.35 + 0.45 * (0.5 + 0.5 * sin(t * 2 + noise(i, 5) * 6.28))) * fade
+            let r = unit * (0.006 + noise(i, 6) * 0.012)
+            let angle = t * (0.6 + noise(i, 7)) + noise(i, 8) * 6.28
+            let p = CGPoint(x: x * size.width, y: y * size.height)
+            let color = colors[i % colors.count]
+            glow(&context, at: p, radius: r * 3, color: color, alpha: 0.3 * alpha)
+            var shard = Path()
+            for k in 0..<4 {
+                let a = angle + Double(k) * .pi / 2
+                let len = k % 2 == 0 ? r * 1.6 : r * 0.6
+                let q = CGPoint(x: p.x + cos(a) * len, y: p.y + sin(a) * len)
+                if k == 0 { shard.move(to: q) } else { shard.addLine(to: q) }
+            }
+            shard.closeSubpath()
+            context.fill(shard, with: .color(color.opacity(alpha)))
+        }
+    }
+
+    static func grain(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let frame = Int(t * 18)   // the grain changes 18 times a second, as film would
+        for i in 0..<140 {
+            let n = frame * 151 + i
+            let p = CGPoint(x: noise(n, 1) * size.width, y: noise(n, 2) * size.height)
+            let r = 0.6 + noise(n, 3) * 1.6
+            let light = noise(n, 4) > 0.5
+            context.fill(Path(ellipseIn: CGRect(x: p.x - r, y: p.y - r, width: r * 2, height: r * 2)),
+                         with: .color((light ? Color.white : Color.black).opacity(0.10 + noise(n, 5) * 0.12)))
+        }
+        // A scratch for a few frames every few seconds.
+        let beat = Int(t / 2.7)
+        if noise(beat, 9) > 0.45, wrap(t / 2.7) < 0.12 {
+            let x = noise(beat, 10) * size.width
+            var line = Path()
+            line.move(to: CGPoint(x: x, y: 0))
+            line.addLine(to: CGPoint(x: x + (noise(beat, 11) - 0.5) * 12, y: size.height))
+            context.stroke(line, with: .color(.white.opacity(0.18)), lineWidth: 1)
+        }
+        // The slight flicker of a projector.
+        let flicker = 0.025 * (0.5 + 0.5 * sin(t * 23))
+        context.fill(Path(CGRect(origin: .zero, size: size)), with: .color(.black.opacity(flicker)))
+    }
+}
