+/// The tray: the game card in its slot low in the middle, as in a Switch case, with the small arrow moulded beside it.
+struct CaseTray: View {
+    let game: GameTile
+    let width: CGFloat
+    let height: CGFloat
+    var cardInTray = true
+    /// The card's width for the tray's, its height for its width, and the tray's margin under the slot for its height. The box
+    /// view places the card it flies to the console from these.
+    static let cardShare: CGFloat = 0.3
+    static let cardRatio: CGFloat = 1.42
+    static let bottomShare: CGFloat = 0.09
+    /// A disc fills most of its tray, low, under the memory card holder, as in a PS2 case; an N64 cartridge, wider than tall,
+    /// lies in the middle of its wide box.
+    static func share(_ style: CaseStyle) -> CGFloat { style.disc ? 0.78 : style.cart64 ? 0.5 : cardShare }
+    static func ratio(_ style: CaseStyle) -> CGFloat { style.disc ? 1 : style.cart64 ? 0.72 : cardRatio }
+    static func bottom(_ style: CaseStyle, width: CGFloat, height: CGFloat) -> CGFloat {
+        if style.disc { return 0.05 }
+        if style.cart64 { return max(0.06, 0.5 - 0.5 * width * share(style) * ratio(style) / max(height, 1)) }
+        return bottomShare
+    }
+    @Environment(\.caseStyle) private var style
+    var body: some View {
+        CasePlastic(width: width, height: height) {
+            let cardWidth = width * Self.share(style)
+            let cardHeight = cardWidth * Self.ratio(style)
+            VStack(spacing: 0) {
+                Spacer(minLength: 0)
+                ZStack {
+                    // The slot: a dark recess a little larger than the card, or the disc's round seat with its hub.
+                    if style.disc {
+                        Circle().fill(style.dark.opacity(0.95)).frame(width: cardWidth * 1.06, height: cardWidth * 1.06)
+                            .overlay(Circle().stroke(.black.opacity(0.35), lineWidth: 2))
+                    } else if style.cart64 {
+                        RoundedRectangle(cornerRadius: cardWidth * 0.08).fill(style.dark.opacity(0.95))
+                            .frame(width: cardWidth * 1.08, height: cardHeight * 1.1)
+                            .overlay(RoundedRectangle(cornerRadius: cardWidth * 0.08).stroke(.black.opacity(0.35), lineWidth: 2))
+                    } else {
+                        GameCardShape(notch: cardWidth * 0.14)
+                            .fill(caseRedDark.opacity(0.95))
+                            .frame(width: cardWidth * 1.14, height: cardHeight * 1.1)
+                            .overlay(GameCardShape(notch: cardWidth * 0.14).stroke(.black.opacity(0.35), lineWidth: 2))
+                    }
+                    GameCard(game: game, width: cardWidth, height: cardHeight).opacity(cardInTray ? 1 : 0)
+                }
+                .overlay(alignment: .trailing) {
+                    // The moulded arrow beside the slot (a Switch or N64 case: a PS2 case has none).
+                    if !style.disc {
+                        Image(systemName: "arrowtriangle.left").font(.system(size: max(6, width * 0.05), weight: .light))
+                            .foregroundStyle(style.dark.opacity(0.9))
+                            .offset(x: width * 0.12)
+                    }
+                }
+                .padding(.bottom, height * Self.bottom(style, width: width, height: height))
+            }
+            .frame(width: width, height: height)
+            .overlay(alignment: .top) { if style.disc { memoryCardHolder.padding(.top, height * 0.07) } }
+        }
+    }
+    /// The memory card holder above the disc, as in a PS2 case: a recess with its two clips, the PlayStation logo and its name
+    /// moulded in.
+    private var memoryCardHolder: some View {
+        let w = width * 0.4, h = height * 0.22
+        let recess = RoundedRectangle(cornerRadius: w * 0.05)
+        return ZStack {
+            recess.fill(style.dark.opacity(0.95))
+                .overlay(recess.stroke(.black.opacity(0.4), lineWidth: 2))
+                .overlay(recess.inset(by: 2).stroke(.white.opacity(0.08), lineWidth: 1))
+            VStack(spacing: h * 0.06) {
+                Image(systemName: "playstation.logo").font(.system(size: h * 0.3, weight: .regular))
+                Text(verbatim: "MEMORY CARD\nHOLDER").font(ShellFonts.fixed(max(5, h * 0.11), weight: .semibold)).tracking(0.4)
+                    .multilineTextAlignment(.center).lineLimit(2).minimumScaleFactor(0.5)
+            }
+            .foregroundStyle(.white.opacity(0.45))
+            .padding(.top, h * 0.08)
+        }
+        .frame(width: w, height: h)
+        .overlay(alignment: .top) {
+            // The two clips that hold the card, over the recess's top edge.
+            HStack(spacing: w * 0.5) {
+                ForEach(0..<2, id: \.self) { _ in
+                    RoundedRectangle(cornerRadius: 2).fill(LinearGradient(colors: [style.light, style.dark], startPoint: .top, endPoint: .bottom))
+                        .frame(width: w * 0.16, height: h * 0.12)
+                        .shadow(color: .black.opacity(0.4), radius: 1.5, y: 1)
+                }
+            }
+            .offset(y: -h * 0.04)
+        }
+        .accessibilityHidden(true)
+    }
+}
