@@ -0,0 +1,165 @@
+import SwiftUI
+
+// MARK: Controller notice
+
+/// A controller came or went while the library is in view: shown a few seconds as a banner at the top, with its battery.
+public struct ControllerNotice: Equatable, Sendable {
+    public enum Kind: Equatable, Sendable { case connected, disconnected }
+    public var kind: Kind
+    public var name: String
+    public var batteryPercent: Int?
+    public var charging: Bool
+
+    /// The last change between two lists of controllers: one that arrived, else one that left. Nil when the same ones are there
+    /// (a battery level that moved is not news).
+    public static func change(from old: [ControllerInfo], to new: [ControllerInfo]) -> ControllerNotice? {
+        let before = Set(old.map(\.id)), after = Set(new.map(\.id))
+        if let came = new.last(where: { !before.contains($0.id) }) {
+            return ControllerNotice(kind: .connected, name: came.name, batteryPercent: came.batteryPercent, charging: came.charging)
+        }
+        if let left = old.last(where: { !after.contains($0.id) }) {
+            return ControllerNotice(kind: .disconnected, name: left.name, batteryPercent: nil, charging: false)
+        }
+        return nil
+    }
+    var low: Bool { kind == .connected && !charging && (batteryPercent ?? 100) < 20 }
+}
+
+/// The banner: the controller's icon, its name and what happened, and its battery when it reports one (amber when low).
+struct ControllerNoticeBanner: View {
+    let notice: ControllerNotice
+    var body: some View {
+        let connected = notice.kind == .connected
+        HStack(spacing: 12) {
+            Image(systemName: connected ? "gamecontroller.fill" : "gamecontroller")
+                .font(.system(size: 20, weight: .semibold))
+                .foregroundStyle(connected ? ShellPalette.cream : .white.opacity(0.6))
+            VStack(alignment: .leading, spacing: 1) {
+                Text(notice.name).shellText(15, .bold).lineLimit(1)
+                Text(connected ? ShellStrings.text("Controller connected") : ShellStrings.text("Controller disconnected"))
+                    .shellText(13).foregroundStyle(.white.opacity(0.7)).lineLimit(1)
+            }
+            if connected, let percent = notice.batteryPercent {
+                HStack(spacing: 5) {
+                    Image(systemName: notice.charging ? "battery.100.bolt" : Self.batteryIcon(percent))
+                    Text("\(percent) %").monospacedDigit()
+                }
+                .font(.system(size: 14, weight: .semibold))
+                .foregroundStyle(notice.low ? Color.orange : .white.opacity(0.85))
+                .padding(.leading, 6)
+            }
+        }
+        .padding(.horizontal, 18).padding(.vertical, 10)
+        .background(.black.opacity(0.72), in: Capsule())
+        .overlay(Capsule().strokeBorder(.white.opacity(notice.low ? 0 : 0.14)).overlay(Capsule().strokeBorder(Color.orange.opacity(notice.low ? 0.7 : 0))))
+        .shadow(color: .black.opacity(0.4), radius: 12, y: 4)
+        .accessibilityElement(children: .combine)
+        .accessibilityIdentifier("controller.notice")
+    }
+    static func batteryIcon(_ percent: Int) -> String {
+        switch percent {
+        case ..<13: "battery.0"
+        case ..<38: "battery.25"
+        case ..<63: "battery.50"
+        case ..<88: "battery.75"
+        default: "battery.100"
+        }
+    }
+}
+
+// MARK: New games
+
+/// The games added since the player last looked: each wears a "New" sticker until it is played. Kept on this device only.
+public enum NewGames {
+    public static let key = "shell.seenGames"
+
+    /// The games to mark, and the list to keep. The first time (nothing kept yet) every game is taken as known: no sticker on
+    /// a library the player already had.
+    public static func resolve(ids: [String], seen: [String]?) -> (fresh: Set<String>, seen: [String]) {
+        guard let seen else { return ([], ids) }
+        let known = Set(seen)
+        return (Set(ids.filter { !known.contains($0) }), seen)
+    }
+    @MainActor static func load(_ ids: [String], defaults: UserDefaults = .standard) -> Set<String> {
+        let result = resolve(ids: ids, seen: defaults.stringArray(forKey: key))
+        defaults.set(result.seen, forKey: key)
+        return result.fresh
+    }
+    @MainActor static func played(_ id: String, defaults: UserDefaults = .standard) {
+        var seen = defaults.stringArray(forKey: key) ?? []
+        if !seen.contains(id) { seen.append(id); defaults.set(seen, forKey: key) }
+    }
+}
+
+/// The sticker on a new game's box, top right, a little askew as one stuck on in a shop.
+struct NewSticker: View {
+    let width: CGFloat
+    var body: some View {
+        let size = max(9, min(15, width * 0.062))
+        Text(ShellStrings.text("New").uppercased())
+            .font(.system(size: size, weight: .heavy)).tracking(0.6)
+            .foregroundStyle(.white)
+            .padding(.horizontal, size * 0.7).padding(.vertical, size * 0.32)
+            .background(LinearGradient(colors: [Color(red: 1, green: 0.32, blue: 0.22), Color(red: 0.86, green: 0.12, blue: 0.16)],
+                                       startPoint: .top, endPoint: .bottom), in: RoundedRectangle(cornerRadius: size * 0.35))
+            .overlay(RoundedRectangle(cornerRadius: size * 0.35).strokeBorder(.white.opacity(0.85), lineWidth: max(1, size * 0.1)))
+            .shadow(color: .black.opacity(0.45), radius: 3, y: 2)
+            .rotationEffect(.degrees(8))
+            .offset(x: size * 0.5, y: -size * 0.5)
+            .accessibilityIdentifier("box.new")
+    }
+}
+
+// MARK: Opening
+
+/// The library coming on when the app opens: dark at first, a band of light sweeps the shelf from left to right and the boxes
+/// light up as it passes, then a soft glow fades. About 1.3 s; any button or a touch skips it.
+struct LibraryIntro: View {
+    let start: Date
+    /// 1.3 s; `--intro-length` slows it down for the frame-by-frame review.
+    static let length: Double = {
+        let args = ProcessInfo.processInfo.arguments
+        if let at = args.firstIndex(of: "--intro-length"), at + 1 < args.count, let value = Double(args[at + 1]) { return value }
+        return 1.3
+    }()
+    var body: some View {
+        TimelineView(.animation) { timeline in
+            let t = timeline.date.timeIntervalSince(start)
+            let sweep = min(1, max(0, t / (Self.length * 0.8)))          // where the light is, across the width
+            let eased = sweep * sweep * (3 - 2 * sweep)
+            let after = max(0, (t - Self.length * 0.8) / (Self.length * 0.2))
+            GeometryReader { geometry in
+                let w = geometry.size.width, h = geometry.size.height
+                let x = -0.15 + eased * 1.3                                // the band's centre, as a share of the width
+                ZStack {
+                    // The dark, still over what the light has not reached yet.
+                    Rectangle().fill(.black)
+                        .mask(LinearGradient(stops: [.init(color: .clear, location: max(0, x - 0.12)),
+                                                     .init(color: .black, location: min(1, max(0.001, x + 0.02)))],
+                                             startPoint: .leading, endPoint: .trailing))
+                        .opacity(1 - after)
+                    // The band of light, and its glow on the floor.
+                    LinearGradient(stops: [.init(color: .clear, location: 0), .init(color: .white.opacity(0.55), location: 0.5),
+                                           .init(color: .clear, location: 1)], startPoint: .leading, endPoint: .trailing)
+                        .frame(width: w * 0.22)
+                        .position(x: x * w, y: h / 2)
+                        .opacity(sweep < 1 ? 1 : 0)
+                        .blendMode(.plusLighter)
+                    RadialGradient(colors: [ShellPalette.cream.opacity(0.35), .clear], center: .center, startRadius: 0, endRadius: w * 0.5)
+                        .opacity(sweep < 1 ? 0 : 0.8 * (1 - after))
+                        .blendMode(.plusLighter)
+                }
+            }
+        }
+        .ignoresSafeArea()
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+    }
+}
+
+/// What outlives a library view: the opening runs once per launch, and the banner's timer knows when a newer one replaced it.
+@MainActor enum LibraryClock {
+    static var introPlayed = false
+    static var introRunning = false
+    static var notice = 0
+}
