@@ -0,0 +1,46 @@
+import Foundation
+import Testing
+@testable import ShellHost
+
+/// A game's info-panel extras beside its banner: `screens/` (pictures, in name order, at most 8) and `synopsis.txt`.
+@Suite struct GameFicheTests {
+    @Test func screenshotsAreListedInNameOrderAndOnlyPictures() throws {
+        let box = try FrameworkBox()
+        let fw = try box.makeFramework()
+        let screens = fw.appendingPathComponent("screens")
+        for name in ["10.jpg", "2.jpg", "1.png", "notes.txt", ".hidden.jpg"] { try box.write("x", to: screens.appendingPathComponent(name)) }
+        let entry = try #require(GameCatalogue.scan(root: box.frameworks).first)
+        #expect(entry.screenURLs.map(\.lastPathComponent) == ["1.png", "2.jpg", "10.jpg"])
+    }
+
+    @Test func atMostEightScreenshots() throws {
+        let box = try FrameworkBox()
+        let fw = try box.makeFramework()
+        for i in 1...11 { try box.write("x", to: fw.appendingPathComponent("screens/\(i).jpg")) }
+        #expect(try #require(GameCatalogue.scan(root: box.frameworks).first).screenURLs.count == 8)
+    }
+
+    @Test func theSynopsisIsTrimmedAndAnEmptyOneIsNone() throws {
+        let box = try FrameworkBox()
+        let fw = try box.makeFramework()
+        try box.write("\n  Une aventure à travers le globe.  \n", to: fw.appendingPathComponent("synopsis.txt"))
+        let entry = try #require(GameCatalogue.scan(root: box.frameworks).first)
+        #expect(entry.synopsis == "Une aventure à travers le globe.")
+        try box.write(" \n", to: fw.appendingPathComponent("synopsis.txt"))
+        #expect(try #require(GameCatalogue.scan(root: box.frameworks).first).synopsis == nil)
+    }
+
+    @Test func withoutExtrasNothingIsListed() throws {
+        let box = try FrameworkBox()
+        try box.makeFramework()
+        let entry = try #require(GameCatalogue.scan(root: box.frameworks).first)
+        #expect(entry.screenURLs.isEmpty && entry.synopsis == nil && entry.backURL == nil)
+    }
+
+    @Test func theBackOfTheBoxIsFoundBesideTheBanner() throws {
+        let box = try FrameworkBox()
+        let fw = try box.makeFramework()
+        try box.write("x", to: fw.appendingPathComponent("back.jpg"))
+        #expect(try #require(GameCatalogue.scan(root: box.frameworks).first).backURL?.lastPathComponent == "back.jpg")
+    }
+}
diff --git a/frontend-ios/Tests/ShellHostTests/PlayStatsTests.swift b/frontend-ios/Tests/ShellHostTests/PlayStatsTests.swift
new file mode 100644
index 0000000..8ededfd
--- /dev/null
+++ b/frontend-ios/Tests/ShellHostTests/PlayStatsTests.swift
@@ -0,0 +1,153 @@
+import Foundation
+import Testing
+import ShellUI
+@testable import ShellHost
+
+/// The info panel's figures: each Play is a launch, a session runs to its last sign of life, it is closed once at the next start
+/// of the app, and a launch that fails is taken back.
+@Suite struct PlayStatsTests {
+    private let t0 = Date(timeIntervalSince1970: 2_000_000)
+
+    @Test func aSessionEndsAtItsLastMark() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.alive(t0.addingTimeInterval(600))
+        #expect(store.launches == 1)
+        #expect(store.openSession == t0)
+        store.settle(lastSign: nil)
+        #expect(store.seconds == 600)
+        #expect(store.openSession == nil)
+    }
+
+    @Test func aClosedSessionIsKeptForTheFigures() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.alive(t0.addingTimeInterval(600))
+        store.settle(lastSign: nil)
+        store.record(start: t0.addingTimeInterval(10_000), end: t0.addingTimeInterval(11_800))
+        #expect(store.sessions == [PlaySession(start: t0, seconds: 600), PlaySession(start: t0.addingTimeInterval(10_000), seconds: 1800)])
+        #expect(store.launches == 2)
+        #expect(store.seconds == 2400)
+        let stats = PlayStats(launches: 2, seconds: 2400, sessions: store.sessions)
+        #expect(stats.average == 1200)
+        #expect(stats.longest == 1800)
+        #expect(stats.firstPlayed == t0)
+    }
+
+    @Test func theStatusAndTheFavouriteAreKept() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        #expect(store.status == nil)
+        #expect(!store.favourite)
+        store.setStatus(.finished)
+        store.setFavourite(true)
+        #expect(store.status == .finished)
+        #expect(store.favourite)
+        store.setStatus(nil)
+        #expect(store.status == nil)
+    }
+
+    @Test func theWeeksCountBackFromThisOne() {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(identifier: "UTC")!
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+        let stats = PlayStats(sessions: [PlaySession(start: now, seconds: 3600), PlaySession(start: now.addingTimeInterval(-7 * 86_400), seconds: 600),
+                                         PlaySession(start: now.addingTimeInterval(-70 * 86_400), seconds: 999)])
+        let weeks = stats.weekly(8, now: now, calendar: calendar)
+        #expect(weeks.count == 8)
+        #expect(weeks[7] == 3600)
+        #expect(weeks[6] == 600)
+        #expect(weeks.reduce(0, +) == 4200)
+    }
+
+    @Test func theLogsLastWriteCountsWhenItIsLater() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.alive(t0.addingTimeInterval(60))
+        store.settle(lastSign: t0.addingTimeInterval(1500))
+        #expect(store.seconds == 1500)
+    }
+
+    @Test func aSignFromBeforeTheSessionIsNotItsOwn() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.settle(lastSign: t0.addingTimeInterval(-3600))
+        #expect(store.seconds == 0)
+        #expect(store.launches == 1)
+    }
+
+    @Test func aSessionIsNeverLongerThanTwelveHours() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.settle(lastSign: t0.addingTimeInterval(3 * 86_400))
+        #expect(store.seconds == PlayStatsStore.longest)
+    }
+
+    @Test func sessionsAddUpAndAnOpenOneIsClosedByTheNextPlay() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.alive(t0.addingTimeInterval(300))
+        store.begin(t0.addingTimeInterval(4000))   // never settled: the next Play closes it at its own last mark
+        store.alive(t0.addingTimeInterval(4120))
+        store.settle(lastSign: nil)
+        #expect(store.launches == 2)
+        #expect(store.seconds == 420)
+    }
+
+    @Test func aMarkWithNoOpenSessionDoesNothing() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.alive(t0)
+        store.settle(lastSign: t0)
+        #expect(store.seconds == 0)
+        #expect(store.launches == 0)
+        #expect(box.defaults(Fixtures.orbit).object(forKey: PlayStatsStore.aliveKey) == nil)
+    }
+
+    @Test func aCancelledLaunchIsTakenBack() throws {
+        let box = try Sandbox()
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.settle(lastSign: t0.addingTimeInterval(60))
+        store.begin(t0.addingTimeInterval(100))
+        store.cancel()
+        #expect(store.launches == 1)
+        #expect(store.seconds == 60)
+        #expect(store.openSession == nil)
+    }
+
+    @MainActor @Test func theStubLauncherCountsNoLaunch() async throws {
+        let box = try Sandbox()
+        try box.giveAppData()
+        let model = ShellHostModel(config: box.config(now: { Date(timeIntervalSince1970: 2_000_000) }))
+        await model.playNow(Fixtures.orbit)   // the stub fails: the game never started
+        let stats = try #require(model.details.first { $0.id == Fixtures.orbit }?.game.stats)
+        #expect(stats.launches == 0)
+        #expect(stats.seconds == 0)
+        #expect(stats.lastPlayed == Date(timeIntervalSince1970: 2_000_000), "the last-played date is kept, as before")
+    }
+
+    @MainActor @Test func theFirstLoadClosesTheSessionOfTheLastRun() throws {
+        let box = try Sandbox()
+        try box.giveAppData()
+        // A game played in the last run of the app: its session is open, last marked alive 10 minutes in.
+        let store = PlayStatsStore(defaults: box.defaults(Fixtures.orbit))
+        store.begin(t0)
+        store.alive(t0.addingTimeInterval(600))
+        let model = ShellHostModel(config: box.config())
+        let stats = try #require(model.details.first { $0.id == Fixtures.orbit }?.game.stats)
+        #expect(stats.launches == 1)
+        #expect(stats.seconds == 600)
+        #expect(store.openSession == nil)
+        // A reload while the app runs does not touch a session.
+        store.begin(t0.addingTimeInterval(1000))
+        model.reload()
+        #expect(store.openSession != nil)
+    }
+}
