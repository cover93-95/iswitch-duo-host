diff --git a/frontend-ios/Sources/ShellUI/MenuMusic.swift b/frontend-ios/Sources/ShellUI/MenuMusic.swift
new file mode 100644
index 0000000..69b193d
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/MenuMusic.swift
@@ -0,0 +1,70 @@
+import AVFoundation
+import Foundation
+
+/// The library's music: a soft loop the IPA carries beside the app (`menu-music.m4a`, never in the repository), played while the
+/// library is on screen. It fades in, goes quieter while a box is open, almost silent while the game goes into the console so its
+/// click or its disc is heard, and stops once a game plays. Without the file (the demo, the tests) there is no music. The shell's
+/// settings turn it off. Same playback session as the other sounds: heard with the ring/silent switch on, mixed with other audio.
+@MainActor enum MenuMusic {
+    /// The loop's volume at full level: under the navigation sounds.
+    static let volume: Float = 0.3
+    /// The level for an open box, and for the moment the game goes in.
+    static let boxLevel: Float = 0.5
+    static let insertLevel: Float = 0.06
+
+    private static var player: AVAudioPlayer?
+    private static var level: Float = 1
+    /// Counts the fades out, so a pause at the end of one never stops music started again meanwhile.
+    private static var generation = 0
+
+    static var enabled: Bool { ShellSettingsStore.current.menuMusic }
+
+    /// Plays at the current level, fading in (or back up after a fade out).
+    static func start(level newLevel: Float = 1) {
+        level = newLevel
+        guard enabled, let player = loaded() else { stop(fade: 0.3); return }
+        generation += 1
+        if !player.isPlaying {
+            player.volume = 0
+            player.play()
+        }
+        player.setVolume(volume * level, fadeDuration: 1.2)
+    }
+
+    /// Quieter, or back to the full level, over `duration` seconds, while it plays.
+    static func duck(to newLevel: Float, over duration: TimeInterval) {
+        level = newLevel
+        guard let player, player.isPlaying else { return }
+        player.setVolume(volume * level, fadeDuration: duration)
+    }
+
+    /// Fades out and pauses: the loop starts again where it was.
+    static func stop(fade: TimeInterval = 0.6) {
+        guard let player, player.isPlaying else { return }
+        generation += 1
+        let mine = generation
+        player.setVolume(0, fadeDuration: fade)
+        Task { @MainActor in
+            try? await Task.sleep(for: .seconds(fade + 0.05))
+            if mine == generation { player.pause() }
+        }
+    }
+
+    /// The setting changed: on plays, off stops.
+    static func refresh() { if enabled { start(level: level) } else { stop(fade: 0.3) } }
+
+    private static func loaded() -> AVAudioPlayer? {
+        if let player { return player }
+        guard let url = ["m4a", "caf", "wav", "mp3"].lazy.compactMap({ Bundle.main.url(forResource: "menu-music", withExtension: $0) }).first
+        else { return nil }
+        #if os(iOS)
+        try? AVAudioSession.sharedInstance().setCategory(.playback, mode: .default, options: [.mixWithOthers])
+        try? AVAudioSession.sharedInstance().setActive(true)
+        #endif
+        let made = try? AVAudioPlayer(contentsOf: url)
+        made?.numberOfLoops = -1
+        made?.prepareToPlay()
+        player = made
+        return made
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/NavSound.swift b/frontend-ios/Sources/ShellUI/NavSound.swift
new file mode 100644
index 0000000..1a98783
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/NavSound.swift
@@ -0,0 +1,88 @@
+import AVFoundation
+import Foundation
+
+/// The library's small sounds, made here as samples like the card's click (no sound file): a light plastic tick as the next box
+/// comes to the middle, and a lower, fuller knock when the shoulder buttons change the console. Quiet, in the same playback session
+/// as the insertion, so they are heard with the ring/silent switch on, as a console's menu sounds are.
+@MainActor enum NavSound {
+    private static var tickPlayer: AVAudioPlayer?
+    private static var shiftPlayer: AVAudioPlayer?
+    /// The last tick, so a held D-pad or a fast scroll does not stack clicks closer than a console's menu would.
+    private static var lastTick = Date.distantPast
+
+    static func tick() {
+        let now = Date()
+        guard now.timeIntervalSince(lastTick) > 0.045 else { return }
+        lastTick = now
+        if tickPlayer == nil { tickPlayer = player(tickSamples(rate: 44_100), volume: 0.32) }
+        replay(tickPlayer)
+    }
+
+    static func shift() {
+        if shiftPlayer == nil { shiftPlayer = player(shiftSamples(rate: 44_100), volume: 0.5) }
+        replay(shiftPlayer)
+    }
+
+    private static func player(_ samples: [Float], volume: Float) -> AVAudioPlayer? {
+        #if os(iOS)
+        try? AVAudioSession.sharedInstance().setCategory(.playback, mode: .default, options: [.mixWithOthers])
+        try? AVAudioSession.sharedInstance().setActive(true)
+        #endif
+        let p = try? AVAudioPlayer(data: InsertSound.wav(samples))
+        p?.volume = volume
+        p?.prepareToPlay()
+        return p
+    }
+    private static func replay(_ p: AVAudioPlayer?) {
+        p?.currentTime = 0
+        p?.play()
+    }
+
+    /// About 35 ms: a breath of noise, then a short bright click of hard plastic.
+    static func tickSamples(rate: Int) -> [Float] {
+        let count = Int(Double(rate) * 0.035)
+        var out = [Float](repeating: 0, count: count)
+        var seed: UInt32 = 0x1B87_3593
+        func noise() -> Float {
+            seed = seed &* 1_664_525 &+ 1_013_904_223
+            return Float(Int32(bitPattern: seed)) / Float(Int32.max)
+        }
+        for i in 0..<count {
+            let t = Double(i) / Double(rate)
+            var v: Float = 0
+            if t < 0.006 { v += noise() * 0.12 * Float(t / 0.006) }
+            if t >= 0.006 {
+                let u = t - 0.006
+                v += Float(exp(-u / 0.0018)) * (0.55 * Float(sin(2 * .pi * 2_400 * u)) + 0.2 * noise())
+                v += Float(exp(-u / 0.006)) * 0.18 * Float(sin(2 * .pi * 900 * u))
+            }
+            out[i] = max(-1, min(1, v))
+        }
+        return out
+    }
+
+    /// About 140 ms: a soft click, then a low rounded knock that settles, as a heavier part sliding into place.
+    static func shiftSamples(rate: Int) -> [Float] {
+        let count = Int(Double(rate) * 0.14)
+        var out = [Float](repeating: 0, count: count)
+        var seed: UInt32 = 0x85EB_CA6B
+        func noise() -> Float {
+            seed = seed &* 1_664_525 &+ 1_013_904_223
+            return Float(Int32(bitPattern: seed)) / Float(Int32.max)
+        }
+        var low: Float = 0
+        for i in 0..<count {
+            let t = Double(i) / Double(rate)
+            var v: Float = 0
+            low += (noise() - low) * 0.1
+            if t < 0.012 { v += low * 0.6 * Float(t / 0.012) }
+            if t >= 0.012 {
+                let u = t - 0.012
+                v += Float(exp(-u / 0.002)) * 0.3 * Float(sin(2 * .pi * 1_600 * u))
+                v += Float(exp(-u / 0.04)) * (0.55 * Float(sin(2 * .pi * 190 * u)) + 0.2 * Float(sin(2 * .pi * 380 * u)))
+            }
+            out[i] = max(-1, min(1, v))
+        }
+        return out
+    }
+}
