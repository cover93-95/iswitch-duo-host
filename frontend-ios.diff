+import Foundation
+import Testing
+@testable import ShellUI
+
+/// Turning a box over (a drag settles on the nearest face, one face at most; View turns it the same way each time), and the N64
+/// scene's layout (the cartridge above the slot, the console under it, both on screen).
+@Suite struct BoxTurnTests {
+    @Test func aShortDragFallsBackToTheFront() {
+        #expect(BoxTurn.settle(start: 0, predicted: 60) == 0)
+        #expect(BoxTurn.settle(start: 0, predicted: -70) == 0)
+    }
+
+    @Test func aDragPastAQuarterTurnShowsTheBack() {
+        #expect(BoxTurn.settle(start: 0, predicted: 120) == 180)
+        #expect(BoxTurn.settle(start: 0, predicted: -100) == -180)
+        #expect(BoxTurn.showsBack(180) && BoxTurn.showsBack(-180) && !BoxTurn.showsBack(0) && !BoxTurn.showsBack(360))
+    }
+
+    @Test func aFlingTurnsOneFaceAtMost() {
+        #expect(BoxTurn.settle(start: 0, predicted: 900) == 180)
+        #expect(BoxTurn.settle(start: 180, predicted: -700) == 0)
+    }
+
+    @Test func theTurnButtonAlternatesTheFaces() {
+        let first = BoxTurn.next(from: 0)
+        #expect(BoxTurn.showsBack(first))
+        let second = BoxTurn.next(from: first)
+        #expect(!BoxTurn.showsBack(second))
+        // From partway (a drag let go mid-animation), the next face is still one step on.
+        #expect(BoxTurn.next(from: 170) == 360)
+    }
+
+    @Test func aDragAcrossTheBoxIsHalfATurn() {
+        #expect(BoxTurn.angle(drag: 200, width: 200) == 180)
+        #expect(BoxTurn.angle(drag: -50, width: 200) == -45)
+    }
+
+    @Test func theCartridgeWaitsAboveTheSlotAndTheSceneFitsTheScreen() {
+        for size in [CGSize(width: 1180, height: 820), CGSize(width: 844, height: 390), CGSize(width: 2316, height: 1512)] {
+            let l = CartridgeConsoleView.layout(in: size)
+            #expect(l.restCentre + l.cart.height / 2 < l.slotLine)
+            #expect(l.slotLine > l.consoleTop && l.slotLine < l.consoleTop + l.console.height)
+            #expect(l.restCentre - l.cart.height / 2 > 0)
+            #expect(l.consoleTop + l.console.height <= size.height)
+            #expect(l.console.width <= size.width && l.cart.width < l.console.width)
+        }
+    }
+}
