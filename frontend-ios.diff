+import SwiftUI
+
+/// A game's box, opened in 3D: it turns to face the player, then its cover swings open on the left hinge like a book. Inside, the
+/// cover holds the instruction booklet and the tray holds the game card, low in the middle as in a Switch case. Drawn from the
+/// game's own box art, with no other picture.
+/// Playing is putting the card in the console: a tap on the card (or A, the card being the focus) lifts it out of the tray, flies it
+/// to the slot at the top right of the screen and pushes it in, with a click and a knock of the haptics; the slot flares, the
+/// screen fades to black, and the game starts there, its first frames being black too.
+/// A tap on the box or the round button closes and opens it, Game info opens the info panel, B, a tap beside it or Close leaves.
+struct GameBoxView: View {
+    let game: GameTile
+    /// Play: the game's one action. For a game that can start, the insertion plays first.
+    let insert: () -> Void
+    let showInfo: () -> Void
+    let close: () -> Void
+    /// The box has come forward.
+    @State private var shown = false
+    @State private var opened = false
+    @State private var phase = InsertPhase.idle
+    /// Counts the clicks, for the haptic feedback.
+    @State private var clicks = 0
+    /// The screen going to black once the card is in, before the game takes it over.
+    @State private var blackout = false
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    enum InsertPhase { case idle, lifted, flying, inside }
+    private var playable: Bool { game.state == .playable }
+
+    var body: some View {
+        GeometryReader { geometry in
+            // As tall as leaves room for the buttons, and never wider open than the screen.
+            let height = min(geometry.size.height * 0.72, geometry.size.width * 0.86 / (2 * CoverFlowView.boxRatio))
+            let width = height * CoverFlowView.boxRatio
+            let size = geometry.size
+            // Where the card lies in the open tray (see CaseTray), on the screen: the tray is the right half of the open case.
+            let disc = game.isDisc
+            let card = CGSize(width: width * CaseTray.share(disc), height: width * CaseTray.share(disc) * CaseTray.ratio(disc))
+            let caseCentre = CGPoint(x: size.width / 2, y: size.height / 2 - height * 0.03)
+            let inTray = CGPoint(x: caseCentre.x + width / 2,
+                                 y: caseCentre.y + height / 2 - height * CaseTray.bottom(disc, width: width, height: height) - card.height * 0.55)
+            // The console's slot, at the top right: the card arrives under it at `scale` and goes in upward.
+            let scale: CGFloat = disc ? 0.5 : 0.55
+            let slot = CGPoint(x: size.width - 40 - card.width * scale * 0.6, y: 92)
+            ZStack {
+                RadialGradient(colors: [Color(red: 0.16, green: 0.17, blue: 0.2).opacity(0.94), .black.opacity(0.94)],
+                               center: .center, startRadius: 40, endRadius: max(size.width, size.height) * 0.7)
+                    .ignoresSafeArea()
+                    .contentShape(Rectangle())
+                    .onTapGesture { if phase == .idle { close() } }
+                    .accessibilityHidden(true)
+                OpeningCase(game: game, width: width, progress: opened ? 1 : 0, cardInTray: phase == .idle)
+                    .rotation3DEffect(.degrees(shown ? 0 : 38), axis: (x: 0, y: 1, z: 0), perspective: 0.45)
+                    .rotation3DEffect(.degrees(shown ? 4 : 0), axis: (x: 1, y: 0, z: 0), perspective: 0.45)
+                    .scaleEffect(shown ? 1 : 0.5)
+                    .opacity(shown ? 1 : 0)
+                    .offset(y: -height * 0.03)
+                    .onTapGesture { if phase == .idle { toggle() } }
+                    .accessibilityElement()
+                    .accessibilityLabel(game.title)
+                    .accessibilityValue(opened ? ShellStrings.text("Open") : ShellStrings.text("Closed"))
+                    .accessibilityAddTraits(.isButton)
+                    .accessibilityAction(named: opened ? ShellStrings.text("Close the box") : ShellStrings.text("Open the box"), toggle)
+                    .accessibilityIdentifier("box.case")
+                // The card, as a button over the one in the tray, once the box is open.
+                if opened && phase == .idle {
+                    Button(action: play) { Color.clear.contentShape(Rectangle()) }
+                        .buttonStyle(.plain)
+                        .frame(width: card.width * 1.1, height: card.height * 1.1)
+                        .position(inTray)
+                        .accessibilityLabel(ShellStrings.text(game.isDisc ? "Insert the disc" : "Insert the game card") + ", " + game.title)
+                        .accessibilityIdentifier("box.cart")
+                        .shellTarget("box.cart", radius: card.width * 0.06, action: play)
+                        .transition(.opacity)
+                }
+                ConsoleSlot(width: card.width * scale * 1.18, lit: phase == .flying || phase == .inside, flare: phase == .inside)
+                    .position(x: slot.x, y: slot.y)
+                    .opacity(opened && playable ? 1 : 0)
+                    .accessibilityHidden(true)
+                if phase != .idle {
+                    // The flying card, masked above the slot's line: going up through it, it goes into the console.
+                    ZStack {
+                        GameCard(game: game, width: card.width, height: card.height)
+                            .scaleEffect(phase == .idle ? 1 : phase == .lifted ? 1.12 : scale)
+                            // A disc turns a little as it goes, slowly, as a disc would; a card only tilts as it lifts
+                            .rotationEffect(.degrees(disc ? (phase == .lifted ? 20 : phase == .flying ? 140 : 210) : (phase == .lifted ? -4 : 0)))
+                            .shadow(color: .black.opacity(0.5), radius: phase == .lifted ? 24 : 8, y: phase == .lifted ? 14 : 4)
+                            .position(phase == .lifted ? CGPoint(x: inTray.x, y: inTray.y - card.height * 0.18)
+                                      : phase == .flying ? CGPoint(x: slot.x, y: slot.y + card.height * scale / 2 + 6)
+                                      : CGPoint(x: slot.x, y: slot.y - card.height * scale / 2 - 4))
+                    }
+                    .frame(width: size.width, height: size.height)
+                    .mask(alignment: .top) {
+                        Rectangle().padding(.top, phase == .lifted ? 0 : slot.y)
+                    }
+                    .allowsHitTesting(false)
+                    .accessibilityHidden(true)
+                }
+                VStack(spacing: 0) {
+                    HStack(alignment: .top) {
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(game.title).shellType(ShellType.cardTitle).foregroundStyle(.white.opacity(0.85)).lineLimit(1)
+                            Text(statsLine).shellType(ShellType.note).foregroundStyle(.white.opacity(0.5)).lineLimit(1)
+                        }
+                        Spacer(minLength: 12)
+                        Button(action: close) { Label(ShellStrings.text("Close"), systemImage: "xmark") }
+                            .buttonStyle(ChipButtonStyle())
+                            .accessibilityIdentifier("box.close")
+                            .shellTarget("box.close", radius: 22, action: close)
+                            // The slot sits under this corner: the close button steps left of it.
+                            .padding(.trailing, playable ? card.width * scale * 1.3 + 16 : 0)
+                    }
+                    Spacer(minLength: 0)
+                    HStack(spacing: 20) {
+                        if opened && playable {
+                            GlyphHint(role: .activate, label: ShellStrings.text(game.isDisc ? "Insert the disc" : "Insert the game card"))
+                        }
+                        Button(action: toggle) {
+                            Label(opened ? ShellStrings.text("Close the box") : ShellStrings.text("Open the box"),
+                                  systemImage: opened ? "arrow.uturn.backward" : "book.pages")
+                        }
+                        .buttonStyle(ChipButtonStyle())
+                        .accessibilityIdentifier("box.toggle")
+                        .shellTarget("box.toggle", radius: 22, action: toggle)
+                        Button(action: showInfo) { Label(ShellStrings.text("Game info"), systemImage: "info.circle") }
+                            .buttonStyle(ChipButtonStyle())
+                            .accessibilityIdentifier("box.info")
+                            .shellTarget("box.info", radius: 22, action: showInfo)
+                        GlyphHint(role: .back, label: ShellStrings.text("Back"))
+                    }
+                }
+                .padding(.horizontal, 24).padding(.vertical, 12)
+                .allowsHitTesting(phase == .idle)
+                Color.black.ignoresSafeArea()
+                    .opacity(blackout ? 1 : 0)
+                    .allowsHitTesting(blackout)
+                    .accessibilityHidden(true)
+            }
+            .frame(width: size.width, height: size.height)
+        }
+        .sensoryFeedback(.impact(weight: .heavy, intensity: 1), trigger: clicks)
+        .onAppear(perform: present)
+        .environment(\.caseStyle, .of(game))   // a disc and its black case for a disc platform
+    }
+
+    private var statsLine: String {
+        ShellFormat.metaLine(ShellStrings.text("Played") + " " + ShellFormat.playTime(game.stats.seconds),
+                             ShellFormat.lastPlayed(game.stats.lastPlayed),
+                             ShellStrings.text("Launches") + " \(game.stats.launches)")
+    }
+
+    private func present() {
+        if playable { InsertSound.prepare(disc: game.isDisc) }
+        if reduceMotion { shown = true; opened = true; return }
+        withAnimation(.spring(duration: 0.6, bounce: 0.18)) { shown = true }
+        withAnimation(.easeInOut(duration: 1.05).delay(0.5)) { opened = true }
+    }
+    /// The game, from the black screen. A game that does not start leaves the box here: after a moment the screen comes back and
+    /// the card is in the tray again, for another try or to leave.
+    private func start() {
+        insert()
+        DispatchQueue.main.asyncAfter(deadline: .now() + 4) {
+            withAnimation(.easeOut(duration: 0.4)) { blackout = false; phase = .idle }
+        }
+    }
+    private func toggle() {
+        guard phase == .idle else { return }
+        withAnimation(reduceMotion ? nil : .easeInOut(duration: 0.9)) { opened.toggle() }
+    }
+    /// The card into the console, then the game. A game that cannot start takes its way out at once.
+    private func play() {
+        guard phase == .idle else { return }
+        guard playable else { insert(); return }
+        if reduceMotion {
+            InsertSound.play(disc: game.isDisc); clicks += 1
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { insert() }
+            return
+        }
+        if game.isDisc { playDisc(); return }
+        withAnimation(.easeOut(duration: 0.18)) { phase = .lifted } completion: {
+            withAnimation(.easeInOut(duration: 0.5)) { phase = .flying } completion: {
+                withAnimation(.easeIn(duration: 0.14)) { phase = .inside } completion: {
+                    InsertSound.play(disc: false)
+                    clicks += 1
+                    // The slot flares, then the screen fades to black and the game starts in the dark.
+                    withAnimation(.easeIn(duration: 0.6).delay(0.3)) { blackout = true } completion: { start() }
+                }
+            }
+        }
+    }
+    /// A disc, slower than a card and in step with the drive's sound (about 2 s): it lifts from its hub, glides to the drive
+    /// without a jump in size, and the drive draws it in while the sound plays from its first touch; the screen goes dark as the
+    /// sound fades out (InsertSound cuts the recording's last knock).
+    private func playDisc() {
+        withAnimation(.easeOut(duration: 0.4)) { phase = .lifted } completion: {
+            withAnimation(.easeInOut(duration: 0.85)) { phase = .flying } completion: {
+                InsertSound.play(disc: true)
+                clicks += 1
+                withAnimation(.easeInOut(duration: 1.0)) { phase = .inside } completion: {
+                    withAnimation(.easeIn(duration: 0.5).delay(0.15)) { blackout = true } completion: { start() }
+                }
+            }
+        }
+    }
+}
+
+/// The console's card slot at the top right of the box screen: a dark opening in a rim, lit while a card goes in.
+private struct ConsoleSlot: View {
+    let width: CGFloat
+    let lit: Bool
+    /// The card is in: a brighter, wider light around the slot.
+    var flare = false
+    @Environment(\.caseStyle) private var style
+    var body: some View {
+        let glow = style.disc ? Color(red: 0.55, green: 0.75, blue: 1.0) : Color(red: 0.35, green: 0.65, blue: 1.0)
+        // A disc goes into a slot-loading drive: a longer, thinner slit in a flat bezel, the disc mark beside it.
+        let rim = style.disc ? CGSize(width: width * 1.25 + 46, height: 18) : CGSize(width: width + 18, height: 22)
+        let slit = style.disc ? CGSize(width: width * 1.12, height: 3) : CGSize(width: width, height: 6)
+        ZStack {
+            Capsule().fill(LinearGradient(colors: style.disc ? [Color(white: 0.22), Color(white: 0.08)] : [Color(white: 0.28), Color(white: 0.12)],
+                                          startPoint: .top, endPoint: .bottom))
+                .frame(width: rim.width, height: rim.height)
+                .overlay(Capsule().strokeBorder(.white.opacity(0.18), lineWidth: 1))
+            Capsule().fill(flare ? glow.mix(with: .white, by: 0.55) : .black).frame(width: slit.width, height: slit.height)
+                .shadow(color: lit ? glow : .clear, radius: lit ? (flare ? 14 : 8) : 0)
+                .shadow(color: flare ? glow.opacity(0.9) : .clear, radius: flare ? 28 : 0)
+            if style.disc {
+                HStack {
+                    Image(systemName: "opticaldisc").font(.system(size: 10, weight: .semibold))
+                    Spacer()
+                    Image(systemName: "eject.fill").font(.system(size: 8, weight: .semibold))
+                }
+                .foregroundStyle(.white.opacity(lit ? 0.75 : 0.4))
+                .padding(.horizontal, 9)
+                .frame(width: rim.width, height: rim.height)
+            }
+        }
+        .shadow(color: .black.opacity(0.5), radius: 8, y: 3)
+        .animation(.easeOut(duration: 0.2), value: lit)
+        .animation(.easeOut(duration: 0.25), value: flare)
+    }
+}
+
+/// Switch-case red plastic, lit from the top left.
+private let caseRed = Color(red: 0.84, green: 0.07, blue: 0.11)
+private let caseRedDark = Color(red: 0.58, green: 0.03, blue: 0.07)
+
+/// The case of the game's platform: the red Switch case with its card, or a black disc case with its disc for a game of a
+/// console that came on discs (a browser game's platform, such as PS2).
+struct CaseStyle: Equatable {
+    var light: Color
+    var dark: Color
+    var disc: Bool
+    static let card = CaseStyle(light: caseRed, dark: caseRedDark, disc: false)
+    static let discCase = CaseStyle(light: Color(white: 0.2), dark: Color(white: 0.06), disc: true)
+    static func of(_ game: GameTile) -> CaseStyle { game.isDisc ? discCase : card }
+}
+extension EnvironmentValues { @Entry var caseStyle: CaseStyle = .card }
+
+/// The case at a point of its opening, 0 closed to 1 open flat. The tray is the right half, and the cover swings around the tray's
+/// left edge to lie on the left: its front while it turns less than a right angle, its inside after. The whole case slides so it
+/// stays in the middle, closed or open.
+private struct OpeningCase: View, Animatable {
+    let game: GameTile
+    let width: CGFloat
+    var progress: Double
+    /// False once the card has been taken out to be inserted.
+    var cardInTray = true
+    nonisolated var animatableData: Double {
+        get { progress }
+        set { progress = newValue }
+    }
+
+    var body: some View {
+        let height = width / CoverFlowView.boxRatio
+        let angle = progress * 180
+        let edgeOn = sin(angle * .pi / 180)          // 0 flat, 1 edge-on to the player
+        let inside = angle > 90
+        ZStack(alignment: .topLeading) {
+            // The floor shadow, wider as the case opens.
+            Ellipse().fill(.black.opacity(0.55))
+                .frame(width: width * (1.1 + progress), height: height * 0.07)
+                .blur(radius: width * 0.06)
+                .offset(x: width * (0.95 - progress) - width * 0.05, y: height * 1.02)
+            CaseTray(game: game, width: width, height: height, cardInTray: cardInTray)
+                .offset(x: width)
+            Group {
+                if inside {
+                    // Seen from behind once past a right angle: drawn mirrored, so it reads the right way round.
+                    CaseInside(game: game, width: width, height: height).scaleEffect(x: -1, y: 1)
+                } else {
+                    CaseFront(game: game, width: width, height: height)
+                }
+            }
+            .brightness(-0.38 * edgeOn)
+            .rotation3DEffect(.degrees(-angle), axis: (x: 0, y: 1, z: 0), anchor: .leading, perspective: 0.32)
+            .offset(x: width)
+            .zIndex(1)
+        }
+        .frame(width: width * 2, height: height, alignment: .topLeading)
+        .offset(x: -width / 2 * (1 - progress))
+    }
+}
+
+/// The closed box's front: the game's box art, a plastic rim and a soft sheen.
+private struct CaseFront: View {
+    let game: GameTile
+    let width: CGFloat
+    let height: CGFloat
+    var body: some View {
+        let shape = RoundedRectangle(cornerRadius: width * 0.035)
+        ArtView(game: game)
+            .frame(width: width, height: height)
+            .clipShape(shape)
+            .overlay(
+                LinearGradient(colors: [.white.opacity(0.22), .clear, .clear, .black.opacity(0.18)],
+                               startPoint: .topLeading, endPoint: .bottomTrailing)
+                    .clipShape(shape)
+            )
+            .overlay(shape.strokeBorder(.white.opacity(0.18), lineWidth: 1))
+            .overlay(alignment: .leading) {
+                // The spine's edge on the hinge side.
+                LinearGradient(colors: [.black.opacity(0.45), .clear], startPoint: .leading, endPoint: .trailing)
+                    .frame(width: width * 0.05)
+                    .clipShape(shape)
+            }
+            .shadow(color: .black.opacity(0.5), radius: width * 0.05, y: width * 0.02)
+    }
+}
+
+/// The plastic of an open half: a red panel with a raised rim and a recessed field.
+private struct CasePlastic<Content: View>: View {
+    let width: CGFloat
+    let height: CGFloat
+    @ViewBuilder let content: () -> Content
+    @Environment(\.caseStyle) private var style
+    var body: some View {
+        let outer = RoundedRectangle(cornerRadius: width * 0.035)
+        let inner = RoundedRectangle(cornerRadius: width * 0.025)
+        ZStack {
+            outer.fill(LinearGradient(colors: [style.light, style.dark], startPoint: .topLeading, endPoint: .bottomTrailing))
+            inner.fill(LinearGradient(colors: [style.dark.opacity(0.9), style.light.opacity(0.95)], startPoint: .top, endPoint: .bottom))
+                .padding(width * 0.045)
+                .overlay(inner.strokeBorder(.black.opacity(0.28), lineWidth: 1.5).padding(width * 0.045))
+            content()
+        }
+        .frame(width: width, height: height)
+        .overlay(outer.strokeBorder(.white.opacity(0.16), lineWidth: 1))
+        .shadow(color: .black.opacity(0.5), radius: width * 0.05, y: width * 0.02)
+    }
+}
+
+/// The inside of the cover: the instruction booklet, held by two clips.
+private struct CaseInside: View {
+    let game: GameTile
+    let width: CGFloat
+    let height: CGFloat
+    @Environment(\.caseStyle) private var style
+    var body: some View {
+        CasePlastic(width: width, height: height) {
+            let bookletWidth = width * 0.8
+            let bookletHeight = height * 0.86
+            let band = bookletHeight * 0.075
+            VStack(spacing: 0) {
+                Text(game.title.uppercased()).font(ShellFonts.fixed(max(6, band * 0.42), weight: .bold)).tracking(0.6)
+                    .lineLimit(1).minimumScaleFactor(0.5)
+                    .foregroundStyle(.white)
+                    .padding(.horizontal, band * 0.4)
+                    .frame(maxWidth: .infinity, minHeight: band, maxHeight: band, alignment: .leading)
+                    .background(style.disc ? Color(red: 0.12, green: 0.2, blue: 0.55) : caseRed)
+                ArtView(game: game, lettering: false)
+                    .frame(width: bookletWidth, height: bookletHeight - band * 2)
+                    .clipped()
+                    .overlay(LinearGradient(colors: [.clear, .black.opacity(0.25)], startPoint: .center, endPoint: .bottom))
+                HStack(spacing: 0) {
+                    Text(ShellStrings.text("Instruction booklet").uppercased())
+                        .font(ShellFonts.fixed(max(6, band * 0.38), weight: .heavy)).tracking(0.8)
+                        .lineLimit(1).minimumScaleFactor(0.5)
+                    Spacer(minLength: 4)
+                    Image(systemName: "book.closed.fill").font(.system(size: max(6, band * 0.42)))
+                }
+                .foregroundStyle(Color(white: 0.2))
+                .padding(.horizontal, band * 0.4)
+                .frame(maxWidth: .infinity, minHeight: band, maxHeight: band)
+                .background(Color(white: 0.94))
+            }
+            .frame(width: bookletWidth, height: bookletHeight)
+            .clipShape(RoundedRectangle(cornerRadius: width * 0.012))
+            .shadow(color: .black.opacity(0.45), radius: width * 0.03, x: width * 0.01, y: width * 0.015)
+            .overlay(alignment: .trailing) {
+                // The two clips on the hinge side.
+                VStack(spacing: bookletHeight * 0.45) {
+                    clip
+                    clip
+                }
+                .offset(x: width * 0.035)
+            }
+        }
+    }
+    private var clip: some View {
+        RoundedRectangle(cornerRadius: width * 0.012)
+            .fill(LinearGradient(colors: [style.light, style.dark], startPoint: .leading, endPoint: .trailing))
+            .frame(width: width * 0.07, height: height * 0.07)
+            .shadow(color: .black.opacity(0.4), radius: 2, x: -1)
+    }
+}
+
+/// The tray: the game card in its slot low in the middle, as in a Switch case, with the small arrow moulded beside it.
+struct CaseTray: View {
+    let game: GameTile
+    let width: CGFloat
+    let height: CGFloat
+    var cardInTray = true
+    /// The card's width for the tray's, its height for its width, and the tray's margin under the slot for its height. The box
+    /// view places the card it flies to the console from these.
+    static let cardShare: CGFloat = 0.3
+    static let cardRatio: CGFloat = 1.42
+    static let bottomShare: CGFloat = 0.09
+    /// A disc fills most of its tray, in the middle, as in a DVD case.
+    static func share(_ disc: Bool) -> CGFloat { disc ? 0.8 : cardShare }
+    static func ratio(_ disc: Bool) -> CGFloat { disc ? 1 : cardRatio }
+    static func bottom(_ disc: Bool, width: CGFloat, height: CGFloat) -> CGFloat {
+        disc ? max(0.04, 0.5 - 0.55 * width * 0.8 / max(height, 1)) : bottomShare
+    }
+    @Environment(\.caseStyle) private var style
+    var body: some View {
+        CasePlastic(width: width, height: height) {
+            let cardWidth = width * Self.share(style.disc)
+            let cardHeight = cardWidth * Self.ratio(style.disc)
+            VStack(spacing: 0) {
+                Spacer(minLength: 0)
+                ZStack {
+                    // The slot: a dark recess a little larger than the card, or the disc's round seat with its hub.
+                    if style.disc {
+                        Circle().fill(style.dark.opacity(0.95)).frame(width: cardWidth * 1.06, height: cardWidth * 1.06)
+                            .overlay(Circle().stroke(.black.opacity(0.35), lineWidth: 2))
+                    } else {
+                        GameCardShape(notch: cardWidth * 0.14)
+                            .fill(caseRedDark.opacity(0.95))
+                            .frame(width: cardWidth * 1.14, height: cardHeight * 1.1)
+                            .overlay(GameCardShape(notch: cardWidth * 0.14).stroke(.black.opacity(0.35), lineWidth: 2))
+                    }
+                    GameCard(game: game, width: cardWidth, height: cardHeight).opacity(cardInTray ? 1 : 0)
+                }
+                .overlay(alignment: .trailing) {
+                    // The moulded arrow beside the slot.
+                    Image(systemName: "arrowtriangle.left").font(.system(size: max(6, width * 0.05), weight: .light))
+                        .foregroundStyle(style.dark.opacity(0.9))
+                        .offset(x: width * 0.12)
+                }
+                .padding(.bottom, height * Self.bottom(style.disc, width: width, height: height))
+            }
+            .frame(width: width, height: height)
+        }
+    }
+}
+
+/// A game card: a dark body with its corner cut, the label with the box art and a white strip.
+private struct GameCard: View {
+    let game: GameTile
+    let width: CGFloat
+    let height: CGFloat
+    var body: some View {
+        if game.isDisc { GameDisc(game: game, diameter: width).frame(width: width, height: height) } else { card }
+    }
+    @ViewBuilder private var card: some View {
+        let shape = GameCardShape(notch: width * 0.14)
+        ZStack(alignment: .top) {
+            shape.fill(LinearGradient(colors: [Color(white: 0.24), Color(white: 0.12)], startPoint: .top, endPoint: .bottom))
+            VStack(spacing: 0) {
+                ArtView(game: game, lettering: false)
+                    .frame(width: width * 0.82, height: height * 0.68)
+                    .clipped()
+                Rectangle().fill(Color(white: 0.95)).frame(width: width * 0.82, height: height * 0.1)
+                    .overlay(
+                        Text(game.title).font(ShellFonts.fixed(max(5, height * 0.05), weight: .bold))
+                            .foregroundStyle(Color(white: 0.2)).lineLimit(1).minimumScaleFactor(0.4).padding(.horizontal, 3)
+                    )
+            }
+            .clipShape(RoundedRectangle(cornerRadius: width * 0.04))
+            .padding(.top, height * 0.12)
+        }
+        .frame(width: width, height: height)
+        .overlay(shape.stroke(.white.opacity(0.18), lineWidth: 1))
+        .shadow(color: .black.opacity(0.5), radius: width * 0.06, y: width * 0.03)
+    }
+}
+
+/// A game card's outline: a rounded rectangle with its top right corner cut off.
+private struct GameCardShape: Shape {
+    let notch: CGFloat
+    func path(in rect: CGRect) -> Path {
+        let r = min(rect.width, rect.height) * 0.06
+        var p = Path()
+        p.move(to: CGPoint(x: rect.minX + r, y: rect.minY))
+        p.addLine(to: CGPoint(x: rect.maxX - notch, y: rect.minY))
+        p.addLine(to: CGPoint(x: rect.maxX, y: rect.minY + notch))
+        p.addLine(to: CGPoint(x: rect.maxX, y: rect.maxY - r))
+        p.addQuadCurve(to: CGPoint(x: rect.maxX - r, y: rect.maxY), control: CGPoint(x: rect.maxX, y: rect.maxY))
+        p.addLine(to: CGPoint(x: rect.minX + r, y: rect.maxY))
+        p.addQuadCurve(to: CGPoint(x: rect.minX, y: rect.maxY - r), control: CGPoint(x: rect.minX, y: rect.maxY))
+        p.addLine(to: CGPoint(x: rect.minX, y: rect.minY + r))
+        p.addQuadCurve(to: CGPoint(x: rect.minX + r, y: rect.minY), control: CGPoint(x: rect.minX, y: rect.minY))
+        p.closeSubpath()
+        return p
+    }
+}
+
+/// A game disc: the label printed with the box art, a silver ring and the clear hub, catching the light as it turns.
+private struct GameDisc: View {
+    let game: GameTile
+    let diameter: CGFloat
+    var body: some View {
+        ZStack {
+            Circle().fill(AngularGradient(colors: [Color(white: 0.85), Color(white: 0.55), Color(red: 0.75, green: 0.8, blue: 0.95),
+                                                   Color(white: 0.6), Color(white: 0.9), Color(white: 0.55), Color(white: 0.85)],
+                                          center: .center))
+            ArtView(game: game, lettering: false)
+                .frame(width: diameter * 0.9, height: diameter * 0.9)
+                .clipShape(Circle())
+                .overlay(LinearGradient(colors: [.white.opacity(0.28), .clear, .black.opacity(0.2)], startPoint: .topLeading,
+                                        endPoint: .bottomTrailing).clipShape(Circle()))
+            Circle().fill(AngularGradient(colors: [Color(white: 0.92), Color(white: 0.6), Color(white: 0.92)], center: .center))
+                .frame(width: diameter * 0.34, height: diameter * 0.34)
+            Circle().fill(Color(white: 0.1)).frame(width: diameter * 0.12, height: diameter * 0.12)
+                .overlay(Circle().stroke(.white.opacity(0.35), lineWidth: 1))
+        }
+        .frame(width: diameter, height: diameter)
+        .overlay(Circle().stroke(.white.opacity(0.25), lineWidth: 1))
+        .shadow(color: .black.opacity(0.5), radius: diameter * 0.06, y: diameter * 0.03)
+    }
+}
