+        // An N64 game has no box to open: its cartridge goes straight into a console.
+        if game.isCart64 {
+            CartridgeConsoleView(game: game, insert: insert, showInfo: showInfo, close: close, autoInsert: autoInsert, turnRequest: turnRequest)
+        } else {
+            caseBody
+        }
+    }
