+/// A game card: a dark body with its corner cut, the label with the box art and a white strip.
+struct GameCard: View {
+    let game: GameTile
+    let width: CGFloat
+    let height: CGFloat
+    var body: some View {
+        if game.isDisc { GameDisc(game: game, diameter: width).frame(width: width, height: height) }
+        else if game.isCart64 { cart64 } else { card }
+    }
+    /// An N64 cartridge: grey plastic wider than tall, the grip ridges along its top, the label with the box art in a
+    /// recess, the bottom corners well rounded.
+    @ViewBuilder private var cart64: some View {
+        let shell = UnevenRoundedRectangle(topLeadingRadius: width * 0.04, bottomLeadingRadius: width * 0.1,
+                                           bottomTrailingRadius: width * 0.1, topTrailingRadius: width * 0.04)
+        let label = RoundedRectangle(cornerRadius: width * 0.025)
+        ZStack(alignment: .top) {
+            shell.fill(LinearGradient(colors: [Color(white: 0.66), Color(white: 0.44)], startPoint: .top, endPoint: .bottom))
+            HStack(spacing: width * 0.028) {
+                ForEach(0..<16, id: \.self) { _ in
+                    Capsule().fill(Color(white: 0.38)).frame(width: max(1, width * 0.011), height: height * 0.09)
+                }
+            }
+            .padding(.top, height * 0.035)
+            ArtView(game: game, lettering: false)
+                .frame(width: width * 0.8, height: height * 0.62)
+                .clipShape(label)
+                .overlay(label.strokeBorder(.black.opacity(0.35), lineWidth: 1.5))
+                .overlay(LinearGradient(colors: [.white.opacity(0.18), .clear], startPoint: .top, endPoint: .center).clipShape(label))
+                .padding(.top, height * 0.17)
+        }
+        .frame(width: width, height: height)
+        .overlay(shell.stroke(.white.opacity(0.25), lineWidth: 1))
+        .shadow(color: .black.opacity(0.5), radius: width * 0.05, y: width * 0.025)
+    }
+    @ViewBuilder private var card: some View {
+        let shape = GameCardShape(notch: width * 0.14)
+        ZStack(alignment: .top) {
+            shape.fill(LinearGradient(colors: [Color(white: 0.24), Color(white: 0.12)], startPoint: .top, endPoint: .bottom))
+            VStack(spacing: 0) {
+                ArtView(game: game, lettering: false)
+                    .frame(width: width * 0.82, height: height * 0.68)
+                    .clipped()
+                Rectangle().fill(Color(white: 0.95)).frame(width: width * 0.82, height: height * 0.1)
+                    .overlay(
+                        Text(game.title).font(ShellFonts.fixed(max(5, height * 0.05), weight: .bold))
+                            .foregroundStyle(Color(white: 0.2)).lineLimit(1).minimumScaleFactor(0.4).padding(.horizontal, 3)
+                    )
+            }
+            .clipShape(RoundedRectangle(cornerRadius: width * 0.04))
+            .padding(.top, height * 0.12)
+        }
+        .frame(width: width, height: height)
+        .overlay(shape.stroke(.white.opacity(0.18), lineWidth: 1))
+        .shadow(color: .black.opacity(0.5), radius: width * 0.06, y: width * 0.03)
+    }
+}
+
+/// A game card's outline: a rounded rectangle with its top right corner cut off.
+private struct GameCardShape: Shape {
+    let notch: CGFloat
+    func path(in rect: CGRect) -> Path {
+        let r = min(rect.width, rect.height) * 0.06
+        var p = Path()
+        p.move(to: CGPoint(x: rect.minX + r, y: rect.minY))
+        p.addLine(to: CGPoint(x: rect.maxX - notch, y: rect.minY))
+        p.addLine(to: CGPoint(x: rect.maxX, y: rect.minY + notch))
+        p.addLine(to: CGPoint(x: rect.maxX, y: rect.maxY - r))
+        p.addQuadCurve(to: CGPoint(x: rect.maxX - r, y: rect.maxY), control: CGPoint(x: rect.maxX, y: rect.maxY))
+        p.addLine(to: CGPoint(x: rect.minX + r, y: rect.maxY))
+        p.addQuadCurve(to: CGPoint(x: rect.minX, y: rect.maxY - r), control: CGPoint(x: rect.minX, y: rect.maxY))
+        p.addLine(to: CGPoint(x: rect.minX, y: rect.minY + r))
+        p.addQuadCurve(to: CGPoint(x: rect.minX + r, y: rect.minY), control: CGPoint(x: rect.minX, y: rect.minY))
+        p.closeSubpath()
+        return p
+    }
+}
+
+/// A game disc: the label printed with the box art, a silver ring and the clear hub, catching the light as it turns.
+private struct GameDisc: View {
+    let game: GameTile
+    let diameter: CGFloat
+    var body: some View {
+        ZStack {
+            Circle().fill(AngularGradient(colors: [Color(white: 0.85), Color(white: 0.55), Color(red: 0.75, green: 0.8, blue: 0.95),
+                                                   Color(white: 0.6), Color(white: 0.9), Color(white: 0.55), Color(white: 0.85)],
+                                          center: .center))
+            ArtView(game: game, lettering: false)
+                .frame(width: diameter * 0.9, height: diameter * 0.9)
+                .clipShape(Circle())
+                .overlay(LinearGradient(colors: [.white.opacity(0.28), .clear, .black.opacity(0.2)], startPoint: .topLeading,
+                                        endPoint: .bottomTrailing).clipShape(Circle()))
+            Circle().fill(AngularGradient(colors: [Color(white: 0.92), Color(white: 0.6), Color(white: 0.92)], center: .center))
+                .frame(width: diameter * 0.34, height: diameter * 0.34)
+            Circle().fill(Color(white: 0.1)).frame(width: diameter * 0.12, height: diameter * 0.12)
+                .overlay(Circle().stroke(.white.opacity(0.35), lineWidth: 1))
+        }
+        .frame(width: diameter, height: diameter)
+        .overlay(Circle().stroke(.white.opacity(0.25), lineWidth: 1))
+        .shadow(color: .black.opacity(0.5), radius: diameter * 0.06, y: diameter * 0.03)
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/GameInfoPanel.swift b/frontend-ios/Sources/ShellUI/GameInfoPanel.swift
