diff --git a/frontend-ios/UITests/LibraryBoxCaptureTests.swift b/frontend-ios/UITests/LibraryBoxCaptureTests.swift
new file mode 100644
index 0000000..73b9454
--- /dev/null
+++ b/frontend-ios/UITests/LibraryBoxCaptureTests.swift
@@ -0,0 +1,169 @@
+import XCTest
+
+/// The box opened from the cover and the game card going into the console, by touch and by controller, and the info panel,
+/// captured for review. With TEST_RUNNER_SHOT_DIR set, each capture is also written there as a PNG.
+@MainActor final class LibraryBoxCaptureTests: XCTestCase {
+    private let app = XCUIApplication()
+    private var directory: String? { ProcessInfo.processInfo.environment["SHOT_DIR"] }
+    private var prefix: String { ProcessInfo.processInfo.environment["SHOT_PREFIX"] ?? (UIDevice.current.userInterfaceIdiom == .pad ? "ipad" : "phone") }
+
+    override func setUp() {
+        continueAfterFailure = false
+        XCUIDevice.shared.orientation = .landscapeLeft
+    }
+
+    private func shot(_ name: String) {
+        let screenshot = XCUIScreen.main.screenshot()
+        let attachment = XCTAttachment(screenshot: screenshot)
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        add(attachment)
+        if let directory {
+            try? screenshot.pngRepresentation.write(to: URL(fileURLWithPath: directory).appendingPathComponent("\(prefix)-\(name).png"))
+        }
+    }
+    private func launch(_ arguments: [String]) {
+        app.terminate()
+        app.launchArguments = arguments
+        app.launch()
+        XCTAssertTrue(app.buttons["controllers.open"].firstMatch.waitForExistence(timeout: 15))
+        sleep(2)
+    }
+    /// The demo answers Play with an alert: the game would start here.
+    private func expectPlay(_ name: String) {
+        let alert = app.alerts.firstMatch
+        XCTAssertTrue(alert.waitForExistence(timeout: 8), "Play was not requested")
+        shot(name)
+        alert.buttons.firstMatch.tap()
+        sleep(1)
+    }
+
+    /// Touch: a tap on the middle cover opens its box (captured while it opens); the round button closes and opens it; Game
+    /// info shows the panel and Open the box comes back; a tap on the card flies it into the console (captured) and plays.
+    func testTouch() {
+        // The particles only where the review looks at them (the tablet's touch run); every other run is still, so the app goes idle between taps.
+        launch(["--screen", "library"] + (UIDevice.current.userInterfaceIdiom == .pad ? [] : ["--still"]))
+        shot("touch-01-library")
+        app.windows.firstMatch.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.42)).tap()
+        XCTAssertTrue(app.buttons["box.toggle"].waitForExistence(timeout: 5))
+        for index in 1...4 {
+            usleep(250_000)
+            shot("touch-02-box-opening-\(index)")
+        }
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("touch-03-box-open")
+        app.buttons["box.toggle"].tap()
+        sleep(2)
+        shot("touch-04-box-closed-again")
+        app.buttons["box.toggle"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 5))
+        app.buttons["box.info"].tap()
+        XCTAssertTrue(app.buttons["info.play"].waitForExistence(timeout: 5))
+        XCTAssertFalse(app.buttons["box.toggle"].exists)
+        sleep(1)
+        shot("touch-05-info-panel")
+        // What the game is about: the synopsis and the screenshots, one opened full screen and the next one swiped to.
+        let first = app.buttons["info.shot.0"]
+        XCTAssertTrue(first.waitForExistence(timeout: 5))
+        if !first.isHittable { app.buttons["info.play"].swipeUp() }
+        sleep(1)
+        shot("touch-05b-info-about")
+        first.tap()
+        XCTAssertTrue(app.buttons["shot.close"].waitForExistence(timeout: 5))
+        sleep(1)
+        shot("touch-05c-screenshot")
+        app.windows.firstMatch.swipeLeft()
+        sleep(1)
+        shot("touch-05d-screenshot-swiped")
+        app.buttons["shot.close"].tap()
+        XCTAssertTrue(app.buttons["info.box"].waitForExistence(timeout: 5))
+        if !app.buttons["info.box"].isHittable { app.buttons["info.shot.0"].swipeDown() }
+        app.buttons["info.box"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["box.cart"].tap()
+        // Lift, flight and click (about 0.8 s), then the slot flares and the screen fades to black (0.9 s).
+        for index in 1...8 {
+            usleep(180_000)
+            shot("touch-06-card-inserting-\(index)")
+        }
+        expectPlay("touch-07-played")
+    }
+
+    /// Controller (the demo's on-screen stand-ins for its buttons): right moves to the next game, A opens its box, A on the
+    /// card (the focus once the box is open) plays; B closes the box and goes back.
+    func testController() {
+        launch(["--screen", "library", "--input-test", "--still"])
+        app.buttons["qa.input.right"].tap()
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        shot("pad-01-box-open-card-focused")
+        app.buttons["qa.input.back"].tap()
+        sleep(1)
+        XCTAssertFalse(app.buttons["box.toggle"].exists)
+        shot("pad-02-library")
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        expectPlay("pad-03-played")
+    }
+
+    /// A game with no statistics yet and one that cannot start (its cover opens the info panel), and a box opened from the
+    /// launch arguments.
+    func testOtherGames() {
+        launch(["--screen", "info", "--select", "drift", "--still"])
+        shot("other-01-info-no-stats")
+        launch(["--screen", "info", "--select", "paper", "--still"])
+        shot("other-02-info-needs-data")
+        launch(["--screen", "box", "--select", "tide", "--still"])
+        sleep(2)
+        shot("other-03-box-tide")
+    }
+
+    /// The platform selector at the top in the middle (a browser game under PS2), its box with a disc, the disc going in and the
+    /// game's page full screen; then the controller: R to the next platform, A twice to play, Menu and View to come back.
+    func testPlatforms() {
+        launch(["--screen", "library", "--still", "--web", "--input-test"])
+        XCTAssertTrue(app.buttons["platform.PS2"].waitForExistence(timeout: 5))
+        shot("web-01-library-switch")
+        app.buttons["platform.PS2"].tap()
+        sleep(2)
+        shot("web-02-library-ps2")
+        // A tap on the only PS2 game opens its box (it did nothing on the iPhone: the shelf waited for the carousel to settle)
+        app.buttons["tile.street"].firstMatch.tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        shot("web-03-box-disc")
+        app.buttons["box.cart"].tap()
+        for index in 1...4 {
+            usleep(300_000)
+            shot("web-04-disc-inserting-\(index)")
+        }
+        XCTAssertTrue(app.buttons["web.close"].waitForExistence(timeout: 10))
+        sleep(4)
+        shot("web-05-page")
+        app.buttons["web.close"].tap()
+        sleep(2)
+        shot("web-06-back")
+        // Controller: back to Switch with R (two platforms: R wraps), then to PS2 again, play, and out with Menu and View.
+        app.buttons["qa.input.next"].tap()
+        sleep(1)
+        shot("web-07-pad-switch")
+        app.buttons["qa.input.next"].tap()
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["box.cart"].waitForExistence(timeout: 6))
+        sleep(1)
+        app.buttons["qa.input.activate"].tap()
+        XCTAssertTrue(app.buttons["web.close"].waitForExistence(timeout: 10))
+        sleep(2)
+        app.buttons["qa.input.exit"].tap()
+        sleep(2)
+        XCTAssertFalse(app.buttons["web.close"].exists)
+        shot("web-08-pad-exit")
+    }
+}
