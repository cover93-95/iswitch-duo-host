+}
+
+/// A screenshot full screen, over everything: swipe, the arrows or left and right on a controller go through them; B, Close or a
+/// tap on the black closes it.
+struct ScreenshotViewer: View {
+    let title: String
+    let screens: [URL]
+    @Binding var index: Int
+    let close: () -> Void
+
+    var body: some View {
+        ZStack {
+            Color.black.ignoresSafeArea()
+                .onTapGesture(perform: close)
+                .accessibilityHidden(true)
+            TabView(selection: $index) {
+                ForEach(Array(screens.enumerated()), id: \.offset) { i, url in
+                    ScreenshotImage(url: url, maxPixels: 1920, fill: false)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        .accessibilityElement()
+                        .accessibilityLabel(ShellStrings.text("Screenshot") + " \(i + 1)/\(screens.count)")
+                        .tag(i)
+                }
+            }
+            #if os(iOS)
+            .tabViewStyle(.page(indexDisplayMode: .never))
+            #endif
+            .ignoresSafeArea()
+            VStack {
+                HStack(alignment: .center) {
+                    VStack(alignment: .leading, spacing: 3) {
+                        Text(title).shellType(ShellType.cardTitle).lineLimit(1)
+                        Text(verbatim: "\(index + 1) / \(screens.count)").shellType(ShellType.note).monospacedDigit()
+                            .foregroundStyle(.white.opacity(0.6))
+                    }
+                    Spacer(minLength: 12)
+                    Button(action: close) { Label(ShellStrings.text("Close"), systemImage: "xmark") }
+                        .buttonStyle(ChipButtonStyle())
+                        .accessibilityIdentifier("shot.close")
+                        .shellTarget("shot.close", radius: 22, action: close)
+                }
+                Spacer(minLength: 0)
+                HStack(spacing: 14) {
+                    Button(action: previous) { Image(systemName: "chevron.left").frame(minWidth: 18) }
+                        .buttonStyle(ChipButtonStyle())
+                        .disabled(index == 0)
+                        .accessibilityLabel(ShellStrings.text("Previous"))
+                        .accessibilityIdentifier("shot.prev")
+                    HStack(spacing: 7) {
+                        ForEach(screens.indices, id: \.self) { i in
+                            Circle().fill(.white.opacity(i == index ? 0.95 : 0.3)).frame(width: 7, height: 7)
+                        }
+                    }
+                    .accessibilityHidden(true)
+                    Button(action: next) { Image(systemName: "chevron.right").frame(minWidth: 18) }
+                        .buttonStyle(ChipButtonStyle())
+                        .disabled(index >= screens.count - 1)
+                        .accessibilityLabel(ShellStrings.text("Next"))
+                        .accessibilityIdentifier("shot.next")
+                    GlyphHint(role: .back, label: ShellStrings.text("Back"))
+                }
+            }
+            .padding(.horizontal, 24).padding(.vertical, 12)
+            .foregroundStyle(.white)
+        }
+        .animation(.easeInOut(duration: 0.25), value: index)
+    }
+
+    private func previous() { if index > 0 { index -= 1 } }
+    private func next() { if index < screens.count - 1 { index += 1 } }
+}
diff --git a/frontend-ios/Sources/ShellUI/InsertSound.swift b/frontend-ios/Sources/ShellUI/InsertSound.swift
new file mode 100644
index 0000000..01d2303
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/InsertSound.swift
@@ -0,0 +1,61 @@
+import AVFoundation
+import Foundation
+
+/// The click of a game card going into the console: a short scrape, then the latch. Made here as samples (no sound file), so the
+/// app carries no recording. Played through the default session, so the ring/silent switch mutes it like any app sound.
+@MainActor enum InsertSound {
+    private static var player: AVAudioPlayer?
+
+    /// Ready to play at once, so the click lands with the animation.
+    static func prepare() {
+        guard player == nil else { return }
+        player = try? AVAudioPlayer(data: wav(samples(rate: 44_100)))
+        player?.volume = 0.9
+        player?.prepareToPlay()
+    }
+
+    static func play() {
+        prepare()
+        player?.currentTime = 0
+        player?.play()
+    }
+
+    /// The sound, -1...1 at `rate`: 50 ms of soft scrape rising, a sharp click, and a duller latch 20 ms later.
+    static func samples(rate: Int) -> [Float] {
+        let count = Int(Double(rate) * 0.16)
+        var out = [Float](repeating: 0, count: count)
+        var seed: UInt32 = 0x9E37_79B9
+        func noise() -> Float {
+            seed = seed &* 1_664_525 &+ 1_013_904_223
+            return Float(Int32(bitPattern: seed)) / Float(Int32.max)
+        }
+        for i in 0..<count {
+            let t = Double(i) / Double(rate)
+            var v: Float = 0
+            if t < 0.05 { v += noise() * Float(0.04 + t * 1.2) * 0.5 }                    // the scrape, rising
+            if t >= 0.052 {                                                                // the click
+                let u = t - 0.052
+                v += Float(exp(-u / 0.0016)) * (0.75 * Float(sin(2 * .pi * 3_100 * u)) + 0.35 * noise())
+            }
+            if t >= 0.074 {                                                                // the latch
+                let u = t - 0.074
+                v += Float(exp(-u / 0.004)) * 0.45 * Float(sin(2 * .pi * 1_500 * u))
+            }
+            out[i] = max(-1, min(1, v))
+        }
+        return out
+    }
+
+    /// 16-bit mono PCM in a WAV container.
+    static func wav(_ samples: [Float], rate: Int = 44_100) -> Data {
+        var data = Data()
+        func put32(_ v: UInt32) { withUnsafeBytes(of: v.littleEndian) { data.append(contentsOf: $0) } }
+        func put16(_ v: UInt16) { withUnsafeBytes(of: v.littleEndian) { data.append(contentsOf: $0) } }
+        let bytes = UInt32(samples.count * 2)
+        data.append(contentsOf: Array("RIFF".utf8)); put32(36 + bytes); data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8)); put32(16); put16(1); put16(1); put32(UInt32(rate)); put32(UInt32(rate * 2)); put16(2); put16(16)
+        data.append(contentsOf: Array("data".utf8)); put32(bytes)
+        for s in samples { put16(UInt16(bitPattern: Int16(s * Float(Int16.max)))) }
+        return data
+    }
+}
