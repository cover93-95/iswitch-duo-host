diff --git a/frontend-ios/Sources/ShellUI/WebGameView.swift b/frontend-ios/Sources/ShellUI/WebGameView.swift
new file mode 100644
index 0000000..a9a8d00
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/WebGameView.swift
@@ -0,0 +1,188 @@
+import SwiftUI
+import WebKit
+
+/// A game played in the browser, full screen inside the app: no address bar, the controller going straight to the page
+/// (WebKit hands it the Gamepad API), and the page's own storage kept in the app's website data, so its saves stay from one
+/// session to the next. Third-party scripts and frames (the advertising networks such pages carry) and pop-ups are blocked,
+/// and the page cannot lead the main frame to another site. Out with Menu and View held together, or the close button.
+struct WebGameView: View {
+    let game: GameTile
+    let close: () -> Void
+    @State private var loading = true
+    /// Why the page did not load (no network, the site down), shown in place of a black screen.
+    @State private var failure: String?
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            Color.black.ignoresSafeArea()
+            if let url = game.webURL {
+                WebGameSurface(url: url, start: game.webStart, focus: game.webFocus, loading: $loading, failure: $failure)
+                    .ignoresSafeArea()
+                    .accessibilityLabel(game.title)
+            }
+            if let failure {
+                VStack(spacing: 10) {
+                    Image(systemName: "wifi.exclamationmark").font(.system(size: 28)).foregroundStyle(.white.opacity(0.8))
+                    Text(ShellStrings.text("The game's page did not load.")).shellText(16, .semibold, relativeTo: .headline).foregroundStyle(.white)
+                    Text(failure).shellText(12, .regular, relativeTo: .caption).foregroundStyle(.white.opacity(0.6)).multilineTextAlignment(.center)
+                }
+                .padding(32).frame(maxWidth: .infinity, maxHeight: .infinity).allowsHitTesting(false)
+            }
+            if loading {
+                VStack(spacing: 14) {
+                    ProgressView().controlSize(.large).tint(.white)
+                    Text(game.title).shellText(17, .semibold, relativeTo: .headline).foregroundStyle(.white)
+                }
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                .allowsHitTesting(false)
+                .transition(.opacity)
+            }
+            Button(action: close) {
+                Image(systemName: "xmark").font(.system(size: 13, weight: .bold)).frame(width: 30, height: 30)
+            }
+            .buttonStyle(.plain)
+            .foregroundStyle(.white)
+            .background(.black.opacity(0.45), in: Circle())
+            .overlay(Circle().strokeBorder(.white.opacity(0.2)))
+            .opacity(0.55)
+            .padding(.leading, 10).padding(.top, 8)
+            .accessibilityLabel(ShellStrings.text("Close"))
+            .accessibilityIdentifier("web.close")
+        }
+        .animation(.easeOut(duration: 0.3), value: loading)
+        #if os(iOS)
+        .statusBarHidden()
+        .persistentSystemOverlays(.hidden)
+        #endif
+    }
+}
+
+/// The rules every page runs under: no script or frame from another site, and no pop-up.
+enum WebGameRules {
+    static let identifier = "shell.web-game.rules"
+    static let json = """
+    [{"trigger":{"url-filter":".*","load-type":["third-party"],"resource-type":["script","popup"]},"action":{"type":"block"}},
+     {"trigger":{"url-filter":".*","load-type":["third-party"],"resource-type":["document"]},"action":{"type":"block"}}]
+    """
+}
+
+/// The web view, configured once per game session. The rules are compiled before the page loads, so not one advertising
+/// script runs first.
+@MainActor
+final class WebGameCoordinator: NSObject, WKNavigationDelegate, WKUIDelegate {
+    let home: URL
+    let start: [String]
+    let focus: String?
+    var loading: Binding<Bool>
+    var failure: Binding<String?>
+    init(home: URL, start: [String] = [], focus: String? = nil, loading: Binding<Bool>, failure: Binding<String?>) {
+        self.home = home; self.start = start; self.focus = focus; self.loading = loading; self.failure = failure
+    }
+    /// The page started for the player: its buttons pressed in order as each appears (Play, then Full screen), and the element
+    /// to fill the screen styled over everything. Runs in the main frame once the document is parsed, and gives up after a minute.
+    var startScript: WKUserScript? {
+        guard !start.isEmpty || focus != nil,
+              let steps = try? JSONSerialization.data(withJSONObject: start), let stepsJSON = String(data: steps, encoding: .utf8),
+              let focusData = try? JSONSerialization.data(withJSONObject: [focus ?? ""]), let focusJSON = String(data: focusData, encoding: .utf8)
+        else { return nil }
+        let source = """
+        (function(){
+          var steps = \(stepsJSON), focus = \(focusJSON)[0];
+          if (focus) {
+            var s = document.createElement('style');
+            s.textContent = focus + '{position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;max-width:none!important;max-height:none!important;aspect-ratio:auto!important;margin:0!important;border:0!important;border-radius:0!important;z-index:2147483646!important;background:#000!important}html,body{overflow:hidden!important;background:#000!important}';
+            (document.head || document.documentElement).appendChild(s);
+          }
+          var i = 0, tries = 0;
+          var t = setInterval(function(){
+            if (i >= steps.length || ++tries > 120) { clearInterval(t); return; }
+            if (tries < 4) return;   // the page's own scripts attach their handlers first
+            var el = document.querySelector(steps[i]);
+            if (el && !el.disabled && el.getClientRects().length > 0) { el.click(); i++; tries = 2; }   // a pause before the next one
+          }, 500);
+        })();
+        """
+        return WKUserScript(source: source, injectionTime: .atDocumentEnd, forMainFrameOnly: true)
+    }
+
+    func load(into web: WKWebView) {
+        let request = URLRequest(url: home)
+        Task { @MainActor in
+            let list = try? await WKContentRuleListStore.default().compileContentRuleList(forIdentifier: WebGameRules.identifier,
+                                                                                         encodedContentRuleList: WebGameRules.json)
+            if let list { web.configuration.userContentController.add(list) }
+            web.load(request)
+        }
+    }
+    /// The main frame stays on the game's site: an advertising redirect to another one is refused.
+    func webView(_ webView: WKWebView, decidePolicyFor action: WKNavigationAction,
+                 decisionHandler: @escaping @MainActor @Sendable (WKNavigationActionPolicy) -> Void) {
+        let main = action.targetFrame?.isMainFrame ?? true
+        if main, let host = action.request.url?.host, let own = home.host, !Self.sameSite(host, own) { decisionHandler(.cancel); return }
+        decisionHandler(.allow)
+    }
+    static func sameSite(_ a: String, _ b: String) -> Bool {
+        func site(_ h: String) -> String { h.split(separator: ".").suffix(2).joined(separator: ".") }
+        return site(a.lowercased()) == site(b.lowercased())
+    }
+    /// A pop-up (window.open, a link to a new window) opens nothing.
+    func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration, for action: WKNavigationAction,
+                 windowFeatures: WKWindowFeatures) -> WKWebView? { nil }
+    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) { loading.wrappedValue = false; failure.wrappedValue = nil }
+    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) { fail(error) }
+    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) { fail(error) }
+    private func fail(_ error: Error) {
+        loading.wrappedValue = false
+        if (error as NSError).code == NSURLErrorCancelled { return }   // a redirect this coordinator refused, or a new load
+        failure.wrappedValue = error.localizedDescription
+    }
+
+    static func makeWebView(coordinator: WebGameCoordinator) -> WKWebView {
+        let config = WKWebViewConfiguration()
+        config.websiteDataStore = .default()   // the page's saves (IndexedDB, local storage) stay between sessions
+        #if os(iOS)
+        config.allowsInlineMediaPlayback = true
+        #endif
+        config.mediaTypesRequiringUserActionForPlayback = []
+        config.preferences.javaScriptCanOpenWindowsAutomatically = false
+        if let script = coordinator.startScript { config.userContentController.addUserScript(script) }
+        let web = WKWebView(frame: .zero, configuration: config)
+        web.navigationDelegate = coordinator
+        web.uiDelegate = coordinator
+        web.allowsBackForwardNavigationGestures = false
+        #if os(iOS)
+        web.isOpaque = false
+        web.backgroundColor = .black
+        web.scrollView.isScrollEnabled = false
+        web.scrollView.contentInsetAdjustmentBehavior = .never
+        web.scrollView.bounces = false
+        #endif
+        coordinator.load(into: web)
+        return web
+    }
+}
+
+#if os(iOS)
+struct WebGameSurface: UIViewRepresentable {
+    let url: URL
+    var start: [String] = []
+    var focus: String?
+    @Binding var loading: Bool
+    @Binding var failure: String?
+    func makeCoordinator() -> WebGameCoordinator { WebGameCoordinator(home: url, start: start, focus: focus, loading: $loading, failure: $failure) }
+    func makeUIView(context: Context) -> WKWebView { WebGameCoordinator.makeWebView(coordinator: context.coordinator) }
+    func updateUIView(_ view: WKWebView, context: Context) {}
+    static func dismantleUIView(_ view: WKWebView, coordinator: WebGameCoordinator) { view.stopLoading(); view.loadHTMLString("", baseURL: nil) }
+}
+#else
+struct WebGameSurface: NSViewRepresentable {
+    let url: URL
+    var start: [String] = []
+    var focus: String?
+    @Binding var loading: Bool
+    @Binding var failure: String?
+    func makeCoordinator() -> WebGameCoordinator { WebGameCoordinator(home: url, start: start, focus: focus, loading: $loading, failure: $failure) }
+    func makeNSView(context: Context) -> WKWebView { WebGameCoordinator.makeWebView(coordinator: context.coordinator) }
+    func updateNSView(_ view: WKWebView, context: Context) {}
+}
+#endif
