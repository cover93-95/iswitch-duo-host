new file mode 100644
index 0000000..055f5bd
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/GameScreens.swift
@@ -0,0 +1,159 @@
+import SwiftUI
+
+/// Decodes a game's screenshots off the main thread, at the size they are drawn, and keeps the recent ones. The tile only lists
+/// the files (see `GameTile.screens`): nothing is decoded until the info panel shows it.
+@MainActor
+final class ScreenshotCache {
+    static let shared = ScreenshotCache()
+    private final class Box { let art: Artwork; init(_ art: Artwork) { self.art = art } }
+    private let cache: NSCache<NSString, Box> = {
+        let cache = NSCache<NSString, Box>()
+        cache.countLimit = 24
+        return cache
+    }()
+
+    func cached(_ url: URL, maxPixels: Int) -> Artwork? { cache.object(forKey: Self.key(url, maxPixels))?.art }
+
+    func load(_ url: URL, maxPixels: Int) async -> Artwork? {
+        if let art = cached(url, maxPixels: maxPixels) { return art }
+        let art = await Task.detached(priority: .userInitiated) { Artwork(id: url.path, url: url, maxPixels: maxPixels) }.value
+        if let art { cache.setObject(Box(art), forKey: Self.key(url, maxPixels)) }
+        return art
+    }
+
+    private static func key(_ url: URL, _ maxPixels: Int) -> NSString { "\(maxPixels)|\(url.path)" as NSString }
+}
+
+/// One screenshot, filling its frame (`fill`) or whole inside it, a dark plate while it decodes.
+struct ScreenshotImage: View {
+    let url: URL
+    let maxPixels: Int
+    var fill = true
+    @State private var art: Artwork?
+
+    var body: some View {
+        ZStack {
+            if let art {
+                Image(decorative: art.image, scale: 1).resizable().interpolation(.high)
+                    .aspectRatio(contentMode: fill ? .fill : .fit)
+                    .transition(.opacity)
+            } else {
+                Color.white.opacity(0.05)
+            }
+        }
+        .task(id: url) {
+            if let ready = ScreenshotCache.shared.cached(url, maxPixels: maxPixels) { art = ready; return }
+            let loaded = await ScreenshotCache.shared.load(url, maxPixels: maxPixels)
+            withAnimation(.easeOut(duration: 0.2)) { art = loaded }
+        }
+    }
+}
+
+/// The row of screenshots in the info panel: a tap, or A on the focused one, opens it full screen. It scrolls sideways to keep
+/// the focused one in view.
+struct ScreenshotStrip: View {
+    let screens: [URL]
+    let open: (Int) -> Void
+    @Environment(\.shellFocus) private var focus
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    var body: some View {
+        ScrollViewReader { proxy in
+            ScrollView(.horizontal) {
+                HStack(spacing: 10) {
+                    ForEach(Array(screens.enumerated()), id: \.offset) { index, url in
+                        let id = "info.shot.\(index)"
+                        Button { open(index) } label: {
+                            ScreenshotImage(url: url, maxPixels: 480)
+                                .frame(width: 176, height: 99)
+                                .clipShape(RoundedRectangle(cornerRadius: 8))
+                                .overlay(RoundedRectangle(cornerRadius: 8).strokeBorder(.white.opacity(0.12)))
+                                .contentShape(RoundedRectangle(cornerRadius: 8))
+                        }
+                        .buttonStyle(.plain)
+                        .accessibilityLabel(ShellStrings.text("Screenshot") + " \(index + 1)/\(screens.count)")
+                        .accessibilityIdentifier(id)
+                        .shellTarget(id, radius: 8) { open(index) }
+                        .id(id)
+                    }
+                }
+                .padding(.vertical, 4).padding(.horizontal, 2)
+            }
+            .scrollIndicators(.hidden)
+            .onChange(of: focus.id) { _, id in
+                guard let id, id.hasPrefix("info.shot.") else { return }
+                withAnimation(reduceMotion ? nil : .easeOut(duration: 0.18)) { proxy.scrollTo(id, anchor: .center) }
+            }
+        }
+    }
+}
+
+/// A screenshot full screen, over everything: swipe, the arrows or left and right on a controller go through them; B, Close or a
+/// tap on the black closes it.
+struct ScreenshotViewer: View {
+    let title: String
+    let screens: [URL]
+    @Binding var index: Int
+    let close: () -> Void
+
+    var body: some View {
+        ZStack {
+            Color.black.ignoresSafeArea()
+                .onTapGesture(perform: close)
+                .accessibilityHidden(true)
+            TabView(selection: $index) {
+                ForEach(Array(screens.enumerated()), id: \.offset) { i, url in
+                    ScreenshotImage(url: url, maxPixels: 1920, fill: false)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        .accessibilityElement()
+                        .accessibilityLabel(ShellStrings.text("Screenshot") + " \(i + 1)/\(screens.count)")
+                        .tag(i)
+                }
+            }
+            #if os(iOS)
+            .tabViewStyle(.page(indexDisplayMode: .never))
+            #endif
+            .ignoresSafeArea()
+            VStack {
+                HStack(alignment: .center) {
+                    VStack(alignment: .leading, spacing: 3) {
+                        Text(title).shellType(ShellType.cardTitle).lineLimit(1)
+                        Text(verbatim: "\(index + 1) / \(screens.count)").shellType(ShellType.note).monospacedDigit()
+                            .foregroundStyle(.white.opacity(0.6))
+                    }
+                    Spacer(minLength: 12)
+                    Button(action: close) { Label(ShellStrings.text("Close"), systemImage: "xmark") }
+                        .buttonStyle(ChipButtonStyle())
+                        .accessibilityIdentifier("shot.close")
+                        .shellTarget("shot.close", radius: 22, action: close)
+                }
+                Spacer(minLength: 0)
+                HStack(spacing: 14) {
