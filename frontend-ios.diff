+                            // The slot sits under this corner: the close button steps left of it.
+                            .padding(.trailing, playable ? card.width * scale * 1.3 + 16 : 0)
+                    }
+                    Spacer(minLength: 0)
+                    HStack(spacing: 20) {
+                        if isOpen && playable {
+                            GlyphHint(role: .activate, label: insertLabel)
+                        }
+                        if !isOpen { GlyphHint(role: .turn, label: ShellStrings.text("Turn the box")) }
+                        Button(action: toggle) {
+                            Label(isOpen ? ShellStrings.text("Close the box") : ShellStrings.text("Open the box"),
+                                  systemImage: isOpen ? "arrow.uturn.backward" : "book.pages")
+                        }
+                        .buttonStyle(ChipButtonStyle())
+                        .accessibilityIdentifier("box.toggle")
+                        .shellTarget("box.toggle", radius: 22, action: toggle)
+                        Button(action: showInfo) { Label(ShellStrings.text("Game info"), systemImage: "info.circle") }
+                            .buttonStyle(ChipButtonStyle())
+                            .accessibilityIdentifier("box.info")
+                            .shellTarget("box.info", radius: 22, action: showInfo)
+                        GlyphHint(role: .back, label: ShellStrings.text("Back"))
+                    }
+                }
+                .padding(.horizontal, 24).padding(.vertical, 12)
+                .allowsHitTesting(phase == .idle)
+                if blackout {
+                    LaunchCurtain(game: game)
+                        .transition(.opacity)
+                        .accessibilityHidden(true)
+                }
+            }
+            .frame(width: size.width, height: size.height)
+        }
+        .sensoryFeedback(.impact(weight: .heavy, intensity: 1), trigger: clicks)
+        .onAppear(perform: present)
+        .task { backCover = await BackCovers.load(game.back) }
+        .onChange(of: turnRequest) { _, _ in turnOver() }
+        .environment(\.caseStyle, .of(game))   // a disc and its black case for a disc platform
+    }
+
+    /// What the card is called where the player puts it in: a disc, an N64 cartridge, a Switch game card.
+    private var insertLabel: String {
+        ShellStrings.text(game.isDisc ? "Insert the disc" : game.isCart64 ? "Insert the cartridge" : "Insert the game card")
+    }
+
+    private var statsLine: String {
+        ShellFormat.metaLine(ShellStrings.text("Played") + " " + ShellFormat.playTime(game.stats.seconds),
+                             ShellFormat.lastPlayed(game.stats.lastPlayed),
+                             ShellStrings.text("Launches") + " \(game.stats.launches)")
+    }
+
+    private func present() {
+        if playable { InsertSound.prepare(disc: game.isDisc, cart64: game.isCart64) }
+        // The box comes forward closed: the player turns it to read its back, or taps it to open it. Play from the info panel
+        // opens it and puts the card in by itself.
+        if reduceMotion { shown = true; if autoInsert { isOpen = true; play() }; return }
+        withAnimation(.spring(duration: 0.6, bounce: 0.18)) { shown = true }
+        guard autoInsert else { return }
+        withAnimation(.easeInOut(duration: 1.05).delay(0.5)) { isOpen = true } completion: {
+            // A short look at the open box, then the card goes in.
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.25) { play() }
+        }
+    }
+    /// View: the closed box turns over in one go, always the same way round.
+    private func turnOver() {
+        guard !isOpen, phase == .idle else { return }
+        NavSound.tick()
+        withAnimation(reduceMotion ? nil : .spring(duration: 0.6, bounce: 0.12)) { turn = BoxTurn.next(from: turn) }
+    }
+    /// The game, from the black screen. A game that does not start leaves the box here: after a moment the screen comes back and
+    /// the card is in the tray again, for another try or to leave.
+    private func start() {
+        MenuMusic.stop(fade: 0.5)
+        insert()
+        DispatchQueue.main.asyncAfter(deadline: .now() + 4) {
+            withAnimation(.easeOut(duration: 0.4)) { blackout = false; phase = .idle }
+        }
+    }
+    /// The loading screen stays a moment, its title read, before the game is asked to start.
+    private func hold() {
+        DispatchQueue.main.asyncAfter(deadline: .now() + Self.curtainHold) { start() }
+    }
+    static let curtainHold: TimeInterval = 0.7
+    private func toggle() {
+        guard phase == .idle else { return }
+        // Opened from its back, it comes round to its front as it opens.
+        let front = (turn / 360).rounded() * 360
+        withAnimation(reduceMotion ? nil : .easeInOut(duration: 0.9)) { turn = front; isOpen.toggle() } completion: {
+            if isOpen { opened() }
+        }
+    }
+    /// The card into the console, then the game. A game that cannot start takes its way out at once.
+    private func play() {
+        guard phase == .idle else { return }
+        guard playable else { insert(); return }
+        // The music steps back so the card's click or the disc is heard.
+        MenuMusic.duck(to: MenuMusic.insertLevel, over: 0.25)
+        if reduceMotion {
+            InsertSound.play(disc: game.isDisc, cart64: game.isCart64); clicks += 1
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { MenuMusic.stop(fade: 0.3); insert() }
+            return
+        }
+        if game.isDisc { playDisc(); return }
+        withAnimation(.easeOut(duration: 0.18)) { phase = .lifted } completion: {
+            withAnimation(.easeInOut(duration: 0.5)) { phase = .flying } completion: {
+                withAnimation(.easeIn(duration: 0.14)) { phase = .inside } completion: {
+                    InsertSound.play(cart64: game.isCart64)
+                    clicks += 1
+                    // The slot flares, then the game's loading screen fades in and the game starts behind it.
+                    withAnimation(.easeIn(duration: 0.6).delay(0.3)) { blackout = true } completion: { hold() }
+                }
+            }
+        }
+    }
+    /// A disc, slower than a card and in step with the drive's sound (about 2 s): it lifts from its hub, glides to the drive
+    /// without a jump in size, and the drive draws it in while the sound plays from its first touch; the screen goes dark as the
+    /// sound fades out (InsertSound cuts the recording's last knock).
+    private func playDisc() {
+        withAnimation(.easeOut(duration: 0.4)) { phase = .lifted } completion: {
+            withAnimation(.easeInOut(duration: 0.85)) { phase = .flying } completion: {
+                InsertSound.play(disc: true)
+                clicks += 1
+                withAnimation(.easeInOut(duration: 1.0)) { phase = .inside } completion: {
+                    withAnimation(.easeIn(duration: 0.5).delay(0.15)) { blackout = true } completion: { hold() }
+                }
+            }
+        }
+    }
+}
+
+/// The screen once the card is in, until the game takes it over: the game's own backdrop picture (or its cover, blurred) slowly
+/// drawing closer under a veil, a glow in its colour, its title and a small spinner, instead of a black screen.
+struct LaunchCurtain: View {
+    let game: GameTile
+    @State private var closer = false
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack {
+                Color.black
+                Group {
+                    if let picture = game.backdrop {
+                        Image(decorative: picture.image, scale: 1).resizable().interpolation(.high).scaledToFill()
+                            .opacity(0.62)
+                    } else {
+                        ArtView(game: game, backdrop: true).scaleEffect(1.3).blur(radius: 50, opaque: true).opacity(0.55)
+                    }
+                }
+                .frame(width: geometry.size.width, height: geometry.size.height)
+                .scaleEffect(closer ? 1.07 : 1)
+                .clipped()
+                RadialGradient(colors: [game.light.color.opacity(0.28), .clear], center: .center, startRadius: 0,
+                               endRadius: max(geometry.size.width, geometry.size.height) * 0.5)
+                    .blendMode(.plusLighter)
+                LinearGradient(stops: [.init(color: .black.opacity(0.25), location: 0), .init(color: .clear, location: 0.35),
+                                       .init(color: .black.opacity(0.8), location: 1)], startPoint: .top, endPoint: .bottom)
+                VStack(spacing: 16) {
+                    Spacer()
+                    Text(game.title).shellType(ShellType.flowTitle(min(40, geometry.size.width * 0.045)))
+                        .multilineTextAlignment(.center).lineLimit(2)
+                        .shadow(color: .black.opacity(0.5), radius: 14)
+                    ProgressView().tint(.white.opacity(0.8)).controlSize(.regular)
+                }
+                .foregroundStyle(.white)
+                .padding(.horizontal, 40)
+                .padding(.bottom, geometry.size.height * 0.12)
+            }
+            .frame(width: geometry.size.width, height: geometry.size.height)
+        }
+        .ignoresSafeArea()
+        .contentShape(Rectangle())
+        .onAppear {
+            guard !reduceMotion else { return }
+            withAnimation(.linear(duration: 8)) { closer = true }
+        }
+    }
+}
