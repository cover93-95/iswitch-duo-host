+/// The player's own word on a game, chosen in the info panel.
+public enum PlayStatus: String, CaseIterable, Sendable {
+    case notStarted, playing, finished, abandoned
+    public var title: String {
+        switch self {
+        case .notStarted: ShellStrings.text("Not started")
+        case .playing: ShellStrings.text("Playing")
+        case .finished: ShellStrings.text("Finished")
