diff --git a/frontend-ios/Sources/ShellDemo/SampleScreens.swift b/frontend-ios/Sources/ShellDemo/SampleScreens.swift
new file mode 100644
index 0000000..8a1e9e6
--- /dev/null
+++ b/frontend-ios/Sources/ShellDemo/SampleScreens.swift
@@ -0,0 +1,42 @@
+import SwiftUI
+import ImageIO
+import UniformTypeIdentifiers
+
+/// Fictional screenshots for the demo's info panel: drawn scenes written once as PNG files to the temporary folder, since the
+/// panel takes files (as the host gives it the game's `screens/`).
+@MainActor enum SampleScreens {
+    static func files(for id: String) -> [URL] {
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent("demo-screens/\(id)", isDirectory: true)
+        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        let skies: [(Color, Color)] = [(.orange, .purple), (.cyan, .blue), (.pink, .indigo), (.mint, .teal), (.yellow, .red)]
+        return skies.enumerated().compactMap { index, sky in
+            let url = folder.appendingPathComponent("\(index + 1).png")
+            if FileManager.default.fileExists(atPath: url.path) { return url }
+            let renderer = ImageRenderer(content: Scene(top: sky.0, bottom: sky.1, number: index + 1))
+            renderer.scale = 1
+            guard let image = renderer.cgImage,
+                  let out = CGImageDestinationCreateWithURL(url as CFURL, UTType.png.identifier as CFString, 1, nil) else { return nil }
+            CGImageDestinationAddImage(out, image, nil)
+            return CGImageDestinationFinalize(out) ? url : nil
+        }
+    }
+
+    private struct Scene: View {
+        let top: Color
+        let bottom: Color
+        let number: Int
+        var body: some View {
+            ZStack(alignment: .bottom) {
+                LinearGradient(colors: [top, bottom], startPoint: .top, endPoint: .bottom)
+                Circle().fill(.white.opacity(0.85)).frame(width: 120).offset(x: CGFloat(number * 90) - 300, y: -420)
+                Ellipse().fill(.black.opacity(0.35)).frame(width: 1400, height: 420).offset(x: -260, y: 170)
+                Ellipse().fill(.black.opacity(0.55)).frame(width: 1200, height: 360).offset(x: 380, y: 200)
+                Text(verbatim: "\(number)").font(.system(size: 64, weight: .heavy, design: .rounded))
+                    .foregroundStyle(.white.opacity(0.8)).padding(36)
+                    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .bottomTrailing)
+            }
+            .frame(width: 1280, height: 720)
+            .clipped()
+        }
+    }
+}
