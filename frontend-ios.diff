+/// A game as an upright box: its cover, a soft sheen, the state dot, and its reflection on the floor under it. The chosen
+/// box is lit: a light edge, a blue glow around it and a ring of light at its foot.
+private struct BoxCover: View {
+    let game: GameTile
+    let chosen: Bool
+    let width: CGFloat
+    var body: some View {
+        let height = width / CoverFlowView.boxRatio
+        let radius = width * 0.035
+        let shape = RoundedRectangle(cornerRadius: radius)
+        let glow = Color(red: 0.35, green: 0.65, blue: 1.0)
+        ArtView(game: game)
+            .frame(width: width, height: height)
+            .clipShape(shape)
+            .overlay(
+                LinearGradient(colors: [.white.opacity(0.20), .clear, .clear], startPoint: .topLeading, endPoint: .center)
+                    .clipShape(shape).allowsHitTesting(false)
+            )
+            .overlay(shape.strokeBorder(.white.opacity(chosen ? 0.6 : 0.12), lineWidth: chosen ? 2 : 1))
+            .overlay(alignment: .topLeading) {
+                let size = max(8, min(14, width * 0.05))
+                StateDot(state: game.state, size: size).padding(size * 0.9)
+            }
+            .shadow(color: chosen ? glow.opacity(0.6) : .black.opacity(0.5), radius: chosen ? width * 0.10 : width * 0.05,
+                    y: chosen ? 0 : width * 0.03)
+            .background(alignment: .bottom) {
+                // The ring of light the chosen box stands on.
+                if chosen {
+                    Ellipse()
+                        .stroke(glow.opacity(0.85), lineWidth: 3)
+                        .frame(width: width * 1.35, height: width * 0.16)
+                        .blur(radius: 2)
+                        .shadow(color: glow, radius: 12)
+                        .offset(y: width * 0.08)
+                        .allowsHitTesting(false)
+                }
+            }
+            .background(alignment: .top) {
+                // The reflection: the cover turned over under the box, fading out.
+                ArtView(game: game, backdrop: false, lettering: false)
+                    .frame(width: width, height: height)
+                    .clipShape(shape)
+                    .mask(LinearGradient(colors: [.clear, .clear, .white.opacity(0.35)], startPoint: .top, endPoint: .bottom))
+                    .scaleEffect(x: 1, y: -1, anchor: .bottom)
+                    .offset(y: 4)
+                    .opacity(0.8)
+                    .allowsHitTesting(false)
+            }
+            .accessibilityHidden(true)
+    }
+}
