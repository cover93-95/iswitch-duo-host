diff --git a/frontend-ios/Sources/ShellHost/WebGameCatalogue.swift b/frontend-ios/Sources/ShellHost/WebGameCatalogue.swift
new file mode 100644
index 0000000..fa3b059
--- /dev/null
+++ b/frontend-ios/Sources/ShellHost/WebGameCatalogue.swift
@@ -0,0 +1,52 @@
+import Foundation
+
+/// A game played in the browser, from the app's `WebGames/<id>/` folder: `game.json` with the page's address, the title and
+/// the platform the library's selector files it under (PS2, PC), and the same pictures and texts as a Switch game's
+/// framework (banner, backdrop, back, ambience.txt, synopsis.txt, screens/). No game file is ever in it: the page holds the game.
+public struct WebGameEntry: Equatable, Sendable, Identifiable {
+    public var id: String
+    public var title: String
+    public var platform: String
+    public var url: URL
+    public var subtitle: String
+    public var bannerURL: URL?
+    public var backdropURL: URL?
+    public var backURL: URL?
+    public var ambienceText: String?
+    public var screenURLs: [URL] = []
+    public var synopsis: String?
+    /// game.json's "start" (the page's buttons pressed in order once it has loaded) and "focus" (the element made to fill the screen)
+    public var start: [String] = []
+    public var focus: String?
+}
+
+public enum WebGameCatalogue {
+    struct Manifest: Decodable { var title: String; var platform: String; var url: String; var subtitle: String?; var start: [String]?; var focus: String? }
+
+    /// The web games under `root`, in folder-name order. A folder without a readable game.json or an https address is skipped.
+    public static func scan(root: URL?, fileManager fm: FileManager = .default) -> [WebGameEntry] {
+        guard let root, let names = try? fm.contentsOfDirectory(atPath: root.path) else { return [] }
+        return names.filter { !$0.hasPrefix(".") }.sorted().compactMap { read(directory: root.appendingPathComponent($0, isDirectory: true), fm) }
+    }
+
+    /// A page on the web, or another app of this device that runs the game (Ocarina of Time in the Nintendo Switch 2 app).
+    static let schemes: Set<String> = ["https", "iswitchduo-switch2"]
+
+    static func read(directory dir: URL, _ fm: FileManager) -> WebGameEntry? {
+        guard let data = fm.contents(atPath: dir.appendingPathComponent("game.json").path),
+              let m = try? JSONDecoder().decode(Manifest.self, from: data),
+              let url = URL(string: m.url), url.scheme.map(Self.schemes.contains) == true, !m.title.isEmpty, !m.platform.isEmpty else { return nil }
+        func image(_ base: String) -> URL? {
+            GameCatalogue.imageExtensions.map { dir.appendingPathComponent("\(base).\($0)") }.first { fm.fileExists(atPath: $0.path) }
+        }
+        var entry = WebGameEntry(id: "web." + dir.lastPathComponent, title: m.title, platform: m.platform, url: url,
+                                 subtitle: m.subtitle ?? m.platform, bannerURL: image("banner"), backdropURL: image("backdrop"))
+        entry.backURL = image("back")
+        entry.ambienceText = fm.contents(atPath: dir.appendingPathComponent("ambience.txt").path).flatMap { String(data: $0.prefix(64), encoding: .utf8) }
+        entry.screenURLs = GameCatalogue.screens(in: dir, fm)
+        entry.synopsis = GameCatalogue.synopsis(in: dir, fm)
+        entry.start = m.start ?? []
+        entry.focus = m.focus.flatMap { $0.isEmpty ? nil : $0 }
+        return entry
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/AmbienceLayer.swift b/frontend-ios/Sources/ShellUI/AmbienceLayer.swift
new file mode 100644
index 0000000..fe85c8a
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/AmbienceLayer.swift
@@ -0,0 +1,183 @@
+import SwiftUI
+
+/// A game's ambience: a few slow particles over its backdrop, chosen per game (`ambience.txt` in its framework). Off with
+/// Reduce Motion. Drawn only while the library is on screen: when a game starts, the window's root becomes the game view and
+/// this view, with its timeline, is gone.
+public enum Ambience: String, Equatable, Sendable, CaseIterable {
+    case none
+    /// Golden sparkles that rise and twinkle.
+    case sparkles
+    /// Pale motes that float, a little ghostly.
+    case dust
+    /// Soft clouds that drift across.
+    case clouds
+    /// Violet shards that rise and turn.
+    case shards
+    /// An old film's grain, with a scratch now and then.
+    case grain
+    /// Glowing fairies that fly about with a trail (Zelda).
+    case fairies
+    /// Snow falling slantwise at several depths.
+    case snow
+    /// Neon light trails speeding past, a city's glow at the bottom.
+    case neon
+    /// A fighter's aura: sparks of energy rising, a surge now and then.
+    case aura
+    /// Slanting rain and distant lightning.
+    case rain
+    /// A night city's soft round lights, out of focus, drifting.
+    case bokeh
+    /// Green ghostly wisps that rise, float and fade.
+    case wisps
+    /// Embers rising and flickering.
+    case embers
+
+    /// The word in `ambience.txt`, any case, spaces and line ends ignored. Anything else is none.
+    public init(text: String?) {
+        self = Ambience(rawValue: (text ?? "").trimmingCharacters(in: .whitespacesAndNewlines).lowercased()) ?? .none
+    }
+}
+
+struct AmbienceLayer: View {
+    let kind: Ambience
+    var body: some View {
+        if kind != .none {
+            TimelineView(.animation(minimumInterval: 1.0 / 30)) { timeline in
+                Canvas { context, size in
+                    let t = timeline.date.timeIntervalSinceReferenceDate
+                    switch kind {
+                    case .sparkles: Self.sparkles(&context, size, t)
+                    case .dust: Self.dust(&context, size, t)
+                    case .clouds: Self.clouds(&context, size, t)
+                    case .shards: Self.shards(&context, size, t)
+                    case .grain: Self.grain(&context, size, t)
+                    case .fairies: Self.fairies(&context, size, t)
+                    case .snow: Self.snow(&context, size, t)
+                    case .neon: Self.neon(&context, size, t)
+                    case .aura: Self.aura(&context, size, t)
+                    case .rain: Self.rain(&context, size, t)
+                    case .bokeh: Self.bokeh(&context, size, t)
+                    case .wisps: Self.wisps(&context, size, t)
+                    case .embers: Self.embers(&context, size, t)
+                    case .none: break
+                    }
+                }
+            }
+            .allowsHitTesting(false)
+            .accessibilityHidden(true)
+        }
+    }
+
+    /// A fixed pseudo-random number in 0..<1 for particle `i` and property `k`: the same every frame, so nothing is stored.
+    static func noise(_ i: Int, _ k: Int) -> Double {
+        let v = sin(Double(i) * 12.9898 + Double(k) * 78.233) * 43758.5453
+        return v - v.rounded(.down)
+    }
+    /// `v` wrapped into 0..<1.
+    static func wrap(_ v: Double) -> Double { v - v.rounded(.down) }
+
+    private static func glow(_ context: inout GraphicsContext, at p: CGPoint, radius r: CGFloat, color: Color, alpha: Double) {
+        let rect = CGRect(x: p.x - r, y: p.y - r, width: r * 2, height: r * 2)
+        context.fill(Path(ellipseIn: rect), with: .radialGradient(Gradient(colors: [color.opacity(alpha), color.opacity(0)]),
+                                                                    center: p, startRadius: 0, endRadius: r))
+    }
+
+    static func sparkles(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let gold = Color(red: 1, green: 0.86, blue: 0.45)
+        let unit = min(size.width, size.height)
+        for i in 0..<26 {
+            let speed = 0.012 + noise(i, 1) * 0.02
+            let y = wrap(noise(i, 2) - t * speed)
+            let x = noise(i, 3) + sin(t * 0.4 + noise(i, 4) * 6.28) * 0.012
+            let twinkle = pow(0.5 + 0.5 * sin(t * (1.5 + noise(i, 5) * 2) + noise(i, 6) * 6.28), 3)
+            let fade = min(1, min(y, 1 - y) * 6)   // in and out at the edges
+            let alpha = twinkle * fade
+            guard alpha > 0.02 else { continue }
+            let p = CGPoint(x: x * size.width, y: y * size.height)
+            let r = unit * (0.006 + noise(i, 7) * 0.008)
+            glow(&context, at: p, radius: r * 4, color: gold, alpha: 0.35 * alpha)
+            var star = Path()
+            star.move(to: CGPoint(x: p.x - r * 2.2, y: p.y)); star.addLine(to: CGPoint(x: p.x + r * 2.2, y: p.y))
+            star.move(to: CGPoint(x: p.x, y: p.y - r * 2.2)); star.addLine(to: CGPoint(x: p.x, y: p.y + r * 2.2))
+            context.stroke(star, with: .color(.white.opacity(0.9 * alpha)), lineWidth: max(1, r * 0.35))
+            context.fill(Path(ellipseIn: CGRect(x: p.x - r * 0.6, y: p.y - r * 0.6, width: r * 1.2, height: r * 1.2)),
+                         with: .color(.white.opacity(alpha)))
+        }
+    }
+
+    static func dust(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let pale = Color(red: 0.75, green: 0.9, blue: 1)
+        let unit = min(size.width, size.height)
+        for i in 0..<36 {
+            let x = wrap(noise(i, 1) + t * (0.004 + noise(i, 2) * 0.006) + sin(t * 0.3 + noise(i, 3) * 6.28) * 0.02)
+            let y = wrap(noise(i, 4) - t * (0.003 + noise(i, 5) * 0.004) + cos(t * 0.25 + noise(i, 6) * 6.28) * 0.02)
+            let alpha = 0.25 + 0.35 * (0.5 + 0.5 * sin(t * (0.6 + noise(i, 7)) + noise(i, 8) * 6.28))
+            let r = unit * (0.004 + noise(i, 9) * 0.01)
+            glow(&context, at: CGPoint(x: x * size.width, y: y * size.height), radius: r * 3, color: pale, alpha: alpha)
+        }
+    }
+
+    static func clouds(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        for i in 0..<7 {
+            let w = size.width * (0.3 + noise(i, 1) * 0.35)
+            let h = w * (0.18 + noise(i, 2) * 0.1)
+            let span = size.width + w
+            let x = wrap(noise(i, 3) + t * (0.004 + noise(i, 4) * 0.006)) * span - w
+            let y = size.height * (0.08 + noise(i, 5) * 0.75)
+            let alpha = 0.10 + noise(i, 6) * 0.10
+            let rect = CGRect(x: x, y: y, width: w, height: h)
+            context.fill(Path(ellipseIn: rect), with: .radialGradient(Gradient(colors: [.white.opacity(alpha), .white.opacity(0)]),
+                                                                      center: CGPoint(x: rect.midX, y: rect.midY), startRadius: 0,
+                                                                      endRadius: w / 2))
+        }
+    }
+
+    static func shards(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let colors = [Color(red: 0.85, green: 0.45, blue: 1), Color(red: 1, green: 0.55, blue: 0.85), Color(red: 0.6, green: 0.5, blue: 1)]
+        let unit = min(size.width, size.height)
+        for i in 0..<24 {
+            let y = wrap(noise(i, 1) - t * (0.01 + noise(i, 2) * 0.018))
+            let x = noise(i, 3) + sin(t * 0.35 + noise(i, 4) * 6.28) * 0.02
+            let fade = min(1, min(y, 1 - y) * 5)
+            let alpha = (0.35 + 0.45 * (0.5 + 0.5 * sin(t * 2 + noise(i, 5) * 6.28))) * fade
+            let r = unit * (0.006 + noise(i, 6) * 0.012)
+            let angle = t * (0.6 + noise(i, 7)) + noise(i, 8) * 6.28
+            let p = CGPoint(x: x * size.width, y: y * size.height)
+            let color = colors[i % colors.count]
+            glow(&context, at: p, radius: r * 3, color: color, alpha: 0.3 * alpha)
+            var shard = Path()
+            for k in 0..<4 {
+                let a = angle + Double(k) * .pi / 2
+                let len = k % 2 == 0 ? r * 1.6 : r * 0.6
+                let q = CGPoint(x: p.x + cos(a) * len, y: p.y + sin(a) * len)
+                if k == 0 { shard.move(to: q) } else { shard.addLine(to: q) }
+            }
+            shard.closeSubpath()
+            context.fill(shard, with: .color(color.opacity(alpha)))
+        }
+    }
+
+    static func grain(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        let frame = Int(t * 18)   // the grain changes 18 times a second, as film would
+        for i in 0..<140 {
+            let n = frame * 151 + i
+            let p = CGPoint(x: noise(n, 1) * size.width, y: noise(n, 2) * size.height)
+            let r = 0.6 + noise(n, 3) * 1.6
+            let light = noise(n, 4) > 0.5
+            context.fill(Path(ellipseIn: CGRect(x: p.x - r, y: p.y - r, width: r * 2, height: r * 2)),
+                         with: .color((light ? Color.white : Color.black).opacity(0.10 + noise(n, 5) * 0.12)))
+        }
+        // A scratch for a few frames every few seconds.
+        let beat = Int(t / 2.7)
+        if noise(beat, 9) > 0.45, wrap(t / 2.7) < 0.12 {
+            let x = noise(beat, 10) * size.width
+            var line = Path()
+            line.move(to: CGPoint(x: x, y: 0))
+            line.addLine(to: CGPoint(x: x + (noise(beat, 11) - 0.5) * 12, y: size.height))
+            context.stroke(line, with: .color(.white.opacity(0.18)), lineWidth: 1)
+        }
+        // The slight flicker of a projector.
+        let flicker = 0.025 * (0.5 + 0.5 * sin(t * 23))
+        context.fill(Path(CGRect(origin: .zero, size: size)), with: .color(.black.opacity(flicker)))
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/AmbienceMore.swift b/frontend-ios/Sources/ShellUI/AmbienceMore.swift
new file mode 100644
index 0000000..b975141
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/AmbienceMore.swift
@@ -0,0 +1,163 @@
+import SwiftUI
+
+/// The ambiences made for particular games: fairies (Zelda), snow (a snowboard game), neon trails (night street racing), a fighter's
+/// aura, rain with distant lightning, a city's soft bokeh, ghostly wisps and rising embers. Light is added, never painted over, so
+/// they glow on the veiled backdrop as the reviewed previews did.
+extension AmbienceLayer {
+    /// A soft round light of radius `r`, bright in the middle and falling off quickly, added to what is under it.
+    private static func light(_ context: inout GraphicsContext, _ x: Double, _ y: Double, _ r: Double, _ color: Color, _ alpha: Double) {
+        guard alpha > 0.01, r > 0.3 else { return }
+        let p = CGPoint(x: x, y: y)
+        context.fill(Path(ellipseIn: CGRect(x: x - r, y: y - r, width: r * 2, height: r * 2)),
+                     with: .radialGradient(Gradient(stops: [.init(color: color.opacity(min(1, alpha)), location: 0),
+                                                            .init(color: color.opacity(min(1, alpha) * 0.25), location: 0.5),
+                                                            .init(color: color.opacity(0), location: 1)]),
+                                           center: p, startRadius: 0, endRadius: r))
+    }
+    /// A streak from `a` to `b`, faint at its tail and bright at its head.
+    private static func streak(_ context: inout GraphicsContext, _ a: CGPoint, _ b: CGPoint, width: Double, _ color: Color, _ alpha: Double) {
+        guard alpha > 0.01 else { return }
+        var path = Path()
+        path.move(to: a)
+        path.addLine(to: b)
+        context.stroke(path, with: .linearGradient(Gradient(colors: [color.opacity(0), color.opacity(min(1, alpha))]), startPoint: a, endPoint: b),
+                       style: StrokeStyle(lineWidth: width, lineCap: .round))
+    }
+
+    static func fairies(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        let halo = Color(red: 0.55, green: 0.8, blue: 1), glowColor = Color(red: 0.85, green: 0.95, blue: 1), trail = Color(red: 0.75, green: 0.92, blue: 1)
+        for i in 0..<4 {
+            func pos(_ tt: Double) -> (Double, Double) {
+                let x = 0.5 + 0.36 * sin(tt * (0.23 + noise(i, 1) * 0.2) + noise(i, 2) * 6.28) + 0.05 * sin(tt * (1.7 + noise(i, 3)) + Double(i))
+                let y = 0.42 + 0.26 * sin(tt * (0.31 + noise(i, 4) * 0.2) + noise(i, 5) * 6.28) + 0.04 * cos(tt * (2.1 + noise(i, 6)) + Double(i))
+                return (x * size.width, y * size.height)
+            }
+            let pulse = 0.75 + 0.25 * sin(t * 6 + Double(i) * 2)
+            for k in stride(from: 14, to: 0, by: -1) {
+                let (px, py) = pos(t - Double(k) * 0.035)
+                light(&context, px, py, unit * 0.009 * (1 - Double(k) / 16), trail, 0.5 * (1 - Double(k) / 15))
+            }
+            let (x, y) = pos(t)
+            light(&context, x, y, unit * 0.1, halo, 0.35 * pulse)
+            light(&context, x, y, unit * 0.03, glowColor, 0.8 * pulse)
+            light(&context, x, y, unit * 0.011, .white, 1)
+        }
+    }
+
+    static func snow(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        for i in 0..<110 {
+            let depth = noise(i, 1)
+            let y = wrap(noise(i, 2) + t * (0.05 + depth * 0.12))
+            let x = wrap(noise(i, 3) + t * 0.02 * (0.5 + depth) + 0.012 * sin(t * (0.8 + noise(i, 4)) + Double(i)))
+            light(&context, x * size.width, y * size.height, unit * (0.002 + depth * 0.006) * 2.2, .white, 0.35 + 0.5 * depth)
+        }
+    }
+
+    static func neon(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        let colors = [Color(red: 1, green: 0.25, blue: 0.75), Color(red: 0.2, green: 0.9, blue: 1), Color(red: 0.65, green: 0.35, blue: 1)]
+        // The city's glow along the bottom, breathing.
+        let band = CGRect(x: 0, y: size.height * 0.74, width: size.width, height: size.height * 0.24)
+        let breath = 0.07 + 0.03 * sin(t * 1.3)
+        context.fill(Path(band), with: .linearGradient(Gradient(colors: [.clear, Color(red: 0.7, green: 0.3, blue: 0.9).opacity(breath), .clear]),
+                                                       startPoint: CGPoint(x: 0, y: band.minY), endPoint: CGPoint(x: 0, y: band.maxY)))
+        for i in 0..<12 {
+            let x = wrap(noise(i, 2) + t * (0.18 + noise(i, 1) * 0.35)) * 1.4 - 0.2
+            let y = (0.55 + noise(i, 3) * 0.4) * size.height
+            let length = 0.08 + noise(i, 4) * 0.16
+            let color = colors[i % colors.count]
+            let head = CGPoint(x: x * size.width, y: y), tail = CGPoint(x: (x - length) * size.width, y: y)
+            streak(&context, tail, head, width: unit * 0.016, color, 0.22)
+            streak(&context, tail, head, width: unit * 0.005, color, 0.75)
+            light(&context, head.x, head.y, unit * 0.02, color, 0.35)
+        }
+    }
+
+    static func aura(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        let flare = pow(max(0, sin(t * 2.1)), 8)                 // a surge now and then
+        light(&context, size.width * 0.5, size.height * 0.85, unit * 0.7, Color(red: 1, green: 0.7, blue: 0.2), 0.12 + 0.18 * flare)
+        let spark = Color(red: 1, green: 0.82, blue: 0.35), core = Color(red: 1, green: 1, blue: 0.9)
+        for i in 0..<40 {
+            let y = 1 - wrap(noise(i, 2) + t * (0.15 + noise(i, 1) * 0.25 + flare * 0.1))
+            let x = (noise(i, 3) + 0.015 * sin(t * 3 + Double(i))) * size.width
+            let fade = min(1, y * 3) * min(1, (1 - y) * 6)
+            streak(&context, CGPoint(x: x, y: (y + 0.035) * size.height), CGPoint(x: x, y: y * size.height), width: unit * 0.007, spark, fade)
+            light(&context, x, y * size.height, unit * 0.007, core, fade)
+        }
+    }
+
+    static func rain(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let drop = Color(red: 0.8, green: 0.86, blue: 1)
+        for i in 0..<140 {
+            let speed = 1.3 + noise(i, 1) * 0.6
+            let y = wrap(noise(i, 2) + t * speed)
+            let x = wrap(noise(i, 3) + t * speed * 0.18)
+            let length = 0.04 + noise(i, 4) * 0.03
+            streak(&context, CGPoint(x: (x - length * 0.18) * size.width, y: (y - length) * size.height),
+                   CGPoint(x: x * size.width, y: y * size.height), width: 1.6, drop, 0.4 + 0.3 * noise(i, 5))
+        }
+        // Distant lightning, about every 6 s: a flash and a fainter second one.
+        let phase = wrap(t / 6.5)
+        let flash = max(0, 1 - abs(phase - 0.5) / 0.012) + 0.6 * max(0, 1 - abs(phase - 0.53) / 0.01)
+        if flash > 0 {
+            context.fill(Path(CGRect(origin: .zero, size: size)), with: .color(Color(red: 0.75, green: 0.8, blue: 1).opacity(0.3 * flash)))
+        }
+    }
+
+    static func bokeh(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        let colors = [Color(red: 1, green: 0.35, blue: 0.65), Color(red: 0.2, green: 0.85, blue: 0.85), Color(red: 1, green: 0.6, blue: 0.3)]
+        for i in 0..<16 {
+            let x = wrap(noise(i, 1) + t * 0.012 * (noise(i, 2) - 0.5))
+            let y = wrap(noise(i, 3) - t * 0.01 * (0.3 + noise(i, 4)))
+            let alpha = 0.3 + 0.15 * sin(t * (0.5 + noise(i, 6)) + Double(i))
+            light(&context, x * size.width, y * size.height, unit * (0.035 + noise(i, 5) * 0.06), colors[i % colors.count], alpha)
+        }
+    }
+
+    static func wisps(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        let green = Color(red: 0.5, green: 1, blue: 0.6), halo = Color(red: 0.35, green: 1, blue: 0.5), core = Color(red: 0.8, green: 1, blue: 0.85)
+        for i in 0..<6 {
+            let period = 6 + noise(i, 1) * 4
+            let life = pow(sin(wrap(t / period + noise(i, 2)) * .pi), 2)
+            func pos(_ tt: Double) -> (Double, Double) {
+                let x = noise(i, 3) * 0.8 + 0.1 + 0.06 * sin(tt * (0.7 + noise(i, 4)) + Double(i))
+                let y = 0.75 - 0.4 * wrap(tt / period + noise(i, 2)) + 0.03 * sin(tt * 2 + Double(i))
+                return (x * size.width, y * size.height)
+            }
+            for k in stride(from: 8, to: 0, by: -1) {
+                let (px, py) = pos(t - Double(k) * 0.08)
+                light(&context, px, py, unit * 0.012 * (1 - Double(k) / 10), green, 0.25 * life * (1 - Double(k) / 9))
+            }
+            let (x, y) = pos(t)
+            light(&context, x, y, unit * 0.06, halo, 0.25 * life)
+            light(&context, x, y, unit * 0.016, core, 0.75 * life)
+        }
+    }
+
+    static func embers(_ context: inout GraphicsContext, _ size: CGSize, _ t: Double) {
+        context.blendMode = .plusLighter
+        let unit = min(size.width, size.height)
+        let red = Color(red: 1, green: 0.35, blue: 0.05), hot = Color(red: 1, green: 0.75, blue: 0.35)
+        for i in 0..<45 {
+            let y = 1 - wrap(noise(i, 2) + t * (0.06 + noise(i, 1) * 0.1))
+            let x = noise(i, 3) + 0.03 * sin(t * (0.9 + noise(i, 4)) + Double(i) * 1.7) + 0.01 * sin(t * 5 + Double(i))
+            let flicker = 0.6 + 0.4 * sin(t * (7 + noise(i, 5) * 6) + Double(i))
+            let fade = min(1, y * 2.5) * min(1, (1 - y) * 5)
+            let r = unit * (0.0025 + noise(i, 6) * 0.004)
+            light(&context, x * size.width, y * size.height, r * 5, red, 0.3 * flicker * fade)
+            light(&context, x * size.width, y * size.height, r * 1.6, hot, 0.9 * flicker * fade)
+        }
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/BoxTurn.swift b/frontend-ios/Sources/ShellUI/BoxTurn.swift
new file mode 100644
index 0000000..4fe29ec
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/BoxTurn.swift
@@ -0,0 +1,106 @@
+import SwiftUI
+
+/// Turning the chosen box over to read its back: the box follows the finger sideways and settles on its front or its back when
+/// it is let go, or turns over in one go with the controller's View button. The angle is in degrees: 0 the front, 180 the back.
+enum BoxTurn {
+    /// The angle a turn settles on once the finger is let go: the face nearest to where the throw would end, never more than one
+    /// face away from where the turn began.
+    static func settle(start: Double, predicted: Double) -> Double {
+        let faces = (predicted / 180).rounded() * 180
+        return min(start + 180, max(start - 180, faces))
+    }
+    /// True while the back is toward the player.
+    static func showsBack(_ angle: Double) -> Bool { cos(angle * .pi / 180) < 0 }
+    /// The next face for one press of the turn button: the back from the front, the front again from the back, always the same
+    /// way round.
+    static func next(from angle: Double) -> Double { ((angle / 180).rounded() + 1) * 180 }
+    /// The degrees a drag of `distance` points turns a box `width` wide: a drag across the whole box is half a turn.
+    static func angle(drag distance: CGFloat, width: CGFloat) -> Double { Double(distance / max(width, 1)) * 180 }
+}
+
+/// A box with two faces, turned around its upright axis: its front while it faces the player, its back once it has turned past a
+/// right angle, drawn the right way round. Animatable, so the face changes at the right moment of an animated turn.
+struct TurnedBox<Front: View, Back: View>: View, Animatable {
+    var angle: Double
+    let front: Front
+    let back: Back
+    nonisolated var animatableData: Double {
+        get { angle }
+        set { angle = newValue }
+    }
+    var body: some View {
+        let behind = BoxTurn.showsBack(angle)
+        // Darker as it turns edge-on, as the box's side catches less light.
+        let edgeOn = abs(sin(angle * .pi / 180))
+        ZStack {
+            front.opacity(behind ? 0 : 1)
+            back.scaleEffect(x: -1, y: 1).opacity(behind ? 1 : 0)
+        }
+        .brightness(-0.3 * edgeOn)
+        .rotation3DEffect(.degrees(angle), axis: (x: 0, y: 1, z: 0), perspective: 0.4)
+    }
+}
+
+/// The back of a game's box: its real back cover when the game has one (`back.jpg`), filling the box; otherwise one drawn from the
+/// game, in its case's colours: its title, a screenshot-like strip of its art, and its synopsis.
+struct BoxBackFace: View {
+    let game: GameTile
+    let picture: Artwork?
+    let width: CGFloat
+    let height: CGFloat
+    var body: some View {
+        let shape = RoundedRectangle(cornerRadius: min(width, height) * 0.035)
+        Group {
+            if let picture {
+                Image(decorative: picture.image, scale: 1).resizable().interpolation(.high).scaledToFill()
+                    .frame(width: width, height: height).clipped()
+            } else {
+                drawn
+            }
+        }
+        .frame(width: width, height: height)
+        .clipShape(shape)
+        .overlay(LinearGradient(colors: [.white.opacity(0.14), .clear, .clear], startPoint: .topTrailing, endPoint: .center)
+            .clipShape(shape).allowsHitTesting(false))
+        .overlay(shape.strokeBorder(.white.opacity(0.3), lineWidth: 1.5))
+        .accessibilityHidden(true)
+    }
+    /// No back cover: the case's plastic, the title, a band of the art and the synopsis.
+    private var drawn: some View {
+        let style = CaseStyle.of(game)
+        let small = min(width, height)
+        return ZStack(alignment: .top) {
+            LinearGradient(colors: [style.light.mix(with: .black, by: 0.45), style.dark.mix(with: .black, by: 0.6)], startPoint: .top, endPoint: .bottom)
+            VStack(alignment: .leading, spacing: small * 0.05) {
+                Text(game.title).font(.system(size: max(9, small * 0.085), weight: .heavy)).lineLimit(2).minimumScaleFactor(0.6)
+                ArtView(game: game, backdrop: true, lettering: false)
+                    .frame(maxWidth: .infinity).frame(height: height * 0.3).clipped()
+                    .clipShape(RoundedRectangle(cornerRadius: small * 0.02))
+                Text(game.synopsis.isEmpty ? game.subtitle : game.synopsis)
+                    .font(.system(size: max(7, small * 0.052), weight: .medium)).lineSpacing(1)
+                    .foregroundStyle(.white.opacity(0.85)).lineLimit(nil).minimumScaleFactor(0.5)
+                Spacer(minLength: 0)
+            }
+            .foregroundStyle(.white)
+            .padding(small * 0.08)
+        }
+    }
+}
+
+/// The back covers, decoded off the main thread when a box is turned and kept for the few boxes looked at last.
+@MainActor enum BackCovers {
+    private static var cache: [URL: Artwork] = [:]
+    private static var order: [URL] = []
+
+    static func load(_ url: URL?) async -> Artwork? {
+        guard let url else { return nil }
+        if let art = cache[url] { return art }
+        let art = await Task.detached(priority: .userInitiated) { Artwork(id: url.path, url: url, maxPixels: 1400) }.value
+        if let art {
+            cache[url] = art
+            order.append(url)
+            if order.count > 4 { cache[order.removeFirst()] = nil }
+        }
+        return art
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/CartridgeConsoleView.swift b/frontend-ios/Sources/ShellUI/CartridgeConsoleView.swift
new file mode 100644
index 0000000..a95b91f
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/CartridgeConsoleView.swift
@@ -0,0 +1,284 @@
+import SwiftUI
+
+/// An N64 game, opened from the library: no box, the cartridge itself above a console drawn on screen. Playing is pushing it
+/// in: a tap on the cartridge (or A, the cartridge being the focus) lifts it a little, brings it over the slot on top of the console
+/// and pushes it down into it, its top still showing as a cartridge does, with the click and a knock of the haptics; the slot
+/// lights, the game's loading screen fades in and the game starts. A drag across the cartridge (or View) turns it over to the back
+/// of the game's box. A tap beside it, B or Close leaves; Game info opens the panel.
+struct CartridgeConsoleView: View {
+    let game: GameTile
+    let insert: () -> Void
+    let showInfo: () -> Void
+    let close: () -> Void
+    var autoInsert = false
+    /// Counts the presses of View: each turns the cartridge over.
+    var turnRequest = 0
+    @State private var turn: Double = 0
+    @State private var turnStart: Double?
+    @State private var backCover: Artwork?
+    @State private var shown = false
+    @State private var phase = Phase.idle
+    @State private var clicks = 0
+    @State private var blackout = false
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    enum Phase { case idle, lifted, aligned, inside }
+    private var playable: Bool { game.state == .playable }
+
+    var body: some View {
+        GeometryReader { geometry in
+            let size = geometry.size
+            let layout = Self.layout(in: size)
+            ZStack {
+                RadialGradient(colors: [Color(red: 0.16, green: 0.17, blue: 0.2).opacity(0.94), .black.opacity(0.94)],
+                               center: .center, startRadius: 40, endRadius: max(size.width, size.height) * 0.7)
+                    .ignoresSafeArea()
+                    .contentShape(Rectangle())
+                    .onTapGesture { if phase == .idle { close() } }
+                    .accessibilityHidden(true)
+                // The floor shadow under the console.
+                Ellipse().fill(.black.opacity(0.55))
+                    .frame(width: layout.console.width * 1.15, height: layout.console.height * 0.22)
+                    .blur(radius: 18)
+                    .position(x: size.width / 2, y: layout.consoleTop + layout.console.height * 1.02)
+                    .opacity(shown ? 1 : 0)
+                N64Console(width: layout.console.width, height: layout.console.height, slotWidth: layout.cart.width * 1.1,
+                           lit: phase == .aligned || phase == .inside, flare: phase == .inside)
+                    .position(x: size.width / 2, y: layout.consoleTop + layout.console.height / 2)
+                    .offset(y: shown ? 0 : layout.console.height * 0.5)
+                    .opacity(shown ? 1 : 0)
+                    .accessibilityHidden(true)
+                // The cartridge, cut at the slot's line: what goes below it is inside the console.
+                TurnedBox(angle: turn, front: GameCard(game: game, width: layout.cart.width, height: layout.cart.height),
+                          back: BoxBackFace(game: game, picture: backCover, width: layout.cart.width, height: layout.cart.height))
+                    .scaleEffect(phase == .lifted ? 1.05 : 1)
+                    .rotationEffect(.degrees(phase == .lifted ? -2 : 0))
+                    .shadow(color: .black.opacity(0.45), radius: phase == .lifted ? 26 : 12, y: phase == .lifted ? 16 : 8)
+                    .position(x: size.width / 2, y: cartCentre(layout))
+                    .frame(width: size.width, height: size.height)
+                    .mask(alignment: .top) { Rectangle().frame(height: layout.slotLine) }
+                    .offset(y: shown ? 0 : -layout.cart.height * 0.6)
+                    .opacity(shown ? 1 : 0)
+                    .allowsHitTesting(false)
+                    .accessibilityHidden(true)
+                if shown && phase == .idle {
+                    Button(action: play) { Color.clear.contentShape(Rectangle()) }
+                        .buttonStyle(.plain)
+                        .frame(width: layout.cart.width * 1.06, height: layout.cart.height * 1.06)
+                        .position(x: size.width / 2, y: cartCentre(layout))
+                        .accessibilityLabel(ShellStrings.text("Insert the cartridge") + ", " + game.title)
+                        .accessibilityIdentifier("box.cart")
+                        .accessibilityAction(named: ShellStrings.text("Turn the box")) { turnOver() }
+                        .shellTarget("box.cart", radius: layout.cart.width * 0.06, action: play)
+                        // A drag across it turns it over, following the finger; a tap puts it in.
+                        .highPriorityGesture(DragGesture(minimumDistance: 12)
+                            .onChanged { drag in
+                                let start = turnStart ?? turn
+                                if turnStart == nil { turnStart = turn }
+                                turn = start + BoxTurn.angle(drag: drag.translation.width, width: layout.cart.width)
+                            }
+                            .onEnded { drag in
+                                guard let start = turnStart else { return }
+                                turnStart = nil
+                                let end = BoxTurn.settle(start: start, predicted: start + BoxTurn.angle(drag: drag.predictedEndTranslation.width, width: layout.cart.width))
+                                if end != start { NavSound.tick() }
+                                withAnimation(reduceMotion ? nil : .spring(duration: 0.5, bounce: 0.15)) { turn = end }
+                            })
+                        .transition(.opacity)
+                }
+                VStack(spacing: 0) {
+                    HStack(alignment: .top) {
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(game.title).shellType(ShellType.cardTitle).foregroundStyle(.white.opacity(0.85)).lineLimit(1)
+                            Text(statsLine).shellType(ShellType.note).foregroundStyle(.white.opacity(0.5)).lineLimit(1)
+                        }
+                        Spacer(minLength: 12)
+                        Button(action: close) { Label(ShellStrings.text("Close"), systemImage: "xmark") }
+                            .buttonStyle(ChipButtonStyle())
+                            .accessibilityIdentifier("box.close")
+                            .shellTarget("box.close", radius: 22, action: close)
+                    }
+                    Spacer(minLength: 0)
+                    HStack(spacing: 20) {
+                        if playable { GlyphHint(role: .activate, label: ShellStrings.text("Insert the cartridge")) }
+                        GlyphHint(role: .turn, label: ShellStrings.text("Turn the box"))
+                        Button(action: showInfo) { Label(ShellStrings.text("Game info"), systemImage: "info.circle") }
+                            .buttonStyle(ChipButtonStyle())
+                            .accessibilityIdentifier("box.info")
+                            .shellTarget("box.info", radius: 22, action: showInfo)
+                        GlyphHint(role: .back, label: ShellStrings.text("Back"))
+                    }
+                }
+                .padding(.horizontal, 24).padding(.vertical, 12)
+                .allowsHitTesting(phase == .idle)
+                if blackout {
+                    LaunchCurtain(game: game)
+                        .transition(.opacity)
+                        .accessibilityHidden(true)
+                }
+            }
+            .frame(width: size.width, height: size.height)
+        }
+        .sensoryFeedback(.impact(weight: .heavy, intensity: 1), trigger: clicks)
+        .onAppear(perform: present)
+        .task { backCover = await BackCovers.load(game.back) }
+        .onChange(of: turnRequest) { _, _ in turnOver() }
+    }
+    /// View: the cartridge turns over in one go.
+    private func turnOver() {
+        guard phase == .idle else { return }
+        NavSound.tick()
+        withAnimation(reduceMotion ? nil : .spring(duration: 0.6, bounce: 0.12)) { turn = BoxTurn.next(from: turn) }
+    }
+
+    /// Where the console and the cartridge sit: the console low in the middle, the cartridge floating above its slot, the whole
+    /// group centred between the title row and the hints.
+    struct Layout: Equatable {
+        var console: CGSize
+        var cart: CGSize
+        var consoleTop: CGFloat
+        /// The line across the slot: the part of the cartridge below it is inside the console.
+        var slotLine: CGFloat
+        /// The cartridge's centre at rest, above the slot.
+        var restCentre: CGFloat
+    }
+    static func layout(in size: CGSize) -> Layout {
+        let top: CGFloat = 76, bottom: CGFloat = 70
+        let room = max(200, size.height - top - bottom)
+        let consoleWidth = min(size.width * 0.5, room * 1.15, 600)
+        let console = CGSize(width: consoleWidth, height: consoleWidth * 0.36)
+        let cartWidth = consoleWidth * 0.46
+        let cart = CGSize(width: cartWidth, height: cartWidth * CaseTray.ratio(.cart64Case))
+        let gap = cart.height * 0.3
+        let group = cart.height + gap + console.height
+        let consoleTop = top + max(0, (room - group) / 2) + cart.height + gap
+        let slotLine = consoleTop + console.height * N64Console.slotCentre
+        return Layout(console: console, cart: cart, consoleTop: consoleTop, slotLine: slotLine,
+                      restCentre: slotLine - gap - cart.height / 2)
+    }
+    /// The cartridge's centre for the phase: at rest above the slot, lifted, over the slot touching it, then pushed in with its
+    /// top part still out.
+    private func cartCentre(_ layout: Layout) -> CGFloat {
+        let half = layout.cart.height / 2
+        switch phase {
+        case .idle: return layout.restCentre
+        case .lifted: return layout.restCentre - layout.cart.height * 0.1
+        case .aligned: return layout.slotLine - half
+        case .inside: return layout.slotLine - half + layout.cart.height * Self.sunk
+        }
+    }
+    /// How much of the cartridge goes into the console.
+    static let sunk: CGFloat = 0.62
+
+    private var statsLine: String {
+        ShellFormat.metaLine(ShellStrings.text("Played") + " " + ShellFormat.playTime(game.stats.seconds),
+                             ShellFormat.lastPlayed(game.stats.lastPlayed),
+                             ShellStrings.text("Launches") + " \(game.stats.launches)")
+    }
+
+    private func present() {
+        if playable { InsertSound.prepare(cart64: true) }
+        if reduceMotion { shown = true; if autoInsert { play() }; return }
+        withAnimation(.spring(duration: 0.6, bounce: 0.18)) { shown = true } completion: {
+            if autoInsert { DispatchQueue.main.asyncAfter(deadline: .now() + 0.25) { play() } }
+        }
+    }
+    private func play() {
+        guard phase == .idle else { return }
+        guard playable else { insert(); return }
+        MenuMusic.duck(to: MenuMusic.insertLevel, over: 0.25)
+        if reduceMotion {
+            InsertSound.play(cart64: true); clicks += 1
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { start() }
+            return
+        }
+        withAnimation(.easeOut(duration: 0.2)) { phase = .lifted; turn = (turn / 360).rounded() * 360 } completion: {
+            withAnimation(.easeInOut(duration: 0.4)) { phase = .aligned } completion: {
+                withAnimation(.easeIn(duration: 0.16)) { phase = .inside } completion: {
+                    InsertSound.play(cart64: true)
+                    clicks += 1
+                    withAnimation(.easeIn(duration: 0.6).delay(0.35)) { blackout = true } completion: {
+                        DispatchQueue.main.asyncAfter(deadline: .now() + GameBoxView.curtainHold) { start() }
+                    }
+                }
+            }
+        }
+    }
+    /// The game, from its loading screen. One that does not start leaves the cartridge back above the console after a moment.
+    private func start() {
+        MenuMusic.stop(fade: 0.5)
+        insert()
+        DispatchQueue.main.asyncAfter(deadline: .now() + 4) {
+            withAnimation(.easeOut(duration: 0.4)) { blackout = false; phase = .idle }
+        }
+    }
+}
+
+/// A grey console seen from the front and a little above, in the spirit of a Nintendo 64 without its marks: the cartridge slot
+/// in the middle of its top, the power and reset switches either side, four controller ports along the front.
+struct N64Console: View {
+    let width: CGFloat
+    let height: CGFloat
+    let slotWidth: CGFloat
+    let lit: Bool
+    var flare = false
+    /// The slot's middle, down from the console's top, for its height.
+    static let slotCentre: CGFloat = 0.2
+
+    var body: some View {
+        let glow = Color(red: 0.4, green: 0.7, blue: 1.0)
+        let shell = UnevenRoundedRectangle(topLeadingRadius: height * 0.3, bottomLeadingRadius: height * 0.12,
+                                          bottomTrailingRadius: height * 0.12, topTrailingRadius: height * 0.3)
+        let slotHeight = height * 0.16
+        ZStack(alignment: .top) {
+            shell.fill(LinearGradient(colors: [Color(white: 0.34), Color(white: 0.2), Color(white: 0.12)], startPoint: .top, endPoint: .bottom))
+                .overlay(shell.strokeBorder(.white.opacity(0.16), lineWidth: 1))
+            // The top's raised middle, where the slot is.
+            RoundedRectangle(cornerRadius: height * 0.1)
+                .fill(LinearGradient(colors: [Color(white: 0.4), Color(white: 0.26)], startPoint: .top, endPoint: .bottom))
+                .frame(width: slotWidth * 1.3, height: height * 0.42)
+                .padding(.top, height * 0.02)
+            // The slot: a dark opening, lit while the cartridge goes in.
+            RoundedRectangle(cornerRadius: slotHeight * 0.3)
+                .fill(flare ? glow.mix(with: .white, by: 0.5) : Color.black)
+                .frame(width: slotWidth, height: slotHeight)
+                .shadow(color: lit ? glow : .clear, radius: lit ? (flare ? 16 : 8) : 0)
+                .shadow(color: flare ? glow.opacity(0.8) : .clear, radius: flare ? 30 : 0)
+                .padding(.top, height * Self.slotCentre - slotHeight / 2)
+            // Power and reset, either side of the slot.
+            HStack {
+                switchKnob
+                Spacer()
+                switchKnob
+            }
+            .frame(width: slotWidth * 1.75)
+            .padding(.top, height * 0.12)
+            // Four controller ports along the front, and the light beside them.
+            VStack {
+                Spacer()
+                HStack(spacing: width * 0.05) {
+                    ForEach(0..<4, id: \.self) { _ in
+                        RoundedRectangle(cornerRadius: height * 0.03).fill(Color(white: 0.07))
+                            .frame(width: width * 0.09, height: height * 0.11)
+                            .overlay(RoundedRectangle(cornerRadius: height * 0.03).strokeBorder(.white.opacity(0.12), lineWidth: 1))
+                    }
+                }
+                .padding(.bottom, height * 0.12)
+            }
+            Circle().fill(lit ? Color(red: 0.95, green: 0.2, blue: 0.2) : Color(red: 0.3, green: 0.08, blue: 0.08))
+                .frame(width: height * 0.06, height: height * 0.06)
+                .shadow(color: lit ? .red : .clear, radius: 4)
+                .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .bottomLeading)
+                .padding(.leading, width * 0.08).padding(.bottom, height * 0.16)
+        }
+        .frame(width: width, height: height)
+        .shadow(color: .black.opacity(0.5), radius: 14, y: 8)
+        .animation(.easeOut(duration: 0.2), value: lit)
+        .animation(.easeOut(duration: 0.25), value: flare)
+    }
+    private var switchKnob: some View {
+        Capsule().fill(LinearGradient(colors: [Color(white: 0.55), Color(white: 0.3)], startPoint: .top, endPoint: .bottom))
+            .frame(width: height * 0.22, height: height * 0.1)
+            .overlay(Capsule().strokeBorder(.black.opacity(0.35), lineWidth: 1))
+    }
+}
