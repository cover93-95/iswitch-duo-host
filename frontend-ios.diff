+/// The figures of the Your play tab, from the sessions.
+public extension PlayStats {
+    /// The mean session: from the kept sessions, else from the totals.
+    var average: TimeInterval? {
+        if !sessions.isEmpty { return sessions.map(\.seconds).reduce(0, +) / Double(sessions.count) }
+        return launches > 0 && seconds > 0 ? seconds / Double(launches) : nil
+    }
+    var longest: TimeInterval? { sessions.map(\.seconds).max() }
+    var firstPlayed: Date? { sessions.map(\.start).min() }
+    func thisMonth(now: Date = Date(), calendar: Calendar = .current) -> TimeInterval {
+        sessions.filter { calendar.isDate($0.start, equalTo: now, toGranularity: .month) }.map(\.seconds).reduce(0, +)
+    }
+    /// The time played in each of the last `count` calendar weeks, the oldest first and this week last.
+    func weekly(_ count: Int = 8, now: Date = Date(), calendar: Calendar = .current) -> [TimeInterval] {
+        guard let thisWeek = calendar.dateInterval(of: .weekOfYear, for: now)?.start else { return Array(repeating: 0, count: count) }
+        var weeks = Array(repeating: 0.0, count: count)
+        for s in sessions {
+            guard let start = calendar.dateInterval(of: .weekOfYear, for: s.start)?.start,
+                  let back = calendar.dateComponents([.weekOfYear], from: start, to: thisWeek).weekOfYear,
+                  back >= 0, back < count else { continue }
+            weeks[count - 1 - back] += s.seconds
+        }
+        return weeks
     }
