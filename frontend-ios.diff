+import SwiftUI
+
+/// A game's info panel in Cover Flow: it slides in from the right when the centred box is chosen (A or a tap). Two tabs, in the
+/// capsule of the platform selector (L and R step through them): Overview holds the game's main figures, its one action (Play,
+/// or the way out for a game that cannot start), the open-box view and the game settings, then what the game is about: its
+/// synopsis and screenshots, each opening full screen. Your play holds the sessions' figures, the hours of the last weeks and
+/// the player's status for the game. The heart beside Close marks a favourite. Everything is a focus target for a controller
+/// and a button for touch. B, a tap beside it or Close closes it.
+struct GameInfoPanel: View {
+    let detail: GameDetail
+    let primary: () -> Void
+    let openBox: () -> Void
+    let openSettings: () -> Void
+    let openScreenshot: (Int) -> Void
+    let close: () -> Void
+    var setStatus: (PlayStatus?) -> Void = { _ in }
+    var toggleFavourite: () -> Void = {}
+    @Binding var tab: Int
+    var showsHints = false
+    @Environment(\.shellFocus) private var focus
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    private var tabs: [String] { [ShellStrings.text("Overview"), ShellStrings.text("Your play")] }
+
+    var body: some View {
+        let game = detail.game
+        ScrollViewReader { proxy in
+        ScrollView {
+            VStack(alignment: .leading, spacing: 20) {
+                HStack(spacing: 8) {
+                    PlatformSelector(platforms: tabs, current: tabs[min(tab, 1)], showsHints: showsHints,
+                                     choose: { name in tab = tabs.firstIndex(of: name) ?? 0 }, idPrefix: "info.tab.")
+                    Spacer(minLength: 8)
+                    Button(action: toggleFavourite) {
+                        Image(systemName: game.stats.favourite ? "heart.fill" : "heart").frame(minWidth: 18)
+                            .foregroundStyle(game.stats.favourite ? Color(red: 1, green: 0.36, blue: 0.45) : .white)
+                    }
+                    .buttonStyle(ChipButtonStyle())
+                    .accessibilityLabel(game.stats.favourite ? ShellStrings.text("Remove from favourites") : ShellStrings.text("Favourite"))
+                    .accessibilityAddTraits(game.stats.favourite ? .isSelected : [])
+                    .accessibilityIdentifier("info.favourite")
+                    .shellTarget("info.favourite", radius: 22, action: toggleFavourite)
+                    Button(action: close) { Image(systemName: "xmark").frame(minWidth: 18) }
+                        .buttonStyle(ChipButtonStyle())
+                        .accessibilityLabel(ShellStrings.text("Close"))
+                        .accessibilityIdentifier("info.close")
+                        .shellTarget("info.close", radius: 22, action: close)
+                }
+                .id("info.top")
+                header(game)
+                if tab == 0 { overview(game) } else { yourPlay(game) }
+            }
+            .padding(22)
+            .animation(reduceMotion ? nil : .easeOut(duration: 0.2), value: tab)
+        }
+        .scrollIndicators(.hidden)
+        .safeAreaInset(edge: .bottom) {
+            // The controller's buttons here, as at the bottom of the library: A picks, B goes back, LB and RB change tabs.
+            if showsHints {
+                HintBar {
+                    GlyphHint(role: .activate, label: ShellStrings.text("Choose"))
+                    GlyphHint(role: .back, label: ShellStrings.text("Back"))
+                    ShoulderHint(label: ShellStrings.text("Tabs"))
+                }
+                .padding(.bottom, 12)
+                .frame(maxWidth: .infinity)
+            }
+        }
+        .onChange(of: focus.id) { _, id in
+            // Keeps the focused control in view, the screenshots included, on a short screen.
+            guard let id, id.hasPrefix("info.") else { return }
+            let top = id == "info.close" || id == "info.favourite"
+            withAnimation(reduceMotion ? nil : .easeOut(duration: 0.18)) {
+                proxy.scrollTo(top ? "info.top" : (id.hasPrefix("info.shot.") ? "info.shots" : id), anchor: top ? .top : .center)
+            }
+        }
+        .onChange(of: tab) { _, _ in proxy.scrollTo("info.top", anchor: .top) }
+        .onChange(of: detail.id) { _, _ in tab = 0 }
+        }
+        .foregroundStyle(.white)
+    }
+
+    private func header(_ game: GameTile) -> some View {
+        HStack(alignment: .center, spacing: 16) {
+            ArtView(game: game, lettering: false, whole: game.webURL != nil)
+                .frame(width: game.isCart64 ? 96 : 70, height: (game.isCart64 ? 96 : 70) / CGFloat(game.boxRatio))
+                .clipShape(RoundedRectangle(cornerRadius: 5))
+                .overlay(RoundedRectangle(cornerRadius: 5).strokeBorder(.white.opacity(0.16)))
+                .shadow(color: .black.opacity(0.45), radius: 10, y: 4)
+                .accessibilityHidden(true)
+            VStack(alignment: .leading, spacing: 7) {
+                StatusLabel(state: game.state, prominent: true)
+                Text(game.title).shellType(ShellType.pageTitle).lineLimit(3).minimumScaleFactor(0.8)
+                    .fixedSize(horizontal: false, vertical: true)
+                    .accessibilityAddTraits(.isHeader).accessibilityIdentifier("info.title")
+                if !game.subtitle.isEmpty {
+                    Text(game.subtitle).shellType(ShellType.note).foregroundStyle(.white.opacity(0.5))
+                }
+            }
+        }
+    }
+
+    @ViewBuilder private func overview(_ game: GameTile) -> some View {
+        EqualRow(spacing: 8) {
+            StatTile(label: ShellStrings.text("Played"), value: ShellFormat.playTime(game.stats.seconds))
+            StatTile(label: ShellStrings.text("Last played"), value: ShellFormat.lastPlayed(game.stats.lastPlayed))
+            StatTile(label: ShellStrings.text("Launches"), value: "\(game.stats.launches)")
+        }
+        .accessibilityElement(children: .combine)
+        .accessibilityIdentifier("info.stats")
+        Button(action: primary) {
+            Label(game.state.actionTitle, systemImage: game.state.actionSymbol)
+        }
+        .buttonStyle(PrimaryPillStyle(expands: true))
+        .accessibilityIdentifier("info.play")
+        .accessibilityLabel(game.state.actionTitle + ", " + game.title)
+        .shellTarget("info.play", radius: 25, action: primary)
+        if !game.state.explanation.isEmpty {
+            Text(game.state.explanation).shellText(14).foregroundStyle(.white.opacity(0.72))
+                .fixedSize(horizontal: false, vertical: true)
+        }
+        EqualRow(spacing: 10) {
+            Button(action: openBox) { Label(ShellStrings.text("Open the box"), systemImage: "shippingbox") }
+                .buttonStyle(ShellButtonStyle(fills: true))
+                .accessibilityIdentifier("info.box")
+                .shellTarget("info.box", radius: 9, action: openBox)
+            Button(action: openSettings) { Label(ShellStrings.text("Game settings"), systemImage: "slider.horizontal.3") }
+                .buttonStyle(ShellButtonStyle(fills: true))
+                .accessibilityIdentifier("info.settings")
+                .shellTarget("info.settings", radius: 9, action: openSettings)
+        }
+        if !game.synopsis.isEmpty || !game.screens.isEmpty {
+            VStack(alignment: .leading, spacing: 12) {
+                SectionHeading(title: ShellStrings.text("About the game"))
+                if !game.synopsis.isEmpty {
+                    Text(game.synopsis).shellText(14.5).foregroundStyle(.white.opacity(0.8))
+                        .lineSpacing(2)
+                        .fixedSize(horizontal: false, vertical: true)
+                        .accessibilityIdentifier("info.synopsis")
+                }
+                if !game.screens.isEmpty {
+                    ScreenshotStrip(screens: game.screens, open: openScreenshot)
+                        .id("info.shots")
+                        .padding(.horizontal, -22)
+                        .contentMargins(.horizontal, 22, for: .scrollContent)
+                }
+            }
+            .padding(.top, 6)
+        }
+    }
+
+    @ViewBuilder private func yourPlay(_ game: GameTile) -> some View {
+        let s = game.stats
+        VStack(spacing: 8) {
+            EqualRow(spacing: 8) {
+                StatTile(label: ShellStrings.text("Played"), value: ShellFormat.playTime(s.seconds))
+                StatTile(label: ShellStrings.text("Launches"), value: "\(s.launches)")
+            }
+            EqualRow(spacing: 8) {
+                StatTile(label: ShellStrings.text("Average session"), value: s.average.map(ShellFormat.playTime) ?? "–")
+                StatTile(label: ShellStrings.text("Longest session"), value: s.longest.map(ShellFormat.playTime) ?? "–")
+            }
+            EqualRow(spacing: 8) {
+                StatTile(label: ShellStrings.text("First played"),
+                         value: s.firstPlayed.map { $0.formatted(date: .abbreviated, time: .omitted) } ?? ShellStrings.text("Not recorded"))
+                StatTile(label: ShellStrings.text("This month"), value: ShellFormat.playTime(s.thisMonth()))
+            }
+        }
+        .accessibilityElement(children: .combine)
+        .accessibilityIdentifier("info.playStats")
+        WeekBars(weeks: s.weekly())
+        VStack(alignment: .leading, spacing: 10) {
+            SectionHeading(title: ShellStrings.text("Status"))
+            EqualRow(spacing: 6) {
+                ForEach(PlayStatus.allCases, id: \.self) { status in
+                    let on = s.status == status
+                    let pick = { setStatus(on ? nil : status) }
+                    Button(action: pick) {
+                        Text(status.title).shellText(12.5, on ? .bold : .semibold, relativeTo: .footnote)
+                            .lineLimit(1).minimumScaleFactor(0.6)
+                            .frame(maxWidth: .infinity, minHeight: 40)
+                            .foregroundStyle(on ? Color.black : Color.white.opacity(0.8))
+                            .background(Capsule().fill(on ? Color.white.opacity(0.92) : Color.white.opacity(0.07)))
+                            .overlay(Capsule().strokeBorder(.white.opacity(on ? 0 : 0.12)))
+                            .contentShape(Capsule())
+                    }
+                    .buttonStyle(.plain)
+                    .accessibilityAddTraits(on ? .isSelected : [])
+                    .accessibilityIdentifier("info.status.\(status.rawValue)")
+                    .shellTarget("info.status.\(status.rawValue)", radius: 20, action: pick)
+                }
+            }
+        }
+        YourCopy(game: game, open: openBox)
+        Text(ShellStrings.text("Play time and launches are counted by this app, on this device.") + " "
+             + ShellStrings.text("Sessions are recorded from this version on."))
+            .shellType(ShellType.note).foregroundStyle(.white.opacity(0.4))
+            .fixedSize(horizontal: false, vertical: true)
+    }
+}
+
+/// The game's copy, piece by piece as in its open box: the box, its spine, the card (a disc, a cartridge) and the booklet.
+/// Each opens the box.
+private struct YourCopy: View {
+    let game: GameTile
+    let open: () -> Void
+    var body: some View {
+        let style = CaseStyle.of(game)
+        VStack(alignment: .leading, spacing: 10) {
+            SectionHeading(title: ShellStrings.text("Your copy"))
+            EqualRow(spacing: 8) {
+                piece(0, ShellStrings.text("Box")) {
+                    ArtView(game: game, lettering: false, whole: game.webURL != nil)
+                        .frame(width: min(66 * CGFloat(game.boxRatio), 80), height: min(66 * CGFloat(game.boxRatio), 80) / CGFloat(game.boxRatio))
+                        .clipShape(RoundedRectangle(cornerRadius: 3))
+                }
+                piece(1, ShellStrings.text("Spine")) {
+                    RoundedRectangle(cornerRadius: 2)
+                        .fill(LinearGradient(colors: [style.light, style.dark], startPoint: .leading, endPoint: .trailing))
+                        .frame(width: 13, height: 66)
+                        .overlay(
+                            Text(game.title.uppercased()).font(ShellFonts.fixed(6, weight: .bold)).foregroundStyle(.white)
+                                .lineLimit(1).fixedSize().rotationEffect(.degrees(90)).frame(width: 13, height: 66).clipped()
+                        )
+                }
+                piece(2, game.isDisc ? ShellStrings.text("Disc") : game.isCart64 ? ShellStrings.text("Cartridge") : ShellStrings.text("Game card")) {
+                    let w: CGFloat = game.isDisc ? 58 : game.isCart64 ? 60 : 42
+                    GameCard(game: game, width: w, height: w * CaseTray.ratio(style))
+                }
+                piece(3, ShellStrings.text("Booklet")) {
+                    VStack(spacing: 0) {
+                        ArtView(game: game, lettering: false).frame(width: 46, height: 52).clipped()
+                        Rectangle().fill(Color(white: 0.94)).frame(width: 46, height: 8)
+                    }
+                    .clipShape(RoundedRectangle(cornerRadius: 2))
+                }
+            }
+        }
+    }
+    private func piece<V: View>(_ index: Int, _ label: String, @ViewBuilder _ visual: () -> V) -> some View {
+        Button(action: open) {
+            VStack(spacing: 8) {
+                visual().frame(height: 70).shadow(color: .black.opacity(0.4), radius: 4, y: 2)
+                Text(label).shellText(12, .semibold, relativeTo: .caption).lineLimit(1).minimumScaleFactor(0.6)
+            }
+            .frame(maxWidth: .infinity).padding(.vertical, 10)
+            .background(.white.opacity(0.055), in: RoundedRectangle(cornerRadius: 11))
+            .overlay(RoundedRectangle(cornerRadius: 11).strokeBorder(.white.opacity(0.09)))
+            .contentShape(RoundedRectangle(cornerRadius: 11))
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel(label)
+        .accessibilityIdentifier("info.copy.\(index)")
+        .shellTarget("info.copy.\(index)", radius: 11, action: open)
+    }
+}
+
+/// The hours of the last weeks, a bar each, this week last and lit.
+private struct WeekBars: View {
+    let weeks: [TimeInterval]
+    var body: some View {
+        let top = max(weeks.max() ?? 0, 1)
+        VStack(alignment: .leading, spacing: 10) {
+            HStack(alignment: .firstTextBaseline) {
+                Text(ShellStrings.text("Hours by week").uppercased()).shellType(ShellType.eyebrow).foregroundStyle(ShellPalette.cream.opacity(0.6))
+                Spacer(minLength: 8)
+                Text(ShellFormat.playTime(weeks.last ?? 0)).shellText(15, .bold, relativeTo: .headline).monospacedDigit()
+            }
+            HStack(alignment: .bottom, spacing: 6) {
+                ForEach(Array(weeks.enumerated()), id: \.offset) { index, value in
+                    RoundedRectangle(cornerRadius: 3)
+                        .fill(index == weeks.count - 1 ? Color.white.opacity(0.9) : Color.white.opacity(0.32))
+                        .frame(height: max(3, 56 * value / top))
+                        .frame(maxWidth: .infinity)
+                }
+            }
+            .frame(height: 56, alignment: .bottom)
+            HStack {
+                Text(ShellStrings.text("8 weeks ago"))
+                Spacer()
+                Text(ShellStrings.text("This week"))
+            }
+            .shellType(ShellType.note).foregroundStyle(.white.opacity(0.45))
+        }
+        .padding(.horizontal, 12).padding(.vertical, 11)
+        .background(.white.opacity(0.055), in: RoundedRectangle(cornerRadius: 11))
+        .overlay(RoundedRectangle(cornerRadius: 11).strokeBorder(.white.opacity(0.09)))
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(ShellStrings.text("Hours by week"))
+        .accessibilityValue(ShellFormat.playTime(weeks.last ?? 0))
+    }
+}
+
+/// One figure of the panel: a small label in capitals over the value.
+private struct StatTile: View {
+    let label: String
+    let value: String
+    var body: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            Text(label.uppercased()).shellType(ShellType.eyebrow).foregroundStyle(ShellPalette.cream.opacity(0.6))
+                .lineLimit(1).minimumScaleFactor(0.7)
+            Text(value).shellText(17, .bold, relativeTo: .headline).monospacedDigit()
+                .lineLimit(1).minimumScaleFactor(0.6)
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .padding(.horizontal, 12).padding(.vertical, 11)
+        .background(.white.opacity(0.055), in: RoundedRectangle(cornerRadius: 11))
+        .overlay(RoundedRectangle(cornerRadius: 11).strokeBorder(.white.opacity(0.09)))
+    }
+}
diff --git a/frontend-ios/Sources/ShellUI/GameScreens.swift b/frontend-ios/Sources/ShellUI/GameScreens.swift
new file mode 100644
index 0000000..055f5bd
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/GameScreens.swift
@@ -0,0 +1,159 @@
+import SwiftUI
+
+/// Decodes a game's screenshots off the main thread, at the size they are drawn, and keeps the recent ones. The tile only lists
+/// the files (see `GameTile.screens`): nothing is decoded until the info panel shows it.
+@MainActor
+final class ScreenshotCache {
+    static let shared = ScreenshotCache()
+    private final class Box { let art: Artwork; init(_ art: Artwork) { self.art = art } }
+    private let cache: NSCache<NSString, Box> = {
+        let cache = NSCache<NSString, Box>()
+        cache.countLimit = 24
+        return cache
+    }()
+
+    func cached(_ url: URL, maxPixels: Int) -> Artwork? { cache.object(forKey: Self.key(url, maxPixels))?.art }
+
+    func load(_ url: URL, maxPixels: Int) async -> Artwork? {
+        if let art = cached(url, maxPixels: maxPixels) { return art }
+        let art = await Task.detached(priority: .userInitiated) { Artwork(id: url.path, url: url, maxPixels: maxPixels) }.value
+        if let art { cache.setObject(Box(art), forKey: Self.key(url, maxPixels)) }
+        return art
+    }
+
+    private static func key(_ url: URL, _ maxPixels: Int) -> NSString { "\(maxPixels)|\(url.path)" as NSString }
+}
+
+/// One screenshot, filling its frame (`fill`) or whole inside it, a dark plate while it decodes.
+struct ScreenshotImage: View {
+    let url: URL
+    let maxPixels: Int
+    var fill = true
+    @State private var art: Artwork?
+
+    var body: some View {
+        ZStack {
+            if let art {
+                Image(decorative: art.image, scale: 1).resizable().interpolation(.high)
+                    .aspectRatio(contentMode: fill ? .fill : .fit)
+                    .transition(.opacity)
+            } else {
+                Color.white.opacity(0.05)
+            }
+        }
+        .task(id: url) {
+            if let ready = ScreenshotCache.shared.cached(url, maxPixels: maxPixels) { art = ready; return }
+            let loaded = await ScreenshotCache.shared.load(url, maxPixels: maxPixels)
+            withAnimation(.easeOut(duration: 0.2)) { art = loaded }
+        }
+    }
+}
+
+/// The row of screenshots in the info panel: a tap, or A on the focused one, opens it full screen. It scrolls sideways to keep
+/// the focused one in view.
+struct ScreenshotStrip: View {
+    let screens: [URL]
+    let open: (Int) -> Void
+    @Environment(\.shellFocus) private var focus
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    var body: some View {
+        ScrollViewReader { proxy in
+            ScrollView(.horizontal) {
+                HStack(spacing: 10) {
+                    ForEach(Array(screens.enumerated()), id: \.offset) { index, url in
+                        let id = "info.shot.\(index)"
+                        Button { open(index) } label: {
+                            ScreenshotImage(url: url, maxPixels: 480)
+                                .frame(width: 176, height: 99)
+                                .clipShape(RoundedRectangle(cornerRadius: 8))
+                                .overlay(RoundedRectangle(cornerRadius: 8).strokeBorder(.white.opacity(0.12)))
+                                .contentShape(RoundedRectangle(cornerRadius: 8))
+                        }
+                        .buttonStyle(.plain)
+                        .accessibilityLabel(ShellStrings.text("Screenshot") + " \(index + 1)/\(screens.count)")
+                        .accessibilityIdentifier(id)
+                        .shellTarget(id, radius: 8) { open(index) }
+                        .id(id)
+                    }
+                }
+                .padding(.vertical, 4).padding(.horizontal, 2)
+            }
+            .scrollIndicators(.hidden)
+            .onChange(of: focus.id) { _, id in
+                guard let id, id.hasPrefix("info.shot.") else { return }
+                withAnimation(reduceMotion ? nil : .easeOut(duration: 0.18)) { proxy.scrollTo(id, anchor: .center) }
+            }
+        }
+    }
+}
+
+/// A screenshot full screen, over everything: swipe, the arrows or left and right on a controller go through them; B, Close or a
+/// tap on the black closes it.
+struct ScreenshotViewer: View {
+    let title: String
+    let screens: [URL]
+    @Binding var index: Int
+    let close: () -> Void
+
+    var body: some View {
+        ZStack {
+            Color.black.ignoresSafeArea()
+                .onTapGesture(perform: close)
+                .accessibilityHidden(true)
+            TabView(selection: $index) {
+                ForEach(Array(screens.enumerated()), id: \.offset) { i, url in
+                    ScreenshotImage(url: url, maxPixels: 1920, fill: false)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        .accessibilityElement()
+                        .accessibilityLabel(ShellStrings.text("Screenshot") + " \(i + 1)/\(screens.count)")
+                        .tag(i)
+                }
+            }
+            #if os(iOS)
+            .tabViewStyle(.page(indexDisplayMode: .never))
+            #endif
+            .ignoresSafeArea()
+            VStack {
+                HStack(alignment: .center) {
+                    VStack(alignment: .leading, spacing: 3) {
+                        Text(title).shellType(ShellType.cardTitle).lineLimit(1)
+                        Text(verbatim: "\(index + 1) / \(screens.count)").shellType(ShellType.note).monospacedDigit()
+                            .foregroundStyle(.white.opacity(0.6))
+                    }
+                    Spacer(minLength: 12)
+                    Button(action: close) { Label(ShellStrings.text("Close"), systemImage: "xmark") }
+                        .buttonStyle(ChipButtonStyle())
+                        .accessibilityIdentifier("shot.close")
+                        .shellTarget("shot.close", radius: 22, action: close)
+                }
+                Spacer(minLength: 0)
+                HStack(spacing: 14) {
+                    Button(action: previous) { Image(systemName: "chevron.left").frame(minWidth: 18) }
+                        .buttonStyle(ChipButtonStyle())
+                        .disabled(index == 0)
+                        .accessibilityLabel(ShellStrings.text("Previous"))
+                        .accessibilityIdentifier("shot.prev")
+                    HStack(spacing: 7) {
+                        ForEach(screens.indices, id: \.self) { i in
+                            Circle().fill(.white.opacity(i == index ? 0.95 : 0.3)).frame(width: 7, height: 7)
+                        }
+                    }
+                    .accessibilityHidden(true)
+                    Button(action: next) { Image(systemName: "chevron.right").frame(minWidth: 18) }
+                        .buttonStyle(ChipButtonStyle())
+                        .disabled(index >= screens.count - 1)
+                        .accessibilityLabel(ShellStrings.text("Next"))
+                        .accessibilityIdentifier("shot.next")
+                    GlyphHint(role: .back, label: ShellStrings.text("Back"))
+                }
+            }
+            .padding(.horizontal, 24).padding(.vertical, 12)
+            .foregroundStyle(.white)
+        }
+        .animation(.easeInOut(duration: 0.25), value: index)
+    }
+
+    private func previous() { if index > 0 { index -= 1 } }
+    private func next() { if index < screens.count - 1 { index += 1 } }
+}
diff --git a/frontend-ios/Sources/ShellUI/InsertSound.swift b/frontend-ios/Sources/ShellUI/InsertSound.swift
new file mode 100644
index 0000000..4550465
--- /dev/null
+++ b/frontend-ios/Sources/ShellUI/InsertSound.swift
@@ -0,0 +1,163 @@
+import AVFoundation
+import Foundation
+
+/// The click of a game card going into the console (a short scrape, then the latch), or a disc swallowed by a slot-loading drive.
+/// Made here as samples (no sound file), so the app carries no recording. Played in the playback session, mixed with other audio,
+/// so it is heard with the ring/silent switch on, as a console's sounds are (the player asked for it), at the device volume.
+@MainActor enum InsertSound {
+    private static var card: AVAudioPlayer?
+    private static var disc: AVAudioPlayer?
+    private static var cart64: AVAudioPlayer?
+
+    /// Ready to play at once, so the sound lands with the animation.
+    static func prepare(disc wantsDisc: Bool = false, cart64 wantsCart64: Bool = false) {
+        #if os(iOS)
+        try? AVAudioSession.sharedInstance().setCategory(.playback, mode: .default, options: [.mixWithOthers])
+        try? AVAudioSession.sharedInstance().setActive(true)
+        #endif
+        if wantsCart64 && !wantsDisc {
+            guard cart64 == nil else { return }
+            cart64 = try? AVAudioPlayer(data: wav(cart64Samples(rate: 44_100)))
+            cart64?.volume = 1.0
+            cart64?.prepareToPlay()
+        } else if wantsDisc {
+            guard disc == nil else { return }
+            // A recording the IPA carries beside the app (disc-insert.wav / .m4a / .mp3 / .caf, never in the repository) wins over
+            // the made-up one
+            let recorded = ["wav", "m4a", "mp3", "caf"].lazy.compactMap { Bundle.main.url(forResource: "disc-insert", withExtension: $0) }.first
+            disc = recorded.flatMap { try? AVAudioPlayer(contentsOf: $0) } ?? (try? AVAudioPlayer(data: wav(discSamples(rate: 44_100))))
+            disc?.volume = 1.0
+            disc?.prepareToPlay()
+        } else {
+            guard card == nil else { return }
+            card = try? AVAudioPlayer(data: wav(samples(rate: 44_100)))
+            card?.volume = 0.9
+            card?.prepareToPlay()
+        }
+    }
+
+    static func play(disc wantsDisc: Bool = false, cart64 wantsCart64: Bool = false) {
+        prepare(disc: wantsDisc, cart64: wantsCart64)
+        let player = wantsDisc ? disc : wantsCart64 ? cart64 : card
+        player?.currentTime = 0
+        player?.volume = wantsDisc || wantsCart64 ? 1.0 : 0.9
+        player?.play()
+        // The disc's recording ends on a hard knock: it fades out over its last half second instead
+        if wantsDisc, let player, player.duration > 0.8 {
+            let at = player.duration - 0.55
+            Task { @MainActor in
+                try? await Task.sleep(for: .seconds(at))
+                if player.isPlaying { player.setVolume(0, fadeDuration: 0.4) }
+            }
+        }
+    }
+
+    /// A disc into a slot-loading drive, about 1.2 s at `rate`: the disc's edge brushing the felt of the slot, the rollers taking it
+    /// in with the motor's rising hum, the soft thunk of the disc on the spindle, then the spin-up whine fading out.
+    static func discSamples(rate: Int) -> [Float] {
+        let count = Int(Double(rate) * 1.25)
+        var out = [Float](repeating: 0, count: count)
+        var seed: UInt32 = 0x2545_F491
+        func noise() -> Float {
+            seed = seed &* 1_664_525 &+ 1_013_904_223
+            return Float(Int32(bitPattern: seed)) / Float(Int32.max)
+        }
+        var low: Float = 0, phaseMotor = 0.0, phaseWhine = 0.0
+        for i in 0..<count {
+            let t = Double(i) / Double(rate)
+            var v: Float = 0
+            // felt brush as the edge goes in (0-0.18 s), low-passed noise
+            low += (noise() - low) * 0.08
+            if t < 0.18 { v += low * Float(min(1, t / 0.04)) * Float(1 - t / 0.18) * 0.55 }
+            // rollers and motor pulling the disc in (0.12-0.72 s): a hum gliding 95 -> 150 Hz with roller rumble
+            if t >= 0.12 && t < 0.72 {
+                let u = (t - 0.12) / 0.6
+                phaseMotor += 2 * .pi * (95 + 55 * u) / Double(rate)
+                let env = Float(min(1, u * 6) * min(1, (1 - u) * 5))
+                v += env * (0.32 * Float(sin(phaseMotor)) + 0.12 * Float(sin(phaseMotor * 2)) + 0.18 * low)
+            }
+            // the disc seated on the spindle (0.72 s): a soft low thunk and a small click
+            if t >= 0.72 {
+                let u = t - 0.72
+                v += Float(exp(-u / 0.03)) * 0.55 * Float(sin(2 * .pi * 70 * u))
+                v += Float(exp(-u / 0.002)) * 0.25 * noise()
+            }
+            // spin-up (0.78-1.25 s): a whine rising 260 -> 900 Hz, quiet, fading out
+            if t >= 0.78 {
+                let u = (t - 0.78) / 0.47
+                phaseWhine += 2 * .pi * (260 + 640 * u * u) / Double(rate)
+                let env = Float(min(1, u * 4) * (1 - u))
+                v += env * (0.10 * Float(sin(phaseWhine)) + 0.05 * Float(sin(phaseWhine * 1.5)) + 0.04 * low)
+            }
+            out[i] = max(-1, min(1, v))
+        }
+        return out
+    }
+
+    /// An N64 cartridge pushed into the console, about 0.3 s at `rate`: the plastic sliding down the guides, the edge connector
+    /// gripping it, then a dull low thunk as it seats; lower and softer than a Switch card's click.
+    static func cart64Samples(rate: Int) -> [Float] {
+        let count = Int(Double(rate) * 0.32)
+        var out = [Float](repeating: 0, count: count)
+        var seed: UInt32 = 0x6A09_E667
+        func noise() -> Float {
+            seed = seed &* 1_664_525 &+ 1_013_904_223
+            return Float(Int32(bitPattern: seed)) / Float(Int32.max)
+        }
+        var low: Float = 0, lower: Float = 0
+        for i in 0..<count {
+            let t = Double(i) / Double(rate)
+            var v: Float = 0
+            low += (noise() - low) * 0.12
+            lower += (low - lower) * 0.2
+            if t < 0.14 { v += lower * Float(min(1, t / 0.03)) * Float(1 - t / 0.14 * 0.4) * 1.6 }    // sliding down the guides
+            if t >= 0.12 && t < 0.18 { v += low * Float(sin(.pi * (t - 0.12) / 0.06)) * 0.5 }        // the connector's grip
+            if t >= 0.175 {                                                                          // seated: a dull thunk
+                let u = t - 0.175
+                v += Float(exp(-u / 0.035)) * (0.7 * Float(sin(2 * .pi * 120 * u)) + 0.25 * Float(sin(2 * .pi * 240 * u)))
+                v += Float(exp(-u / 0.004)) * 0.3 * Float(sin(2 * .pi * 800 * u))
+            }
+            out[i] = max(-1, min(1, v))
+        }
+        return out
+    }
+
+    /// The sound, -1...1 at `rate`: 50 ms of soft scrape rising, a sharp click, and a duller latch 20 ms later.
+    static func samples(rate: Int) -> [Float] {
+        let count = Int(Double(rate) * 0.16)
+        var out = [Float](repeating: 0, count: count)
+        var seed: UInt32 = 0x9E37_79B9
+        func noise() -> Float {
+            seed = seed &* 1_664_525 &+ 1_013_904_223
+            return Float(Int32(bitPattern: seed)) / Float(Int32.max)
+        }
+        for i in 0..<count {
+            let t = Double(i) / Double(rate)
+            var v: Float = 0
+            if t < 0.05 { v += noise() * Float(0.04 + t * 1.2) * 0.5 }                    // the scrape, rising
+            if t >= 0.052 {                                                                // the click
+                let u = t - 0.052
+                v += Float(exp(-u / 0.0016)) * (0.75 * Float(sin(2 * .pi * 3_100 * u)) + 0.35 * noise())
+            }
+            if t >= 0.074 {                                                                // the latch
+                let u = t - 0.074
+                v += Float(exp(-u / 0.004)) * 0.45 * Float(sin(2 * .pi * 1_500 * u))
+            }
+            out[i] = max(-1, min(1, v))
+        }
+        return out
+    }
+
+    /// 16-bit mono PCM in a WAV container.
+    static func wav(_ samples: [Float], rate: Int = 44_100) -> Data {
+        var data = Data()
+        func put32(_ v: UInt32) { withUnsafeBytes(of: v.littleEndian) { data.append(contentsOf: $0) } }
+        func put16(_ v: UInt16) { withUnsafeBytes(of: v.littleEndian) { data.append(contentsOf: $0) } }
+        let bytes = UInt32(samples.count * 2)
+        data.append(contentsOf: Array("RIFF".utf8)); put32(36 + bytes); data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8)); put32(16); put16(1); put16(1); put32(UInt32(rate)); put32(UInt32(rate * 2)); put16(2); put16(16)
+        data.append(contentsOf: Array("data".utf8)); put32(bytes)
+        for s in samples { put16(UInt16(bitPattern: Int16(s * Float(Int16.max)))) }
+        return data
+    }
+}
