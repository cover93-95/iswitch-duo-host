diff --git a/frontend-ios/Sources/ShellHost/PlayStatsStore.swift b/frontend-ios/Sources/ShellHost/PlayStatsStore.swift
new file mode 100644
index 0000000..4ac066c
--- /dev/null
+++ b/frontend-ios/Sources/ShellHost/PlayStatsStore.swift
@@ -0,0 +1,58 @@
+import Foundation
+import ShellUI
+
+/// A game's launches and time played, in the game's own defaults suite next to the last-played date, under keys of their own,
+/// so Reset to tested defaults keeps them.
+///
+/// The shell does not see a game end: the app becomes the game and is closed from the app switcher. So a session is kept open
+/// from Play, the shell marks it alive every half minute while the game runs (the main run loop keeps turning under the game),
+/// and the next time the library loads, the session is closed at the last sign of life: that mark, or the engine log's last
+/// write, whichever is later. A session longer than `longest` is not believed and counts as `longest`.
+public struct PlayStatsStore {
+    public static let launchesKey = "shell.launches"
+    public static let secondsKey = "shell.playSeconds"
+    public static let startKey = "shell.sessionStart"
+    public static let aliveKey = "shell.sessionAlive"
+    public static let longest: TimeInterval = 12 * 3600
+    private let defaults: UserDefaults
+    public init(defaults: UserDefaults) { self.defaults = defaults }
+
+    public var launches: Int { defaults.integer(forKey: Self.launchesKey) }
+    /// The closed sessions together.
+    public var seconds: TimeInterval { defaults.double(forKey: Self.secondsKey) }
+    /// When the session not closed yet began.
+    public var openSession: Date? { defaults.object(forKey: Self.startKey) as? Date }
+
+    /// Play: one more launch and a new session. A session still open is closed first, at its own last mark.
+    public func begin(_ now: Date) {
+        settle(lastSign: nil)
+        defaults.set(launches + 1, forKey: Self.launchesKey)
+        defaults.set(now, forKey: Self.startKey)
+        defaults.set(now, forKey: Self.aliveKey)
+    }
+
+    /// The game is still running.
+    public func alive(_ now: Date) {
+        guard openSession != nil else { return }
+        defaults.set(now, forKey: Self.aliveKey)
+    }
+
+    /// The game did not start after all: the launch and its session are taken back.
+    public func cancel() {
+        guard openSession != nil else { return }
+        defaults.set(max(0, launches - 1), forKey: Self.launchesKey)
+        defaults.removeObject(forKey: Self.startKey)
+        defaults.removeObject(forKey: Self.aliveKey)
+    }
+
+    /// Closes the open session at its last sign of life: the alive mark or `lastSign` (the engine log's last write), the later
+    /// one. A sign before the session began is not this session's and is ignored.
+    public func settle(lastSign: Date?) {
+        guard let start = openSession else { return }
+        let marks = [defaults.object(forKey: Self.aliveKey) as? Date, lastSign].compactMap { $0 }.filter { $0 >= start }
+        let length = min(Self.longest, max(0, (marks.max() ?? start).timeIntervalSince(start)))
+        defaults.set(seconds + length, forKey: Self.secondsKey)
+        defaults.removeObject(forKey: Self.startKey)
+        defaults.removeObject(forKey: Self.aliveKey)
+    }
+}
