diff --git a/dm/gfx/tests/t_addr_known.m b/dm/gfx/tests/t_addr_known.m
new file mode 100644
index 00000000..15994d41
--- /dev/null
+++ b/dm/gfx/tests/t_addr_known.m
@@ -0,0 +1,46 @@
+// mtl_addr_known answers whether a range lies in one memory pool as mtl_addr finds it, with no side effect: hle_nvn.c keys_hash asks it whether a shader's code is mapped, and
+// through mtl_addr every pool holding shader code went into the residency set though the GPU never reads it (docs/reference/memory.md). A large pool (BIG_MIN or more)
+// is answered from its range: its lookup would make a chunk buffer over the range
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+static int pool_resident(uint64_t a) { pthread_mutex_lock(&g_mu); int i = pool_find(a, 1), r = i >= 0 && g_pools[i].res; pthread_mutex_unlock(&g_mu); return r; }
+int main(void) { @autoreleasepool {
+    mtl_init();
+    const size_t n = 4u << 20;
+    uint8_t *mem = mmap(NULL, n, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0); if (mem == MAP_FAILED) abort();
+    uint64_t base = (uint64_t)(uintptr_t)mem;
+    mtl_pool_add(mem, n);
+    int res0 = g_pool_res_n;
+    CHECK("a range inside the pool is known", mtl_addr_known(base + 4096, 2048));
+    CHECK("the pool's last bytes are known", mtl_addr_known(base + n - 16, 16));
+    CHECK("a range past the pool's end is not", !mtl_addr_known(base + n - 16, 32));
+    CHECK("an address outside every pool is not", !mtl_addr_known(base + n + 4096, 16));
+    CHECK("asking makes no pool resident", g_pool_res_n == res0 && !pool_resident(base));
+    void *mb = NULL; uint64_t mo = 0;
+    CHECK("mtl_addr finds the same range", mtl_addr(base + 4096, 2048, &mb, &mo) && mo == 4096);
+    CHECK("mtl_addr makes the pool resident (what keys_hash did)", g_pool_res_n == res0 + 1 && pool_resident(base));
+    mtl_pool_del(mem);
+    CHECK("a removed pool holds nothing", !mtl_addr_known(base + 4096, 2048));
+
+    // A large pool: anonymous pages, untouched, so its size costs nothing
+    const size_t nb = (size_t)BIG_MIN + (32u << 20);
+    uint8_t *big = mmap(NULL, nb, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0); if (big == MAP_FAILED) abort();
+    uint64_t bb = (uint64_t)(uintptr_t)big;
+    mtl_pool_add(big, nb);
+    int np0 = g_npool, rb0 = g_pool_res_n;
+    CHECK("the large pool is in chunks", big_of(bb) >= 0);
+    CHECK("a range in the large pool is known", mtl_addr_known(bb + (100u << 20), 4096));
+    CHECK("the large pool's last bytes are known", mtl_addr_known(bb + nb - 16, 16));
+    CHECK("a range past the large pool's end is not", !mtl_addr_known(bb + nb - 16, 32));
+    CHECK("asking makes no chunk and nothing resident", g_npool == np0 && g_pool_res_n == rb0);
+    CHECK("mtl_addr makes a chunk for the same range", mtl_addr(bb + (100u << 20), 4096, &mb, &mo) && g_npool == np0 + 1);
+    mtl_pool_del(big);
+    printf("t_addr_known: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_alias_takeover.m b/dm/gfx/tests/t_alias_takeover.m
new file mode 100644
index 00000000..5204c458
--- /dev/null
+++ b/dm/gfx/tests/t_alias_takeover.m
@@ -0,0 +1,75 @@
+// alias_take_over (nvn_mtl.m): when a new shared texture takes over storage, an entry a live texture object still resolves to stays, and one nothing resolves to any more goes once
+// no lookup has found it for ALIAS_IDLE submissions. Whether a live object resolves to it is one lookup in g_by_serial_held, which every writer of g_by_serial keeps (serial_put,
+// serial_del, tex_put and the upgrade's in-place replacement): two serials naming one object count twice and the object stays held until both go. Last, a takeover past 1,000
+// held entries with 20,000 serials in the table, which walked the serial table for each entry before (it prints the time).
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+
+static tex_t tex(uint64_t serial, NVNformat format, int w) {
+    tex_t t = {.magic = MAGIC('T','E','X',0), .serial = serial};
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = format, .width = w, .height = w, .depth = 1, .levels = 1, .samples = 1};
+    nvn_tex_layout(&t.d, &t.L);
+    return t;
+}
+static int shared(id<MTLTexture> t) { pthread_mutex_lock(&g_smu); int r = alias_has(t); pthread_mutex_unlock(&g_smu); return r; }
+static int held(id o) { pthread_mutex_lock(&g_smu); int r = serial_table_holds((__bridge void *)o); pthread_mutex_unlock(&g_smu); return r; }
+static void next_submission(void) { CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "submission completes"); mtl_sub_begin(); }
+
+int main(void) { @autoreleasepool {
+    mtl_init(); mtl_sub_begin();
+    tex_t a = tex(91001, NVN_FORMAT_RGBA8, 64), b = tex(91002, NVN_FORMAT_R32F, 64), c = tex(91003, NVN_FORMAT_RG16F, 64);
+    mtl_tex_init(&a); mtl_tex_init(&b); mtl_tex_init(&c);
+    id<MTLTexture> ta = tex_mtl(&a);
+    CHECK(ta && shared(ta) && held(ta), "a live object's shared texture is counted as held");
+    id<MTLTexture> tb = tex_mtl(&b);
+    CHECK(tb && tb != ta && shared(ta) && shared(tb), "another description over the storage leaves the texture a live object resolves to");
+    mtl_tex_release(&a);
+    CHECK(!held(ta) && shared(ta), "the finalized object's texture is no longer held, and stays shared until its storage is taken");
+    for (int i = 0; i <= ALIAS_IDLE; i++) next_submission();
+    id<MTLTexture> tc = tex_mtl(&c);
+    CHECK(tc && !shared(ta), "a texture nothing resolves to goes when another description takes its storage");
+    CHECK(shared(tb) && shared(tc), "the live objects' textures stay");
+
+    // Two serials naming one object: held until both go
+    id o = [NSObject new]; uint64_t s1 = (1ull << 62) + 1, s2 = s1 + 1;
+    tex_put(s1, o); tex_put(s2, o);
+    serial_del(s1);
+    CHECK(held(o), "an object two serials name stays held when one of them goes");
+    serial_del(s2);
+    CHECK(!held(o), "and is not held once both have gone");
+    tex_put(s1, o); serial_put(s1, tb);
+    CHECK(!held(o) && held(tb), "replacing a serial's object moves the count");
+    serial_del(s1);
+
+    {   // The cost: 1,000 held entries over the storage of a 1024 x 1024 texture, 20,000 serials in the table
+        enum { NS = 20000, NA = 1000 };
+        NSMutableArray *keep = [NSMutableArray array];
+        pthread_mutex_lock(&g_smu);
+        for (int i = 0; i < NA; i++) {
+            id e = [NSObject new]; [keep addObject:e];
+            alias_key k; memset(&k, 0, sizeof k); k.off = (int64_t)i * 4096; k.d = tex(0, NVN_FORMAT_RGBA8, 32).d;
+            hm_put_id(&g_alias, &k, e);
+        }
+        pthread_mutex_unlock(&g_smu);
+        for (int i = 0; i < NS; i++) tex_put((1ull << 62) + 100 + i, i < NA ? keep[i] : [NSObject new]);
+        tex_t big = tex(91010, NVN_FORMAT_RGBA8, 1024); alias_key nk; memset(&nk, 0, sizeof nk); nk.d = big.d;
+        pthread_mutex_lock(&g_smu);
+        uint32_t before = g_alias.n; uint64_t t0 = bp_now();
+        alias_take_over(&nk);
+        double ms = (bp_now() - t0) / 1e6; uint32_t after = g_alias.n;
+        pthread_mutex_unlock(&g_smu);
+        printf("a takeover past %d held entries with %u serials in the table: %.3f ms\n", NA, g_by_serial.n, ms);
+        CHECK(after == before, "held entries are kept");
+        CHECK(ms < 1, "the takeover asks each entry in one lookup (under 1 ms; walking the serial table for each took 4.3 ms on an M5 Max)");
+        for (int i = 0; i < NS; i++) serial_del((1ull << 62) + 100 + i);
+    }
+    mtl_tex_release(&b); mtl_tex_release(&c);
+    next_submission(); defer_drain();
+    printf("t_alias_takeover: %d checks, %d failed\n", checks, failed); return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_bc_alias.m b/dm/gfx/tests/t_bc_alias.m
new file mode 100644
index 00000000..3c5bc0fc
--- /dev/null
+++ b/dm/gfx/tests/t_bc_alias.m
@@ -0,0 +1,84 @@
+// bc_alias_copy (nvn_mtl.m): a texture copy into an uncompressed texture that aliases a block-compressed one (the same guest storage, one 16-byte texel per BC3 block, its size in
+// blocks) lands in the compressed texture's blocks, as the shared storage does on the console; a copy into a texture over other storage leaves the compressed one alone.
+// Unreal's runtime virtual texture compresses its tiles to RGBA32UI blocks and copies them into such an alias of its BC3 tile cache (Monster Jam Steel Titans 2's black arena floor)
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+enum { BLOCKS = 8, W = BLOCKS * 4, BLOCK = 16 };   // a 32x32 BC3 texture: 8x8 blocks of 16 bytes, aliased by an 8x8 RGBA32UI texture
+
+static id<MTLBuffer> buffer(NSUInteger n) {   // a shared buffer of n bytes; the test stops when Metal makes none
+    id<MTLBuffer> b = [g_dev newBufferWithLength:n options:MTLResourceStorageModeShared];
+    if (!b) { fprintf(stderr, "FAIL: no %lu-byte buffer\n", (unsigned long)n); exit(1); }
+    return b;
+}
+static tex_t tex2d(NVNformat format, int w, void *mem) {
+    tex_t t = {.magic = MAGIC('T','E','X',0), .serial = nvn_new_serial(), .mem = mem};
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = format, .width = w, .height = w, .depth = 1, .levels = 1, .samples = 1};
+    nvn_tex_layout(&t.d, &t.L);
+    return t;
+}
+static void run(void (^encode)(id<MTLBlitCommandEncoder> b)) {
+    id<MTLCommandBuffer> cb = [g_q commandBuffer]; id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+    encode(b); [b endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    CHECK(cb.status == MTLCommandBufferStatusCompleted && !cb.error, "blit completes");
+}
+static void fill(id<MTLTexture> t, uint8_t seed) {   // every byte of the 8x8 RGBA32UI texture its own value
+    id<MTLBuffer> src = buffer(BLOCKS * BLOCKS * BLOCK);
+    for (NSUInteger i = 0; i < src.length; i++) ((uint8_t *)src.contents)[i] = (uint8_t)(seed + i * 7);
+    run(^(id<MTLBlitCommandEncoder> b) { [b copyFromBuffer:src sourceOffset:0 sourceBytesPerRow:BLOCKS * BLOCK sourceBytesPerImage:BLOCKS * BLOCKS * BLOCK
+                                               sourceSize:MTLSizeMake(BLOCKS, BLOCKS, 1) toTexture:t destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0, 0, 0)]; });
+}
+static id<MTLBuffer> blocks_of(id<MTLTexture> bc) {   // the compressed texture's blocks, row by row
+    id<MTLBuffer> out = buffer(BLOCKS * BLOCKS * BLOCK);
+    run(^(id<MTLBlitCommandEncoder> b) { [b copyFromTexture:bc sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(W, W, 1)
+                                                  toBuffer:out destinationOffset:0 destinationBytesPerRow:BLOCKS * BLOCK destinationBytesPerImage:BLOCKS * BLOCKS * BLOCK]; });
+    return out;
+}
+static void copy(const tex_t *src, const tex_t *dst) {
+    p_copy_t2t c = {.src = src, .dst = dst, .sr = {0, 0, 0, BLOCKS, BLOCKS, 1}, .dr = {0, 0, 0, BLOCKS, BLOCKS, 1}};
+    mtl_sub_begin(); copy_t2t(&c);
+    CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "the copy's submission completes");
+}
+
+int main(void) { @autoreleasepool {
+    mtl_init();
+    static uint8_t storage[W * W], other[BLOCKS * BLOCKS * BLOCK];   // the compressed texture's guest storage (BC3: one byte per texel), and storage nothing else shares
+    tex_t bc = tex2d(NVN_FORMAT_RGBA_DXT5, W, storage), alias = tex2d(NVN_FORMAT_RGBA32UI, BLOCKS, storage);
+    tex_t src = tex2d(NVN_FORMAT_RGBA32UI, BLOCKS, NULL), apart = tex2d(NVN_FORMAT_RGBA32UI, BLOCKS, other);
+    mtl_tex_init(&bc); mtl_tex_init(&alias); mtl_tex_init(&src); mtl_tex_init(&apart);
+    mtl_reg_tex(1, &bc, NULL); mtl_reg_tex(2, &alias, NULL);
+    id<MTLTexture> mbc = tex_mtl(&bc), msrc = tex_mtl(&src);
+    while (mbc.parentTexture) mbc = mbc.parentTexture;
+    CHECK(mbc && bc_block_bytes(mbc.pixelFormat) == BLOCK, "the compressed texture is BC3 in Metal");
+    CHECK(msrc && msrc.pixelFormat == MTLPixelFormatRGBA32Uint, "the source is RGBA32UI");
+
+    fill(msrc, 3);
+    copy(&src, &alias);
+    id<MTLBuffer> got = blocks_of(mbc), want = buffer(BLOCKS * BLOCKS * BLOCK);
+    run(^(id<MTLBlitCommandEncoder> b) { [b copyFromTexture:msrc sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(BLOCKS, BLOCKS, 1)
+                                                  toBuffer:want destinationOffset:0 destinationBytesPerRow:BLOCKS * BLOCK destinationBytesPerImage:BLOCKS * BLOCKS * BLOCK]; });
+    CHECK(!memcmp(got.contents, want.contents, got.length), "the copy into the alias lands in the compressed texture's blocks");
+    CHECK(g_bc_alias_n == 1, "and is counted as an alias copy");
+    CHECK(!tex_get(alias.serial), "the alias gets no Metal texture of its own");
+
+    fill(msrc, 101);
+    copy(&src, &apart);
+    id<MTLBuffer> again = blocks_of(mbc);
+    CHECK(!memcmp(again.contents, got.contents, got.length), "a copy into a texture over other storage leaves the compressed texture as it was");
+    CHECK(g_bc_alias_n == 1, "and is not an alias copy");
+
+    copy(&src, &alias);   // a second alias copy reuses the staging buffer
+    id<MTLBuffer> third = blocks_of(mbc), want2 = buffer(BLOCKS * BLOCKS * BLOCK);
+    run(^(id<MTLBlitCommandEncoder> b) { [b copyFromTexture:msrc sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(BLOCKS, BLOCKS, 1)
+                                                  toBuffer:want2 destinationOffset:0 destinationBytesPerRow:BLOCKS * BLOCK destinationBytesPerImage:BLOCKS * BLOCKS * BLOCK]; });
+    CHECK(!memcmp(third.contents, want2.contents, third.length), "a second copy into the alias lands too");
+    CHECK(g_bc_alias_n == 2, "and is counted");
+
+    printf("t_bc_alias: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_capture.c b/dm/gfx/tests/t_capture.c
