+    LOG("[mem] guest memory: memory pool %.2f GB, room to the memory limit %.2f GB, DM_GUEST_FILE %s: %s", DM_GAME_APP_POOL / G, room / G, e && *e ? e : "unset", want ? "in files" : "anonymous");
+#else
+    int want = guest_file_wanted(e, DM_GAME_APP_POOL, 0);
+#endif
+    if (!want) return;
