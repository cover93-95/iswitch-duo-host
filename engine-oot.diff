+def pfs0(path, names):   # a PFS0 holding empty files with these names
     strs = b''.join(n.encode() + b'\0' for n in names); ent, o = b'', 0
     for n in names: ent += struct.pack('<QQII', 0, 0, o, 0); o += len(n) + 1
