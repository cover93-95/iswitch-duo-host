+static inline int pad_pro_cal_sane(const int c[6]) {
+    for (int a = 0; a < 2; a++) {
+        if (abs(c[a] - PAD_PRO_MIDDLE) > PAD_PRO_REST_MAX) return 0;
+        for (int k = 1; k < 3; k++) if (c[2 * k + a] < 400 || c[2 * k + a] > PAD_PRO_MIDDLE) return 0;
+    }
