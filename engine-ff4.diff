+    uint2 mp = min(uint2(float2(g) / sc), uint2(mot.get_width() - 1, mot.get_height() - 1));
+    float2 v = float2(mot.read(mp).xy) * sc;   // in the picture's pixels
+    out.write(cur.sample(ls, (float2(g) + 0.5f - 0.5f * v) / size), g);
+}
