diff --git a/dm/gfx/tests/t_pso_unwrap.m b/dm/gfx/tests/t_pso_unwrap.m
new file mode 100644
index 0000000..1ba0491
--- /dev/null
+++ b/dm/gfx/tests/t_pso_unwrap.m
@@ -0,0 +1,39 @@
+// The pipeline archive an app carries as <gpu>.mtl4x (build_ipa.sh; LiveContainer's signer failed on the real Mach-O) comes back as Documents/pso_bundle/<gpu>.mtl4a: a clone
+// with the Mach-O magic restored, reused while the bundled file is the same, made again when it changes; a file without the DMPA mark is refused (nvn_mtl.m pso_bundle_unwrap)
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+static NSData *bytes(NSString *p) { return [NSData dataWithContentsOfFile:p]; }
+int main(void) { @autoreleasepool {
+    NSString *root = [NSTemporaryDirectory() stringByAppendingPathComponent:[NSString stringWithFormat:@"t_pso_unwrap.%d", getpid()]];
+    NSString *app = [root stringByAppendingPathComponent:@"app/pso"], *docs = [root stringByAppendingPathComponent:@"docs"];
+    [NSFileManager.defaultManager createDirectoryAtPath:app withIntermediateDirectories:YES attributes:nil error:nil];
+    [NSFileManager.defaultManager createDirectoryAtPath:docs withIntermediateDirectories:YES attributes:nil error:nil];
+    setenv("DM_PSO_USER", [docs stringByAppendingPathComponent:@"pso_user.tsv"].fileSystemRepresentation, 1);
+    NSMutableData *body = [NSMutableData dataWithLength:3 << 20]; arc4random_buf(body.mutableBytes, body.length);
+    NSMutableData *marked = [NSMutableData dataWithBytes:"DMPA" length:4]; [marked appendData:body];
+    NSString *src = [app stringByAppendingPathComponent:@"applegpu_test.mtl4x"]; [marked writeToFile:src atomically:NO];
+    CHECK(!pso_bundle_unwrap(app, @"applegpu_none"), "no bundled file for this GPU: nil");
+    NSString *dst = pso_bundle_unwrap(app, @"applegpu_test");
+    CHECK(dst && [dst hasSuffix:@"pso_bundle/applegpu_test.mtl4a"], "the archive comes back in Documents/pso_bundle");
+    NSData *d = bytes(dst); const uint8_t magic[4] = {0xcf, 0xfa, 0xed, 0xfe};
+    CHECK(d.length == marked.length && !memcmp(d.bytes, magic, 4), "its Mach-O magic is restored");
+    CHECK(d.length == marked.length && !memcmp((const uint8_t *)d.bytes + 4, body.bytes, body.length), "the rest is the bundled file's bytes");
+    CHECK([bytes(src) isEqualToData:marked], "the bundled file is left as it was");
+    struct stat a, b; stat(dst.fileSystemRepresentation, &a); usleep(20000);
+    NSString *again = pso_bundle_unwrap(app, @"applegpu_test"); stat(again.fileSystemRepresentation, &b);
+    CHECK([again isEqualToString:dst] && a.st_ino == b.st_ino, "a second start reuses the clone");
+    [marked replaceBytesInRange:NSMakeRange(8, 4) withBytes:"NEW!"]; usleep(20000); [marked writeToFile:src atomically:YES];
+    NSString *third = pso_bundle_unwrap(app, @"applegpu_test"); NSData *t = bytes(third);
+    CHECK(t.length == marked.length && !memcmp((const uint8_t *)t.bytes + 8, "NEW!", 4) && !memcmp(t.bytes, magic, 4), "a changed bundled file is cloned again");
+    NSString *plain = [app stringByAppendingPathComponent:@"applegpu_plain.mtl4x"]; [body writeToFile:plain atomically:NO];
+    CHECK(!pso_bundle_unwrap(app, @"applegpu_plain"), "a file without the DMPA mark is refused");
+    CHECK(![NSFileManager.defaultManager fileExistsAtPath:[docs stringByAppendingPathComponent:@"pso_bundle/applegpu_plain.mtl4a"]], "and leaves no archive behind");
+    [NSFileManager.defaultManager removeItemAtPath:root error:nil];
+    printf("t_pso_unwrap: %d checks, %d failed\n", checks, failed); return failed != 0;
+} }
diff --git a/dm/gfx/tools/pso_capture.py b/dm/gfx/tools/pso_capture.py
new file mode 100644
index 0000000..0905cf8
--- /dev/null
+++ b/dm/gfx/tools/pso_capture.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+# The bases with a vertex layout that a game's prewarm lists need, as rows pso_offline.py compiles into the offline pipeline archive (--layouts; the profile's pso_layouts.tsv).
+# The archive made from the pair lists holds each pair's base with no vertex layout (the pulling stand-in's, pso_offline.py plan); a render pipeline of the prewarm lists (an R row of
+# pso_manifest.tsv or pso_user.tsv) is built on a base with the draw's vertex layout, which the device compiles itself at its first start: the prepare step waits for every line
+# before the game's first frame, so an iPhone's first start after a list grew by 1,728 render pipelines (Ocarina of Time, 2026-11-12) compiled them all before the title screen
+# (more than 3.5 minutes on an M-series Mac, which had not finished them).
+# Made from a Mac run of the host with DM_PSO_CAPTURE=<folder> (nvn_mtl.m pso_capture_dir) and DM_PSO_ARCHIVE at an empty folder: every base the prepare step compiles is captured as a
+# Metal 4 pipelines script, the descriptor exactly as the host makes it. The script names each library loaded from memory by the SHA-256 of its file, which is mapped back to the
+# library's name through the Mac libraries (b-<chain>.img or the folder); the iPhone's libraries have the same names and entry points, so pso_offline.py compiles the same descriptor
+# for an iPhone's GPU. Kept: render pipeline descriptors with a vertex layout, every colour attachment unspecialized (a base), both functions named, and constants only as the
+# host's prebuild sets them (pso_offline.py HOST_CONSTANTS); the rest is counted and left to the device.
+# Usage: pso_capture.py --capture <folder of *.mtl4-json> --msl <Mac b-<chain> (.img or folder)> --out <pso_layouts.tsv>
+# Row: vertex library <TAB> vertex entry <TAB> pixel library <TAB> pixel entry <TAB> the descriptor's other members as compact JSON (vertex_descriptor, input_primitive_topology, ...)
+import argparse, collections, hashlib, json, os, sys
+from pathlib import Path
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import romfs, shader_lib
+import pso_offline
+
+HEADER = '# pipeline bases with a vertex layout for the offline archive (dm/gfx/tools/pso_capture.py from a DM_PSO_CAPTURE run; pso_offline.py --layouts): vertex library, entry, pixel library, entry, the descriptor\'s other members\n'
+SKIP = {'vertex_function_descriptor', 'fragment_function_descriptor', 'color_attachments', 'label', 'enable'}   # the functions are named by row columns; a base's colour attachments are all unspecialized
+
+
+def library_names(lib_dir, wanted):
+    """{SHA-256 (upper-case hex): library name} for the libraries of lib_dir whose hash is in wanted"""
+    out, want = {}, {w.upper() for w in wanted}
+    for p in sorted(romfs.Path(lib_dir).glob('*.metallib')):
+        if len(out) == len(want): break
+        h = hashlib.sha256()
+        with p.open('rb') as f:
+            while chunk := f.read(1 << 20): h.update(chunk)
+        d = h.hexdigest().upper()
+        if d in want: out[d] = p.name[:-len('.metallib')]
+    return out
+
+
+def host_constants(values):
+    """Whether constant_values set exactly what the host's prebuild sets (HOST_CONSTANTS, by index)"""
